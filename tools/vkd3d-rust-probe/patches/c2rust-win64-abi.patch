+pub(super) fn report_children(context: &TypedAstContext, node: SomeId) -> (Vec<SomeId>, Vec<SomeId>) {
+    match node {
+        SomeId::Expr(id) => {
+            let kind = &context.c_exprs.get(&id).expect("missing report expression").kind;
+            (immediate_expr_children(kind), immediate_expr_children_all_types(kind))
+        }
+        SomeId::Stmt(id) => {
+            let children = immediate_stmt_children(&context.c_stmts.get(&id).expect("missing report statement").kind);
+            (children.clone(), children)
+        }
+        SomeId::Decl(id) => {
+            let children = immediate_decl_children(&context.c_decls.get(&id).expect("missing report declaration").kind);
+            (children.clone(), children)
+        }
+        SomeId::Type(id) => {
+            let children = immediate_type_children(&context.c_types.get(&id).expect("missing report type").kind);
+            (children.clone(), children)
         }
     }
 }
