+#[test]
+fn closed_variadic_plan_record_physical_identity_and_layout_mismatch() {
+    let mut units=vec![native("struct same { int n; }; int f(struct same*,...);", "a.c",&[]),
+        native("struct same { long n; }; int f(struct same *n,...){return n->n;}","b.c",&[])];
