diff --git a/c2rust-transpile/src/c_ast/closed_variadic.rs b/c2rust-transpile/src/c_ast/closed_variadic.rs
new file mode 100644
--- /dev/null
+++ b/c2rust-transpile/src/c_ast/closed_variadic.rs
@@ -0,0 +1,2156 @@
+use super::*;
+use serde_json::{Value, json};
+
+pub struct ClosedFormatReport {
+    pub inventory: Value,
+    pub facts: Value,
+}
+
+struct ReportGraph<'a> {
+    order: Vec<CDeclId>,
+    ast: &'a TypedAstContext,
+    unit: &'a Path,
+    locations: Value,
+    parameter_owners: HashMap<CDeclId, Vec<u64>>,
+    field_owners: HashMap<CDeclId, Vec<Value>>,
+    types: std::collections::BTreeMap<CTypeId, Value>,
+    records: HashMap<CDeclId, Value>,
+    qualified: std::cell::RefCell<std::collections::BTreeMap<String, Value>>,
+    expressions: std::collections::BTreeMap<CExprId, Value>,
+    variables: std::collections::BTreeMap<CDeclId, Value>,
+    statements: std::collections::BTreeMap<CStmtId, Value>,
+}
+
+impl ClosedFormatReport {
+    pub fn capture(ast: &TypedAstContext, unit: &Path) -> Self {
+        let graph = ReportGraph::capture(ast, unit);
+        let inventory = graph.inventory();
+        let facts = graph.facts(&inventory);
+        Self { inventory, facts }
+    }
+}
+
+impl<'a> ReportGraph<'a> {
+    fn qualified_key(typ: CQualTypeId) -> Value {
+        TypedAstContext::required_qualified_type(typ)
+    }
+
+    fn read_key(value: &Value) -> CQualTypeId {
+        CQualTypeId {
+            ctype: CTypeId(value["type_id"].as_u64().expect("qualified type ID")),
+            qualifiers: Qualifiers {
+                is_const: value["const"].as_bool().expect("const qualifier"),
+                is_volatile: value["volatile"].as_bool().expect("volatile qualifier"),
+                is_restrict: value["restrict"].as_bool().expect("restrict qualifier"),
+            },
+        }
+    }
+
+    fn normalize(&self, source: CQualTypeId) -> Value {
+        let source_key = Self::qualified_key(source);
+        let key = source_key.to_string();
+        if let Some(row) = self.qualified.borrow().get(&key) { return row.clone(); }
+        let mut current = source;
+        let mut path = vec![];
+        let mut seen = HashSet::new();
+        let mut reason = None;
+        for step in 0..=32 {
+            path.push(current.ctype.0);
+            if step == 32 { break; }
+            if !seen.insert(current.ctype) { reason = Some("typedef or wrapper cycle"); break; }
+            let row = self.types.get(&current.ctype).expect("raw type missing");
+            match row["kind"].as_str() {
+                Some("typedef") => {
+                    if let Some(original) = row.get("original") {
+                        let original = Self::read_key(original);
+                        current.qualifiers = current.qualifiers.and(original.qualifiers);
+                        current.ctype = original.ctype;
+                    } else { reason = Some("missing original typedef"); break; }
+                }
+                Some("typeof" | "paren" | "elaborated" | "decayed" | "auto") => {
+                    current.ctype = CTypeId(row["inner"].as_u64().expect("wrapper type"));
+                }
+                Some("attributed") => { reason = Some("attributed type facts"); break; }
+                _ => break,
+            }
+        }
+        let mut row = json!({"source": source_key, "path": path});
+        if let Some(reason) = reason { row["unproved"] = json!(reason); }
+        else { row["normalized"] = Self::qualified_key(current); }
+        self.qualified.borrow_mut().insert(key, row.clone());
+        row
+    }
+
+    fn type_view(&self, source: CQualTypeId, depth: usize, cursor: bool) -> Value {
+        if depth > 32 { return json!({"unproved": "type depth limit"}); }
+        let normalized = self.normalize(source);
+        if let Some(reason) = normalized.get("unproved") { return json!({"unproved": reason}); }
+        let key = &normalized["normalized"];
+        let row = &self.types[&CTypeId(key["type_id"].as_u64().unwrap())];
+        let child = |q: &Value| self.type_view(Self::read_key(q), depth + 1, cursor);
+        let canonical = match row["kind"].as_str() {
+            Some("pointer") => json!({"pointer": child(&row["pointee"])}),
+            Some("function") => json!({"return": child(&row["return"]),
+                "parameters": row["parameters"].as_array().unwrap().iter().map(child).collect::<Vec<_>>(),
+                "variadic": row["variadic"], "noreturn": row["noreturn"], "prototype": row["prototype"], "abi": row["abi"]}),
+            Some("array") => {
+                let Some(element) = row.get("element") else { return json!({"unproved": "missing original qualified array element"}); };
+                let mut value = json!({"array": child(element)});
+                if !row["length"].is_null() { value["length"] = row["length"].clone(); }
+                value
+            }
+            Some("struct" | "union" | "enum") => {
+                let decl = CDeclId(row["declaration"].as_u64().unwrap());
+                let record = &self.records[&decl];
+                if cursor && record["native_va_list_record"] == true { json!({"native_va_list_record": decl.0}) }
+                else { json!({"record": record["identity"]}) }
+            }
+            Some("Char") => match row.get("signed") {
+                Some(signed) => json!({"kind": "Char", "signed": signed}),
+                None => json!({"unproved": "missing plain char signedness"}),
+            },
+            Some("LongDouble") => json!({"unproved": "long double ABI shape"}),
+            Some(kind @ ("Void" | "Bool" | "SChar" | "Short" | "Int" | "Long" | "LongLong" |
+                "UChar" | "UShort" | "UInt" | "ULong" | "ULongLong" | "Float" | "Double" |
+                "Int128" | "UInt128" | "Half")) => json!({"kind": kind}),
+            _ => json!({"unproved": "unsupported type or wrapper limit"}),
+        };
+        json!({"canonical": canonical, "const": key["const"], "volatile": key["volatile"], "restrict": key["restrict"]})
+    }
+
+    fn inventory_type(&self, typ: CQualTypeId, depth: usize) -> Value { self.type_view(typ, depth, false) }
+    fn cursor_type(&self, typ: CQualTypeId, depth: usize) -> Value { self.type_view(typ, depth, true) }
+
+    fn edge(node: iterators::SomeId) -> Value {
+        use iterators::SomeId::*;
+        let (kind, id) = match node {
+            Expr(id) => ("expression", id.0), Stmt(id) => ("statement", id.0),
+            Decl(id) => ("declaration", id.0), Type(id) => ("type", id.0),
+        };
+        json!({"kind": kind, "id": id})
+    }
+
+    fn edges(&self, node: iterators::SomeId, row: &mut Value) {
+        let (df, structural) = iterators::report_children(self.ast, node);
+        for child in df.iter().chain(structural.iter()) {
+            assert!(self.ast.contains_node(*child), "missing mandatory report child: {child:?}");
+        }
+        row["df_children"] = json!(df.into_iter().map(Self::edge).collect::<Vec<_>>());
+        row["structural_children"] = json!(structural.into_iter().map(Self::edge).collect::<Vec<_>>());
+    }
+
+    fn walk(&self, root: Value) -> (Vec<Value>, bool) {
+        fn visit(graph: &ReportGraph<'_>, node: Value, path: &mut HashSet<(String, u64)>, result: &mut Vec<Value>, cyclic: &mut bool) {
+            let kind = node["kind"].as_str().unwrap();
+            let id = node["id"].as_u64().unwrap();
+            let key = (kind.to_owned(), id);
+            if !path.insert(key.clone()) { *cyclic = true; return; }
+            result.push(node.clone());
+            let row = match kind {
+                "expression" => &graph.expressions[&CExprId(id)],
+                "statement" => &graph.statements[&CStmtId(id)],
+                "declaration" => &graph.variables[&CDeclId(id)],
+                "type" => &graph.types[&CTypeId(id)],
+                _ => unreachable!(),
+            };
+            for child in row["df_children"].as_array().unwrap() { visit(graph, child.clone(), path, result, cyclic); }
+            path.remove(&key);
+        }
+        let mut result = vec![];
+        let mut cyclic = false;
+        visit(self, root, &mut HashSet::new(), &mut result, &mut cyclic);
+        (result, cyclic)
+    }
+
+    fn terminal(&self, mut id: CExprId) -> CExprId {
+        let mut seen = HashSet::new();
+        while matches!(self.expressions[&id]["kind"].as_str(), Some("paren" | "implicit_cast")) {
+            assert!(seen.insert(id), "cyclic expression wrapper path");
+            let children = self.expressions[&id]["children"].as_array().unwrap();
+            assert_eq!(children.len(), 1, "ambiguous expression wrapper path");
+            id = CExprId(children[0].as_u64().unwrap());
+        }
+        id
+    }
+
+    fn callee(&self, root: CExprId) -> Option<CDeclId> {
+        let row = &self.expressions[&self.terminal(root)];
+        let id = CDeclId(row["decl"].as_u64()?);
+        (self.variables[&id]["kind"] == "function").then_some(id)
+    }
+
+    fn promotions(&self, mut id: CExprId) -> Vec<Value> {
+        let mut result = vec![];
+        let mut seen = HashSet::new();
+        loop {
+            assert!(seen.insert(id), "cyclic expression promotion path");
+            let row = &self.expressions[&id];
+            if !row["qualified_type"].is_null() { result.push(self.inventory_type(Self::read_key(&row["qualified_type"]), 0)); }
+            if !matches!(row["kind"].as_str(), Some("paren" | "implicit_cast")) { break; }
+            id = CExprId(row["children"][0].as_u64().unwrap());
+        }
+        result
+    }
+
+    fn operand(&self, id: CExprId) -> Value {
+        let row = &self.expressions[&id];
+        let terminal = &self.expressions[&self.terminal(id)];
+        let (nodes, cyclic) = self.walk(Self::edge(id.into()));
+        let references: Vec<_> = nodes.iter().filter_map(|node| {
+            if node["kind"] != "expression" { return None; }
+            let e = &self.expressions[&CExprId(node["id"].as_u64().unwrap())];
+            (e["kind"] == "reference").then(|| json!({"id": e["id"], "decl": e["decl"]}))
+        }).collect();
+        let mut operand = json!({"id": id.0, "direct_decl": terminal.get("decl").filter(|_| terminal["kind"] == "reference"),
+            "literal": terminal["literal"]["bytes"].as_array().filter(|_| terminal["literal"]["width"] == 1),
+            "type": if row["qualified_type"].is_null() { Value::Null } else { self.cursor_type(Self::read_key(&row["qualified_type"]), 0) },
+            "references": references});
+        if cyclic { operand["references_unproved"] = json!("cyclic DF traversal retains raw edges"); }
+        operand
+    }
+
+    fn expression(&self, id: CExprId) -> Value {
+        let mut row = self.expressions[&id].clone();
+        row["type"] = if row["qualified_type"].is_null() { Value::Null } else { self.cursor_type(Self::read_key(&row["qualified_type"]), 0) };
+        row["promotion_chain"] = json!(self.promotions(id));
+        if row["kind"] == "member" {
+            row["member"] = self.variables[&CDeclId(row["member"]["id"].as_u64().unwrap())].clone();
+        }
+        if row["kind"] == "call" {
+            let callee = CExprId(row["children"][0].as_u64().unwrap());
+            let declaration = self.callee(callee);
+            row["callee_expression"] = json!(callee.0);
+            row["callee_reference"] = json!(self.terminal(callee).0);
+            row["callee_decl"] = json!(declaration.map(|d| d.0));
+            row["builtin"] = declaration.map(|d| self.variables[&d]["builtin"].clone()).unwrap_or(Value::Null);
+            row["arguments"] = json!(row["children"].as_array().unwrap()[1..].iter()
+                .map(|a| self.operand(CExprId(a.as_u64().unwrap()))).collect::<Vec<_>>());
+        }
+        row
+    }
+
+    fn inventory(&self) -> Value {
+        let mut owners = HashMap::new();
+        let mut declarations = vec![];
+        for id in &self.order {
+            let row = &self.variables[id];
+            if row["kind"] != "function" { continue; }
+            declarations.push(json!({"id": id.0, "symbol": row["symbol"], "location": row["diagnostic_location"],
+                "signature": self.inventory_type(Self::read_key(&row["qualified_type"]), 0),
+                "definition": !row["body"].is_null(), "aliases": row["aliases"], "va_parameters": row["va_parameters"]}));
+            if let Some(body) = row["body"].as_u64() {
+                for node in self.walk(Self::edge(CStmtId(body).into())).0 {
+                    if node["kind"] == "expression" { owners.insert(node["id"].as_u64().unwrap(), id.0); }
+                }
+            }
+        }
+        let mut direct_refs = HashSet::new();
+        let mut calls = vec![];
+        for (id, row) in &self.expressions {
+            if row["kind"] != "call" { continue; }
+            let callee = CExprId(row["children"][0].as_u64().unwrap());
+            let declaration = self.callee(callee);
+            if declaration.is_some() {
+                for node in self.walk(Self::edge(callee.into())).0 {
+                    if node["kind"] == "expression" { direct_refs.insert(node["id"].as_u64().unwrap()); }
+                }
+            }
+            calls.push(json!({"id": id.0, "owner": owners.get(&id.0), "location": row["diagnostic_location"],
+                "callee": declaration.map(|d| self.variables[&d]["symbol"].clone()),
+                "arguments": row["children"].as_array().unwrap()[1..].iter().map(|a| {
+                    let id = CExprId(a.as_u64().unwrap()); let arg = &self.expressions[&id];
+                    json!({"id": id.0, "promotion_chain": self.promotions(id),
+                        "type": if arg["qualified_type"].is_null() { Value::Null } else { self.inventory_type(Self::read_key(&arg["qualified_type"]), 0) },
+                        "va_list": arg["va_list"]})
+                }).collect::<Vec<_>>()}));
+        }
+        let mut escapes = vec![];
+        let mut va_arg = vec![];
+        for (id, row) in &self.expressions {
+            if row["kind"] == "reference" && !direct_refs.contains(&id.0) {
+                let decl = &self.variables[&CDeclId(row["decl"].as_u64().unwrap())];
+                if decl["kind"] == "function" { escapes.push(json!({"symbol": decl["symbol"], "location": row["diagnostic_location"]})); }
+            }
+            if row["native_shape"] == "VAArg" { va_arg.push(json!({"owner": owners.get(&id.0), "location": row["diagnostic_location"]})); }
+        }
+        let records: Vec<_> = self.order.iter().filter_map(|id| self.records.get(id)).map(|r| {
+            let mut facts = json!({});
+            if r["kind"] == "enum" {
+                facts["underlying"] = if r["underlying"].is_null() { Value::Null } else { self.inventory_type(Self::read_key(&r["underlying"]), 0) };
+                facts["variants"] = json!(r["variants"].as_array().unwrap().iter().map(|id| {
+                    let v = &self.variables[&CDeclId(id.as_u64().unwrap())];
+                    if v["kind"] == "enum_constant" { json!({"name": v["name"], "signed": v["signed"], "value": v["value"]}) }
+                    else { json!({"unproved": "non-enumerator child"}) }
+                }).collect::<Vec<_>>());
+            } else {
+                facts["fields"] = r["fields"].as_array().map(|fields| json!(fields.iter().map(|id| {
+                    let f = &self.variables[&CDeclId(id.as_u64().unwrap())];
+                    if f["kind"] == "field" { json!({"name": f["name"], "type": self.inventory_type(Self::read_key(&f["qualified_type"]), 0),
+                        "bit_width": f["bit_width"], "bit_offset": f["bit_offset"], "type_bit_width": f["type_bit_width"], "alignment": f["alignment"]}) }
+                    else { json!({"unproved": "non-field record child"}) }
+                }).collect::<Vec<_>>())).unwrap_or(Value::Null);
+                facts["layout"] = r["layout"].clone();
+            }
+            json!({"identity": r["identity"], "state": r["state"], "facts": facts, "diagnostic_location": r["diagnostic_location"]})
+        }).collect();
+        json!({"schema": 2, "record_evidence_schema": 2, "record_definitions": records, "unit": self.unit, "target": self.ast.target,
+            "target_c_widths_bits": {"char": self.ast.target_c_widths[0], "short": self.ast.target_c_widths[1], "int": self.ast.target_c_widths[2],
+                "long": self.ast.target_c_widths[3], "long_long": self.ast.target_c_widths[4], "pointer": self.ast.target_c_widths[5],
+                "float": self.ast.target_c_widths[6], "double": self.ast.target_c_widths[7]},
+            "authorization": "inventory_only", "declarations": declarations, "calls": calls, "non_call_references": escapes, "va_arg": va_arg})
+    }
+
+    fn record_identity(&self, id: CDeclId, _depth: usize) -> Value { self.records[&id]["identity"].clone() }
+
+    fn location(&self, id: u64) -> Value {
+        self.locations.get(id.to_string()).cloned().unwrap_or(json!({"unproved": "native importer origin missing"}))
+    }
+
+    fn capture(ast: &'a TypedAstContext, unit: &'a Path) -> Self {
+        let locations = ast.format_locations.as_ref().map(|s| serde_json::from_str(s).expect("mapped native locations")).unwrap_or(json!({}));
+        let mut graph = Self { ast, unit, locations, parameter_owners: Default::default(), field_owners: Default::default(), order: ast.iter_decls().map(|(id, _)| *id).collect(),
+            types: Default::default(), records: Default::default(), qualified: Default::default(),
+            expressions: Default::default(), variables: Default::default(), statements: Default::default() };
+        for (id, _) in &ast.c_types {
+            let (mut row, _) = ast.required_type_relation(*id);
+            match &ast[*id].kind {
+                CTypeKind::Attributed(q, _) => { row["kind"] = json!("attributed"); row["original"] = Self::qualified_key(*q); }
+                CTypeKind::LongDouble => row["kind"] = json!("LongDouble"),
+                _ => {}
+            }
+            let shape = format!("{:?}", ast[*id].kind);
+            row["native_shape"] = json!(shape.split('(').next().unwrap());
+            match &ast[*id].kind {
+                CTypeKind::ConstantArray(element, _) | CTypeKind::IncompleteArray(element) |
+                CTypeKind::Complex(element) => row["element_type"] = json!(element.0),
+                CTypeKind::VariableArray(element, count) => {
+                    row["element_type"] = json!(element.0);
+                    row["count_expression"] = json!(count.map(|e| e.0));
+                }
+                CTypeKind::Reference(q) | CTypeKind::BlockPointer(q) | CTypeKind::Vector(q, _) |
+                CTypeKind::Atomic(q) => row["original"] = Self::qualified_key(*q),
+                CTypeKind::Attributed(_, attr) => {
+                    row["counted_by"] = match attr {
+                        Some(Attribute::CountedBy(_, Some(e))) => json!(e.0), _ => Value::Null,
+                    };
+                }
+                CTypeKind::TypeOfExpr(e) => row["expression"] = json!(e.0),
+                _ => {}
+            }
+            graph.edges((*id).into(), &mut row);
+            graph.types.insert(*id, row);
+        }
+        for (id, decl) in ast.iter_decls() {
+            let mut row = json!({"id": id.0, "identity": ast.inventory_record_identity(*id, 0),
+                "native_va_list_record": ast.native_va_list_records.contains(id),
+                "diagnostic_location": decl.begin_loc().map(|l| ast.loc_to_string(l))});
+            match &decl.kind {
+                CDeclKind::Struct { fields, .. } | CDeclKind::Union { fields, .. } => {
+                    row["kind"] = json!(if matches!(decl.kind, CDeclKind::Struct { .. }) { "struct" } else { "union" });
+                    row["fields"] = json!(fields.as_ref().map(|fs| fs.iter().map(|f| f.0).collect::<Vec<_>>()));
+                    row["layout"] = ast.record_evidence.get(id).map(|e| json!(e.10)).unwrap_or(Value::Null);
+                }
+                CDeclKind::Enum { variants, underlying_type_id, .. } => {
+                    row["kind"] = json!("enum"); row["variants"] = json!(variants.iter().map(|v| v.0).collect::<Vec<_>>());
+                    row["underlying"] = underlying_type_id.map(Self::qualified_key).unwrap_or(Value::Null);
+                }
+                _ => continue,
+            }
+            row["state"] = json!(match ast.record_evidence.get(id) { Some(e) if e.0 == 2 && e.9 => "complete", Some(e) if e.0 == 2 => "incomplete", _ => "unproved" });
+            graph.records.insert(*id, row);
+        }
+        for (owner, decl) in ast.iter_decls() {
+            if let CDeclKind::Function { parameters, .. } = &decl.kind {
+                for id in parameters { graph.parameter_owners.entry(*id).or_default().push(owner.0); }
+            }
+            if let CDeclKind::Struct { fields: Some(fields), .. } | CDeclKind::Union { fields: Some(fields), .. } = &decl.kind {
+                for id in fields { graph.field_owners.entry(*id).or_default().push(graph.records[owner]["identity"].clone()); }
+            }
+        }
+        let owners = ast.cursor_declaration_owners();
+        for (id, _) in ast.iter_decls() { graph.variables.insert(*id, graph.capture_declaration(*id, &owners)); }
+        for id in ast.c_exprs.keys() { graph.expressions.insert(*id, graph.capture_expression(*id)); }
+        graph.capture_statements();
+        graph
+    }
+
+    fn capture_statements(&mut self) {
+        let statements: Vec<_> = self.ast.c_stmts.keys().copied().collect();
+        let statements: Vec<_> = statements.into_iter().map(|id| {
+            let mut children = vec![];
+            let mut edge = |role: &str, node: iterators::SomeId| {
+                let (kind, id) = if let Some(id) = node.stmt() { ("statement", id.0) }
+                    else if let Some(id) = node.expr() { ("expression", id.0) }
+                    else { ("declaration", node.decl().expect("structural declaration").0) };
+                children.push(json!({"role": role, "kind": kind, "id": id}));
+            };
+            let (kind, shape) = match &self.ast[id].kind {
+                CStmtKind::Compound(items) => { for s in items { edge("item", (*s).into()); } ("compound", "Compound") }
+                CStmtKind::Expr(e) => { edge("expression", (*e).into()); ("expression", "Expr") }
+                CStmtKind::Decls(items) => { for d in items { edge("declaration", (*d).into()); } ("declarations", "Decls") }
+                CStmtKind::Return(e) => { for e in e { edge("value", (*e).into()); } ("return", if e.is_some() { "ReturnValue" } else { "ReturnVoid" }) }
+                CStmtKind::If { scrutinee, true_variant, false_variant } => {
+                    edge("condition", (*scrutinee).into()); edge("then", (*true_variant).into());
+                    for s in false_variant { edge("else", (*s).into()); } ("branch", if false_variant.is_some() { "IfElse" } else { "If" })
+                }
+                CStmtKind::Switch { scrutinee, body } => { edge("condition", (*scrutinee).into()); edge("body", (*body).into()); ("branch", "Switch") }
+                CStmtKind::While { condition, body } => { edge("condition", (*condition).into()); edge("body", (*body).into()); ("loop", "While") }
+                CStmtKind::DoWhile { condition, body } => { edge("body", (*body).into()); edge("condition", (*condition).into()); ("loop", "DoWhile") }
+                CStmtKind::ForLoop { init, condition, increment, body } => {
+                    for s in init { edge("init", (*s).into()); } for e in condition { edge("condition", (*e).into()); }
+                    for e in increment { edge("increment", (*e).into()); } edge("body", (*body).into());
+                    let mask = usize::from(init.is_some()) * 4 + usize::from(condition.is_some()) * 2 + usize::from(increment.is_some());
+                    ("loop", ["ForLoop000", "ForLoop001", "ForLoop010", "ForLoop011", "ForLoop100", "ForLoop101", "ForLoop110", "ForLoop111"][mask])
+                }
+                CStmtKind::Label(s) => { edge("body", (*s).into()); ("label", "Label") }
+                CStmtKind::Case(e, s, _) => { edge("value", (*e).into()); edge("body", (*s).into()); ("label", "Case") }
+                CStmtKind::Default(s) => { edge("body", (*s).into()); ("label", "Default") }
+                CStmtKind::Attributed { substatement, .. } => { edge("body", (*substatement).into()); ("attributed", "Attributed") }
+                CStmtKind::Goto(_) => ("goto", "Goto"), CStmtKind::Break => ("break", "Break"),
+                CStmtKind::Continue => ("continue", "Continue"), CStmtKind::Empty => ("empty", "Empty"),
+                CStmtKind::Asm { .. } => {
+                    for n in iterators::report_children(self.ast, id.into()).1 { edge("operand", n); } ("unsupported", "Asm")
+                }
+                CStmtKind::BadStmt => ("unsupported", "BadStmt"),
+            };
+            let label_target = match self.ast[id].kind { CStmtKind::Goto(label) => Some(label.0), _ => None };
+            let mut row = json!({"id": id.0, "kind": kind, "label_target": label_target, "native_shape": shape, "location": self.location(id.0), "edge_count": children.len(),
+                "children": children, "flow": {"state": "Unproved", "reason": "structural edges only; execution and cursor state relations not established"}});
+            self.edges(id.into(), &mut row);
+            (id, row)
+        }).collect();
+        self.statements = statements.into_iter().collect();
+    }
+    fn capture_declaration(&self, id: CDeclId, owners: &HashMap<CDeclId, HashSet<CDeclId>>) -> Value {
+        let mut value = json!({"id": id.0});
+        match &self.ast[id].kind {
+            CDeclKind::Variable { ident, typ, initializer, has_static_duration, has_thread_duration, is_externally_visible, .. } => {
+                value["kind"] = json!("variable");
+                value["name"] = json!(ident);
+                value["local"] = json!(self.ast.native_local_variables.contains(&id));
+                value["va_list"] = json!(self.ast.is_va_list(typ.ctype));
+                value["owning_function"] = if self.ast.native_local_variables.contains(&id) {
+                    match owners.get(&id) {
+                        Some(ids) if ids.len() == 1 => json!(ids.iter().next().unwrap().0),
+                        _ => json!({"unproved": "missing or ambiguous lexical function owner"}),
+                    }
+                } else { Value::Null };
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["initializer"] = json!(initializer.map(|e| e.0));
+                value["static"] = json!(has_static_duration);
+                value["thread"] = json!(has_thread_duration);
+                value["externally_visible"] = json!(is_externally_visible);
+                value["native_va_list"] = self.ast.native_cursor_types.get(&id).map(|(declared, builtin, kind)|
+                    json!({"same_canonical_type": true, "declared_type_id": declared.ctype.0,
+                        "builtin_type_id": builtin.ctype.0,
+                        "declared_canonical_type": self.cursor_type(*declared, 0),
+                        "builtin_canonical_type": self.cursor_type(*builtin, 0),
+                        "declared_const": declared.qualifiers.is_const,
+                        "declared_volatile": declared.qualifiers.is_volatile, "declared_restrict": declared.qualifiers.is_restrict,
+                        "builtin_const": builtin.qualifiers.is_const, "builtin_volatile": builtin.qualifiers.is_volatile,
+                        "builtin_restrict": builtin.qualifiers.is_restrict, "target_kind": kind})).unwrap_or(Value::Null);
+            }
+            CDeclKind::Field { name, typ, .. } => {
+                value["kind"] = json!("field"); value["name"] = json!(name);
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["owners"] = json!(self.field_owners.get(&id).cloned().unwrap_or_default());
+            }
+            CDeclKind::EnumConstant { name, value: number } => {
+                value["kind"] = json!("enum_constant"); value["name"] = json!(name);
+                value["owning_enum"] = match owners.get(&id) {
+                    Some(ids) if ids.len() == 1 => {
+                        let owner = *ids.iter().next().unwrap();
+                        json!({"declaration": owner.0, "identity": self.record_identity(owner, 0)})
+                    }
+                    _ => json!({"unproved": "missing or ambiguous enum variant owner"}),
+                };
+                value["value"] = match number { ConstIntExpr::I(n) => json!(n), ConstIntExpr::U(n) => json!(n) };
+            }
+            CDeclKind::NonCanonicalDecl { canonical_decl } => {
+                value["kind"] = json!("unsupported"); value["native_shape"] = json!("NonCanonicalDecl");
+                value["canonical_decl"] = json!(canonical_decl.0);
+            }
+            CDeclKind::StaticAssert { assert_expr, .. } => {
+                value["kind"] = json!("unsupported"); value["native_shape"] = json!("StaticAssert");
+                value["assert_expr"] = json!(assert_expr.0);
+            }
+            CDeclKind::MacroObject { .. } | CDeclKind::MacroFunction { .. } => {
+                value["kind"] = json!("unsupported");
+                value["native_shape"] = json!(if matches!(self.ast[id].kind, CDeclKind::MacroObject { .. }) { "MacroObject" } else { "MacroFunction" });
+            }
+            _ => value["kind"] = json!("unsupported"),
+        }
+        value["diagnostic_location"] = json!(self.ast[id].begin_loc().map(|l| self.ast.loc_to_string(l)));
+        value["parameter_owners"] = json!(self.parameter_owners.get(&id).cloned().unwrap_or_default());
+        match &self.ast[id].kind {
+            CDeclKind::Function { typ, parameters, body, attrs, .. } => {
+                value["kind"] = json!("function"); value["type_id"] = json!(typ.0);
+                value["qualified_type"] = Self::qualified_key(CQualTypeId::new(*typ));
+                value["parameters"] = json!(parameters.iter().map(|p| p.0).collect::<Vec<_>>());
+                value["body"] = json!(body.map(|b| b.0));
+                value["builtin"] = json!(self.ast.cursor_builtin_identity.get(&id));
+                value["symbol"] = self.ast.inventory_symbol(id, self.unit).unwrap();
+                value["aliases"] = json!(attrs.iter().filter_map(|a| match a { Attribute::Alias(name) => Some(name.clone()), _ => None }).collect::<Vec<_>>());
+                value["va_parameters"] = json!(parameters.iter().filter(|p| match self.ast[**p].kind {
+                    CDeclKind::Variable { typ, .. } => self.ast.is_va_list(typ.ctype), _ => false,
+                }).map(|p| p.0).collect::<Vec<_>>());
+            }
+            CDeclKind::Variable { typ, .. } | CDeclKind::Typedef { typ, .. } | CDeclKind::Field { typ, .. } => {
+                value["qualified_type"] = Self::qualified_key(*typ);
+                if matches!(self.ast[id].kind, CDeclKind::Typedef { .. }) { value["kind"] = json!("typedef"); value["type_id"] = json!(typ.ctype.0); }
+            }
+            CDeclKind::Struct { .. } | CDeclKind::Union { .. } | CDeclKind::Enum { .. } => {
+                for (key, field) in self.records[&id].as_object().unwrap() { value[key] = field.clone(); }
+            }
+            _ => {}
+        }
+        if let CDeclKind::Field { bitfield_width, platform_bit_offset, platform_type_bitwidth, manual_alignment, .. } = &self.ast[id].kind {
+            value["bit_width"] = json!(bitfield_width); value["bit_offset"] = json!(platform_bit_offset);
+            value["type_bit_width"] = json!(platform_type_bitwidth); value["alignment"] = json!(manual_alignment);
+        }
+        if let CDeclKind::EnumConstant { value: number, .. } = &self.ast[id].kind {
+            value["signed"] = json!(matches!(number, ConstIntExpr::I(_)));
+        }
+        self.edges(id.into(), &mut value);
+        value
+    }
+
+    fn capture_expression(&self, id: CExprId) -> Value {
+        let mut value = json!({"id": id.0, "kind": "unsupported",
+            "qualified_type": self.ast[id].kind.get_qual_type().map(Self::qualified_key),
+            "type_id": self.ast[id].kind.get_qual_type().map(|t| t.ctype.0),
+            "children": []});
+        match &self.ast[id].kind {
+            CExprKind::Literal(_, literal) => {
+                value["kind"] = json!("literal");
+                value["literal"] = match literal {
+                    CLiteral::Integer(n, _) => json!({"integer": n}),
+                    CLiteral::Character(n) => json!({"character": n}),
+                    CLiteral::String(bytes, width) => json!({"bytes": bytes, "width": width}),
+                    _ => json!({"unsupported": true}),
+                };
+            }
+            CExprKind::DeclRef(_, decl, _) => {
+                value["kind"] = json!("reference"); value["decl"] = json!(decl.0);
+            }
+            CExprKind::Paren(_, child) => {
+                value["kind"] = json!("paren"); value["children"] = json!([child.0]);
+            }
+            CExprKind::ImplicitCast(_, child, cast, field, _) |
+            CExprKind::ExplicitCast(_, child, cast, field, _) => {
+                value["kind"] = json!(if matches!(self.ast[id].kind, CExprKind::ImplicitCast(..)) { "implicit_cast" } else { "explicit_cast" });
+                value["children"] = json!([child.0]); value["cast"] = json!(format!("{:?}", cast));
+                value["field"] = json!(field.map(|f| f.0));
+            }
+            CExprKind::Unary(_, op, child, _) => {
+                value["kind"] = json!("unary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([child.0]);
+            }
+            CExprKind::UnaryType(_, op, child, argument_type) => {
+                value["kind"] = json!("unary_type"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!(child.iter().map(|c| c.0).collect::<Vec<_>>());
+                value["argument_qualified_type"] = Self::qualified_key(*argument_type);
+                value["argument_type"] = self.cursor_type(*argument_type, 0);
+            }
+            CExprKind::Binary(_, op, left, right, lhs_type, rhs_type) => {
+                value["kind"] = json!("binary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([left.0, right.0]);
+                value["computation_qualified_types"] = json!([lhs_type.map(Self::qualified_key), rhs_type.map(Self::qualified_key)]);
+                value["computation_types"] = json!([lhs_type.map(|t| self.cursor_type(t, 0)), rhs_type.map(|t| self.cursor_type(t, 0))]);
+            }
+            CExprKind::Call(_, callee, args) => {
+                value["kind"] = json!("call");
+                value["children"] = json!(std::iter::once(callee.0).chain(args.iter().map(|a| a.0)).collect::<Vec<_>>());
+            }
+            CExprKind::Member(_, parent, member, kind, _) => {
+                value["kind"] = json!("member"); value["children"] = json!([parent.0]);
+                value["member"] = json!({"id": member.0});
+                value["access"] = json!(format!("{:?}", kind));
+            }
+            CExprKind::ArraySubscript(_, base, index, _) => {
+                value["kind"] = json!("subscript"); value["children"] = json!([base.0, index.0]);
+            }
+            _ => {}
+        }
+        value["operands"] = match &self.ast[id].kind {
+            CExprKind::Unary(_, _, e, _) | CExprKind::ConstantExpr(_, e, _) |
+            CExprKind::ImplicitCast(_, e, _, _, _) | CExprKind::ExplicitCast(_, e, _, _, _) |
+            CExprKind::Member(_, e, _, _, _) | CExprKind::Paren(_, e) |
+            CExprKind::CompoundLiteral(_, e) | CExprKind::ImaginaryLiteral(_, e) |
+            CExprKind::Predefined(_, e) | CExprKind::VAArg(_, e) => json!({"child": e.0}),
+            CExprKind::Binary(_, _, left, right, _, _) | CExprKind::ArraySubscript(_, left, right, _) |
+            CExprKind::BinaryConditional(_, left, right) => json!({"left": left.0, "right": right.0}),
+            CExprKind::Conditional(_, c, t, e) | CExprKind::Choose(_, c, t, e, _) =>
+                json!({"condition": c.0, "then": t.0, "else": e.0}),
+            CExprKind::UnaryType(_, _, expression, _) => json!({"expression": expression.map(|e| e.0)}),
+            CExprKind::Call(_, callee, args) => json!({"callee": callee.0, "arguments": args.iter().map(|a| a.0).collect::<Vec<_>>()}),
+            CExprKind::InitList(_, items, _, _) => json!({"initializers": items.iter().map(|e| e.0).collect::<Vec<_>>()}),
+            CExprKind::ShuffleVector(_, items) | CExprKind::ConvertVector(_, items) =>
+                json!({"elements": items.iter().map(|e| e.0).collect::<Vec<_>>()}),
+            CExprKind::Atomic { ptr, order, val1, order_fail, val2, weak, .. } =>
+                json!({"ptr": ptr.0, "order": order.0, "val1": val1.map(|e| e.0), "order_fail": order_fail.map(|e| e.0),
+                    "val2": val2.map(|e| e.0), "weak": weak.map(|e| e.0)}),
+            CExprKind::Statements(_, body) => json!({"body": body.0}),
+            CExprKind::OffsetOf(_, OffsetOfKind::Variable(q, _, index)) => json!({"type": q.ctype.0, "index": index.0}),
+            CExprKind::OffsetOf(_, OffsetOfKind::Constant(_)) => json!({"type": null, "index": null}),
+            CExprKind::Literal(..) | CExprKind::DeclRef(..) | CExprKind::ImplicitValueInit(..) |
+            CExprKind::BadExpr | CExprKind::DesignatedInitExpr(..) => json!({}),
+        };
+        value["native_shape"] = json!(self.ast.format_expression_shape(id));
+        value["diagnostic_location"] = json!(self.ast[id].begin_loc().map(|l| self.ast.loc_to_string(l)));
+        value["location"] = self.location(id.0);
+        value["statement_body"] = match self.ast[id].kind { CExprKind::Statements(_, body) => json!(body.0), _ => Value::Null };
+        value["va_list"] = json!(self.ast[id].kind.get_qual_type().map(|t| self.ast.is_va_list(t.ctype)));
+        self.edges(id.into(), &mut value);
+        value["children"] = json!(value["structural_children"].as_array().unwrap().iter()
+            .filter(|e| e["kind"] == "expression").map(|e| e["id"].clone()).collect::<Vec<_>>());
+        value["edge_count"] = json!(value["children"].as_array().unwrap().len());
+        value["effect_relation"] = json!({"state": "Unproved", "reason": "calls, writes, volatile access and conditional evaluation retained without commutativity proof"});
+        if value["qualified_type"].is_null() { value["type_unproved"] = json!("importer expression has no qualified type"); }
+        value
+    }
+
+    fn finalize_expression_views(&self) -> (std::collections::BTreeMap<CExprId, Value>, Vec<Value>) {
+        let expressions = self.expressions.keys().map(|id| (*id, self.expression(*id))).collect();
+        let qualified_types = self.qualified.borrow().values().cloned().collect();
+        (expressions, qualified_types)
+    }
+
+    fn facts(&self, inventory: &Value) -> Value {
+        use std::collections::{BTreeMap, BTreeSet};
+        let unit = self.unit;
+        let owners = self.ast.cursor_declaration_owners();
+        let native_locations: Value = self.ast.format_locations.as_ref().map(|s| serde_json::from_str(s).expect("mapped native locations")).unwrap_or(json!({}));
+        let location = |id: u64| native_locations.get(id.to_string()).cloned()
+            .unwrap_or(json!({"unproved": "native importer origin missing"}));
+        let mut relevant = BTreeMap::new();
+        let mut definitions = vec![];
+        let mut function_edges = vec![];
+        let mut unclassified = vec![];
+        let mut pending = vec![];
+        for (id, declaration) in self.ast.iter_decls() {
+            let CDeclKind::Function { typ, parameters, body, .. } = &declaration.kind else { continue };
+            let signature = self.inventory_type(CQualTypeId::new(*typ), 0);
+            let va_parameters: Vec<_> = parameters.iter().filter(|p| match self.ast[**p].kind {
+                CDeclKind::Variable { typ, .. } => self.ast.is_va_list(typ.ctype), _ => false,
+            }).copied().collect();
+            let variadic = signature["canonical"]["variadic"].as_bool();
+            if variadic.is_none() {
+                if body.is_some() { unclassified.push(json!({"declaration": id.0, "symbol": self.ast.inventory_symbol(*id, unit),
+                    "signature": signature, "location": location(id.0), "state": "Unproved", "reason": "native attributed function signature unclassified"})); }
+                continue;
+            }
+            if variadic != Some(true) && va_parameters.is_empty() { continue; }
+            let fixed = parameters.len();
+            let format_position = if variadic == Some(true) { fixed.checked_sub(1) } else {
+                parameters.iter().position(|p| va_parameters.contains(p)).and_then(|p| p.checked_sub(1))
+            };
+            pending.push(iterators::SomeId::Decl(*id));
+            pending.extend(parameters.iter().map(|p| iterators::SomeId::Decl(*p)));
+            pending.push(iterators::SomeId::Type(*typ));
+            relevant.insert(*id, (fixed, format_position));
+            function_edges.push(json!({"declaration": id.0, "parameters": parameters.iter().map(|p| p.0).collect::<Vec<_>>(),
+                "fixed_count": fixed, "format_position": format_position,
+                "format_parameter": format_position.and_then(|p| parameters.get(p)).map(|p| p.0)}));
+            if let Some(body) = body {
+                pending.push(iterators::SomeId::Stmt(*body));
+                definitions.push(json!({"declaration": id.0, "symbol": self.ast.inventory_symbol(*id, unit),
+                    "variadic": variadic, "signature": self.cursor_type(CQualTypeId::new(*typ), 0),
+                    "parameters": parameters.iter().map(|p| p.0).collect::<Vec<_>>(),
+                    "va_parameters": va_parameters.iter().map(|p| p.0).collect::<Vec<_>>(), "body": body.0,
+                    "location": location(id.0), "generated_origin": {"state": "Unproved", "reason": "generated item interval not exported by emitter"},
+                    "control_effect_lifetime": {"state": "Unproved", "reason": "complete structural slice retained; aliasing, commutativity, lifetime and C evaluation order require closure"}}));
+            }
+        }
+        let mut calls = vec![];
+        for row in inventory["calls"].as_array().unwrap() {
+            let id = CExprId(row["id"].as_u64().unwrap());
+            let CExprKind::Call(_, callee, args) = &self.ast[id].kind else { continue };
+            let Some(decl) = self.callee(*callee) else { continue };
+            let Some((fixed, format_position)) = relevant.get(&decl) else { continue };
+            pending.push(iterators::SomeId::Expr(id));
+            let mut call = row.clone();
+            call["callee_declaration"] = json!(decl.0);
+            call["fixed_count"] = json!(fixed);
+            call["format_position"] = json!(format_position);
+            call["format_position_relation"] = json!({"state": "Unproved", "reason": "signature-adjacent format candidate; no format attribute proof"});
+            call["format"] = format_position.and_then(|p| args.get(p)).map(|e| self.ast.format_origin(*e, 0))
+                .unwrap_or(json!({"kind": "Unproved", "reason": "format argument absent"}));
+            call["native_location"] = location(id.0);
+            call["evaluation"] = json!({"state": "Unproved", "reason": "AST child order is not C sibling evaluation order or effect independence"});
+            call["generated_origin"] = json!({"state": "Unproved", "reason": "generated expression interval not exported by emitter"});
+            calls.push(call);
+        }
+        let mut visited = std::collections::HashSet::new();
+        let mut expressions = BTreeSet::new();
+        let mut statements = BTreeSet::new();
+        let mut declarations = BTreeSet::new();
+        let mut type_rows = BTreeMap::new();
+        while let Some(node) = pending.pop() {
+            if !visited.insert(node) { continue; }
+            if let Some(id) = node.type_() {
+                let (_, children) = self.ast.required_type_relation(id);
+                let row = self.types[&id].clone();
+                pending.extend(children.into_iter().map(iterators::SomeId::Type));
+                pending.extend(iterators::report_children(self.ast, node).1);
+                if let Some(decl) = row["declaration"].as_u64() { pending.push(iterators::SomeId::Decl(CDeclId(decl))); }
+                type_rows.insert(id, row);
+                continue;
+            }
+            if let Some(id) = node.expr() {
+                expressions.insert(id);
+                if let Some(typ) = self.ast[id].kind.get_qual_type() { pending.push(iterators::SomeId::Type(typ.ctype)); }
+                if let CExprKind::ImplicitCast(_, _, _, Some(field), _) | CExprKind::ExplicitCast(_, _, _, Some(field), _) = self.ast[id].kind {
+                    pending.push(iterators::SomeId::Decl(field));
+                }
+                if let CExprKind::DeclRef(_, decl, _) = self.ast[id].kind { pending.push(iterators::SomeId::Decl(decl)); }
+                if let CExprKind::Member(_, _, member, _, _) = self.ast[id].kind { pending.push(iterators::SomeId::Decl(member)); }
+            }
+            if let Some(id) = node.stmt() { statements.insert(id); }
+            if let Some(id) = node.decl() {
+                declarations.insert(id);
+                if let Some(ids) = owners.get(&id) {
+                    pending.extend(ids.iter().map(|d| iterators::SomeId::Decl(*d)));
+                }
+                if let Some((declared, builtin, _)) = self.ast.native_cursor_types.get(&id) {
+                    pending.extend([iterators::SomeId::Type(declared.ctype), iterators::SomeId::Type(builtin.ctype)]);
+                }
+                if let CDeclKind::Function { typ, ref parameters, .. } = self.ast[id].kind {
+                    pending.push(iterators::SomeId::Type(typ));
+                    pending.extend(parameters.iter().map(|p| iterators::SomeId::Decl(*p)));
+                    continue;
+                }
+            }
+            pending.extend(iterators::report_children(self.ast, node).1);
+        }
+
+        let (expression_views, qualified_types) = self.finalize_expression_views();
+        let expressions: Vec<_> = expressions.into_iter().map(|id| expression_views[&id].clone()).collect();
+        let statements: Vec<_> = statements.into_iter().map(|id| self.statements[&id].clone()).collect();
+        let variables: Vec<_> = declarations.into_iter().map(|id| self.variables[&id].clone()).collect();
+        let native_record_identities: Vec<_> = variables.iter().filter(|row| row["native_va_list_record"] == true)
+            .map(|row| json!({"declaration": row["id"], "identity": row["identity"]})).collect();
+        let selected: HashSet<_> = expressions.iter().filter_map(|e| e["id"].as_u64()).collect();
+        let unsupported_expressions: Vec<_> = self.expressions.iter().filter(|(_, row)| row["kind"] == "unsupported").map(|(id, row)| {
+            json!({"expression": id.0, "native_shape": row["native_shape"], "type": expression_views[id]["type"],
+                "within_slice": selected.contains(&id.0), "location": row["location"],
+                "relevance": {"state": "Unproved", "reason": if selected.contains(&id.0) {
+                    "selected unsupported expression retains its complete structural children"
+                } else { "outside selected slice; influence on formatting, control and effects is not established" }}})
+        }).collect();
+        let cursor_events: Vec<_> = expressions.iter().filter(|e| e["kind"] == "call").map(|e| {
+            json!({"expression": e["id"], "builtin": e["builtin"], "callee_declaration": e["callee_decl"],
+                "operands": e["arguments"], "relation": {"state": "Unproved", "reason": "cursor state, forwarding, lifetime and repeated-use closure pending"}})
+        }).collect();
+        json!({"schema": 2, "authorization": "analysis_only", "status": "CompleteReport", "unit": unit,
+            "target": self.ast.target, "target_c_widths_bits": inventory["target_c_widths_bits"],
+            "definitions": definitions, "function_edges": function_edges, "declarations": inventory["declarations"], "calls": calls,
+            "unclassified_definitions": unclassified, "expressions": expressions, "statements": statements,
+            "variables": variables, "types": type_rows.into_values().collect::<Vec<_>>(), "cursor_events": cursor_events,
+            "native_record_identities": native_record_identities,
+            "unsupported_expression_count": unsupported_expressions.len(), "unsupported_expressions": unsupported_expressions,
+            "graph": {"declaration_order": self.order.iter().map(|id| id.0).collect::<Vec<_>>(),
+                "expressions": self.expressions.values().collect::<Vec<_>>(), "statements": self.statements.values().collect::<Vec<_>>(),
+                "declarations": self.variables.values().collect::<Vec<_>>(), "types": self.types.values().collect::<Vec<_>>(),
+                "qualified_types": qualified_types},
+            "native_inputs": self.ast.cursor_inputs.as_ref().map(|s| serde_json::from_str::<Value>(s).expect("native inputs")),
+            "lowering": "not_authorized", "abi_execution": "Linux_x64_only_unrun"})
+    }
+}
+
+
+impl TypedAstContext {
+    fn inventory_type(&self, typ: CQualTypeId, depth: usize) -> Value {
+        self.evidence_type(typ, depth, false)
+    }
+
+    fn cursor_type(&self, typ: CQualTypeId, depth: usize) -> Value {
+        self.evidence_type(typ, depth, true)
+    }
+
+    fn evidence_type(&self, typ: CQualTypeId, depth: usize, cursor: bool) -> Value {
+        if depth > 32 {
+            return json!({"unproved": "type depth limit"});
+        }
+        let mut canonical_type = typ.ctype;
+        let mut qualifiers = typ.qualifiers;
+        let mut visited = HashSet::new();
+        for _ in 0..32 {
+            if !visited.insert(canonical_type) {
+                return json!({"unproved": "typedef or wrapper cycle"});
+            }
+            canonical_type = match self[canonical_type].kind {
+                CTypeKind::Typedef(id) => {
+                    let Some(original) = self.source_typedef_types.get(&id) else {
+                        return json!({"unproved": "missing original typedef"});
+                    };
+                    qualifiers = qualifiers.and(original.qualifiers);
+                    original.ctype
+                }
+                CTypeKind::TypeOf(id)
+                | CTypeKind::Paren(id)
+                | CTypeKind::Elaborated(id)
+                | CTypeKind::Decayed(id)
+                | CTypeKind::Auto(id) => id,
+                CTypeKind::Attributed(_, _) => return json!({"unproved": "attributed type facts"}),
+                _ => break,
+            };
+        }
+        let kind = &self[canonical_type].kind;
+        let canonical = match kind {
+            CTypeKind::Pointer(inner) => json!({"pointer": self.evidence_type(*inner, depth + 1, cursor)}),
+            CTypeKind::Function(ret, args, variadic, noreturn, prototype, abi) => json!({
+                "return": self.evidence_type(*ret, depth + 1, cursor),
+                "parameters": args.iter().map(|t| self.evidence_type(*t, depth + 1, cursor)).collect::<Vec<_>>(),
+                "variadic": variadic, "noreturn": noreturn, "prototype": prototype, "abi": abi.as_str()
+            }),
+            CTypeKind::Struct(id) | CTypeKind::Union(id) | CTypeKind::Enum(id) => {
+                if cursor && self.native_va_list_records.contains(id) {
+                    json!({"native_va_list_record": id.0})
+                } else {
+                    json!({"record": self.inventory_record_identity(*id, 0)})
+                }
+            }
+            CTypeKind::ConstantArray(_, _) | CTypeKind::IncompleteArray(_) => {
+                let Some(element) = self.source_array_elements.get(&canonical_type) else {
+                    return json!({"unproved": "missing original qualified array element"});
+                };
+                let mut array = json!({"array": self.evidence_type(*element, depth + 1, cursor)});
+                if let CTypeKind::ConstantArray(_, len) = kind {
+                    array["length"] = json!(len);
+                }
+                array
+            }
+            CTypeKind::Char => match self.source_char_signedness.get(&canonical_type) {
+                Some(signed) => json!({"kind": "Char", "signed": signed}),
+                None => json!({"unproved": "missing plain char signedness"}),
+            },
+            CTypeKind::LongDouble => json!({"unproved": "long double ABI shape"}),
+            CTypeKind::Void
+            | CTypeKind::Bool
+            | CTypeKind::SChar
+            | CTypeKind::Short
+            | CTypeKind::Int
+            | CTypeKind::Long
+            | CTypeKind::LongLong
+            | CTypeKind::UChar
+            | CTypeKind::UShort
+            | CTypeKind::UInt
+            | CTypeKind::ULong
+            | CTypeKind::ULongLong
+            | CTypeKind::Float
+            | CTypeKind::Double
+            | CTypeKind::Int128
+            | CTypeKind::UInt128
+            | CTypeKind::Half => json!({"kind": format!("{kind:?}")}),
+            _ => json!({"unproved": "unsupported type or wrapper limit"}),
+        };
+        json!({"canonical": canonical, "const": qualifiers.is_const, "volatile": qualifiers.is_volatile, "restrict": qualifiers.is_restrict})
+    }
+
+    fn inventory_record_identity(&self, id: CDeclId, depth: usize) -> Value {
+        fn identity(e: &c2rust_ast_exporter::clang_ast::RecordEvidence, depth: usize) -> Value {
+            if depth > 32
+                || e.0 != 2
+                || e.8
+                || e.3.is_empty()
+                || e.3 == "?"
+                || !Path::new(&e.3).is_absolute()
+                || e.4 == 0
+                || e.5 == 0
+            {
+                return json!({"unproved": "physical record location or macro declaration"});
+            }
+            let scope = match (e.6.as_str(), &e.7) {
+                ("file", None) => json!({"file": true}),
+                ("record", Some(owner)) => json!({"record": identity(owner, depth + 1)}),
+                _ => return json!({"unproved": "record owning scope"}),
+            };
+            json!({"kind": e.1, "tag": e.2,
+                "physical": {"path": e.3, "line": e.4, "column": e.5}, "scope": scope})
+        }
+        self.record_evidence
+            .get(&id)
+            .map(|e| identity(e, depth))
+            .unwrap_or_else(|| json!({"unproved": "missing physical record evidence"}))
+    }
+
+    fn inventory_symbol(&self, id: CDeclId, unit: &Path) -> Option<Value> {
+        if let CDeclKind::Function {
+            name, is_global, ..
+        } = &self[id].kind
+        {
+            Some(if *is_global {
+                json!({"linker": self.linker_names.get(&id).expect("missing Clang function linker identity")})
+            } else {
+                json!({"unit": unit, "static": name})
+            })
+        } else {
+            None
+        }
+    }
+
+    fn inventory_callee(&self, mut expr: CExprId) -> Option<CDeclId> {
+        loop {
+            match self[expr].kind {
+                CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => {
+                    expr = inner
+                }
+                CExprKind::DeclRef(_, id, _) => {
+                    return self.inventory_symbol(id, &self.main_file).map(|_| id);
+                }
+                _ => return None,
+            }
+        }
+    }
+
+    fn cursor_operand(&self, mut id: CExprId) -> Value {
+        let original = id;
+        loop {
+            match &self[id].kind {
+                CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => id = *inner,
+                _ => break,
+            }
+        }
+        json!({"id": original.0,
+            "direct_decl": match self[id].kind { CExprKind::DeclRef(_, d, _) => Some(d.0), _ => None },
+            "literal": match &self[id].kind { CExprKind::Literal(_, CLiteral::String(bytes, 1)) => Some(bytes), _ => None },
+            "type": self[original].kind.get_qual_type().map(|t| self.cursor_type(t, 0)),
+            "references": iterators::DFExpr::new(self, original.into()).filter_map(|n| n.expr())
+                .filter_map(|e| match self[e].kind { CExprKind::DeclRef(_, d, _) => Some(json!({"id": e.0, "decl": d.0})), _ => None }).collect::<Vec<_>>()})
+    }
+
+    fn cursor_declaration_owners(&self) -> HashMap<CDeclId, HashSet<CDeclId>> {
+        let mut owners: HashMap<CDeclId, HashSet<CDeclId>> = HashMap::new();
+        for (owner, decl) in self.iter_decls() {
+            match &decl.kind {
+                CDeclKind::Function { body: Some(body), .. } => {
+                    let mut pending = vec![iterators::SomeId::Stmt(*body)];
+                    let mut visited = HashSet::new();
+                    while let Some(node) = pending.pop() {
+                        if !visited.insert(node) { continue; }
+                        if let Some(stmt) = node.stmt().and_then(|id| self.c_stmts.get(&id)) {
+                            if let CStmtKind::Decls(decls) = &stmt.kind {
+                                for id in decls {
+                                    if self.native_local_variables.contains(id)
+                                        && matches!(self.c_decls.get(id).map(|d| &d.kind), Some(CDeclKind::Variable { .. })) {
+                                        owners.entry(*id).or_default().insert(*owner);
+                                    }
+                                }
+                            }
+                        }
+                        if node.type_().is_some() { continue; }
+                        if let Some(id) = node.decl() {
+                            if !matches!(self.c_decls.get(&id).map(|d| &d.kind), Some(CDeclKind::Variable { .. })) { continue; }
+                        }
+                        pending.extend(iterators::immediate_children_all_types(self, node)
+                            .into_iter().filter(|child| child.type_().is_none()));
+                    }
+                }
+                CDeclKind::Enum { variants, .. } => {
+                    for id in variants {
+                        if matches!(self.c_decls.get(id).map(|d| &d.kind), Some(CDeclKind::EnumConstant { .. })) {
+                            owners.entry(*id).or_default().insert(*owner);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        owners
+    }
+
+    fn cursor_declaration(&self, id: CDeclId, owners: &HashMap<CDeclId, HashSet<CDeclId>>) -> Value {
+        let mut value = json!({"id": id.0});
+        match &self[id].kind {
+            CDeclKind::Variable { ident, typ, initializer, has_static_duration, has_thread_duration, is_externally_visible, .. } => {
+                value["kind"] = json!("variable");
+                value["name"] = json!(ident);
+                value["local"] = json!(self.native_local_variables.contains(&id));
+                value["owning_function"] = if self.native_local_variables.contains(&id) {
+                    match owners.get(&id) {
+                        Some(ids) if ids.len() == 1 => json!(ids.iter().next().unwrap().0),
+                        _ => json!({"unproved": "missing or ambiguous lexical function owner"}),
+                    }
+                } else { Value::Null };
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["initializer"] = json!(initializer.map(|e| e.0));
+                value["static"] = json!(has_static_duration);
+                value["thread"] = json!(has_thread_duration);
+                value["externally_visible"] = json!(is_externally_visible);
+                value["native_va_list"] = self.native_cursor_types.get(&id).map(|(declared, builtin, kind)|
+                    json!({"same_canonical_type": true, "declared_type_id": declared.ctype.0,
+                        "builtin_type_id": builtin.ctype.0,
+                        "declared_canonical_type": self.cursor_type(*declared, 0),
+                        "builtin_canonical_type": self.cursor_type(*builtin, 0),
+                        "declared_const": declared.qualifiers.is_const,
+                        "declared_volatile": declared.qualifiers.is_volatile, "declared_restrict": declared.qualifiers.is_restrict,
+                        "builtin_const": builtin.qualifiers.is_const, "builtin_volatile": builtin.qualifiers.is_volatile,
+                        "builtin_restrict": builtin.qualifiers.is_restrict, "target_kind": kind})).unwrap_or(Value::Null);
+            }
+            CDeclKind::Field { name, typ, .. } => {
+                value["kind"] = json!("field"); value["name"] = json!(name);
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["owners"] = json!(self.iter_decls().filter_map(|(owner, d)| match &d.kind {
+                    CDeclKind::Struct { fields: Some(fields), .. } | CDeclKind::Union { fields: Some(fields), .. }
+                        if fields.contains(&id) => Some(self.inventory_record_identity(*owner, 0)),
+                    _ => None,
+                }).collect::<Vec<_>>());
+            }
+            CDeclKind::EnumConstant { name, value: number } => {
+                value["kind"] = json!("enum_constant"); value["name"] = json!(name);
+                value["owning_enum"] = match owners.get(&id) {
+                    Some(ids) if ids.len() == 1 => {
+                        let owner = *ids.iter().next().unwrap();
+                        json!({"declaration": owner.0, "identity": self.inventory_record_identity(owner, 0)})
+                    }
+                    _ => json!({"unproved": "missing or ambiguous enum variant owner"}),
+                };
+                value["value"] = match number { ConstIntExpr::I(n) => json!(n), ConstIntExpr::U(n) => json!(n) };
+            }
+            _ => value["kind"] = json!("unsupported"),
+        }
+        value
+    }
+
+    fn cursor_expression(&self, id: CExprId) -> Value {
+        let mut value = json!({"id": id.0, "kind": "unsupported",
+            "type": self[id].kind.get_qual_type().map(|t| self.cursor_type(t, 0)),
+            "type_id": self[id].kind.get_qual_type().map(|t| t.ctype.0),
+            "children": []});
+        match &self[id].kind {
+            CExprKind::Literal(_, literal) => {
+                value["kind"] = json!("literal");
+                value["literal"] = match literal {
+                    CLiteral::Integer(n, _) => json!({"integer": n}),
+                    CLiteral::Character(n) => json!({"character": n}),
+                    CLiteral::String(bytes, width) => json!({"bytes": bytes, "width": width}),
+                    _ => json!({"unsupported": true}),
+                };
+            }
+            CExprKind::DeclRef(_, decl, _) => {
+                value["kind"] = json!("reference"); value["decl"] = json!(decl.0);
+            }
+            CExprKind::Paren(_, child) => {
+                value["kind"] = json!("paren"); value["children"] = json!([child.0]);
+            }
+            CExprKind::ImplicitCast(_, child, cast, field, _) |
+            CExprKind::ExplicitCast(_, child, cast, field, _) => {
+                value["kind"] = json!(if matches!(self[id].kind, CExprKind::ImplicitCast(..)) { "implicit_cast" } else { "explicit_cast" });
+                value["children"] = json!([child.0]); value["cast"] = json!(format!("{:?}", cast));
+                value["field"] = json!(field.map(|f| f.0));
+            }
+            CExprKind::Unary(_, op, child, _) => {
+                value["kind"] = json!("unary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([child.0]);
+            }
+            CExprKind::UnaryType(_, op, child, argument_type) => {
+                value["kind"] = json!("unary_type"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!(child.iter().map(|c| c.0).collect::<Vec<_>>());
+                value["argument_type"] = self.cursor_type(*argument_type, 0);
+            }
+            CExprKind::Binary(_, op, left, right, lhs_type, rhs_type) => {
+                value["kind"] = json!("binary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([left.0, right.0]);
+                value["computation_types"] = json!([lhs_type.map(|t| self.cursor_type(t, 0)), rhs_type.map(|t| self.cursor_type(t, 0))]);
+            }
+            CExprKind::Call(_, callee, args) => {
+                let decl = self.inventory_callee(*callee);
+                value["kind"] = json!("call");
+                value["children"] = json!(std::iter::once(callee.0).chain(args.iter().map(|a| a.0)).collect::<Vec<_>>());
+                value["callee_decl"] = json!(decl.map(|d| d.0));
+                value["builtin"] = json!(decl.and_then(|d| self.cursor_builtin_identity.get(&d)));
+                value["arguments"] = json!(args.iter().map(|a| self.cursor_operand(*a)).collect::<Vec<_>>());
+            }
+            CExprKind::Member(_, parent, member, kind, _) => {
+                value["kind"] = json!("member"); value["children"] = json!([parent.0]);
+                value["member"] = self.cursor_declaration(*member, &HashMap::new());
+                value["access"] = json!(format!("{:?}", kind));
+            }
+            CExprKind::ArraySubscript(_, base, index, _) => {
+                value["kind"] = json!("subscript"); value["children"] = json!([base.0, index.0]);
+            }
+            _ => {}
+        }
+        value
+    }
+
+    fn required_qualified_type(typ: CQualTypeId) -> Value {
+        json!({"type_id": typ.ctype.0, "const": typ.qualifiers.is_const,
+            "volatile": typ.qualifiers.is_volatile, "restrict": typ.qualifiers.is_restrict})
+    }
+
+    fn required_type_relation(&self, id: CTypeId) -> (Value, Vec<CTypeId>) {
+        let mut row = json!({"type_id": id.0});
+        let mut children = vec![];
+        match self.c_types.get(&id).map(|t| &t.kind) {
+            Some(CTypeKind::Typedef(decl)) => {
+                row["kind"] = json!("typedef"); row["declaration"] = json!(decl.0);
+                match (self.c_decls.get(decl).map(|d| &d.kind), self.source_typedef_types.get(decl)) {
+                    (Some(CDeclKind::Typedef { .. }), Some(original)) => {
+                        row["original"] = Self::required_qualified_type(*original); children.push(original.ctype);
+                    }
+                    _ => row["unproved"] = json!("missing original typedef declaration or type"),
+                }
+            }
+            Some(CTypeKind::Elaborated(inner)) | Some(CTypeKind::Paren(inner)) |
+            Some(CTypeKind::TypeOf(inner)) | Some(CTypeKind::Decayed(inner)) | Some(CTypeKind::Auto(inner)) => {
+                row["kind"] = json!(match &self[id].kind {
+                    CTypeKind::Elaborated(_) => "elaborated", CTypeKind::Paren(_) => "paren",
+                    CTypeKind::TypeOf(_) => "typeof", CTypeKind::Decayed(_) => "decayed", _ => "auto",
+                });
+                row["inner"] = json!(inner.0); children.push(*inner);
+            }
+            Some(CTypeKind::ConstantArray(element, _)) | Some(CTypeKind::IncompleteArray(element)) => {
+                row["kind"] = json!("array");
+                row["length"] = match &self[id].kind { CTypeKind::ConstantArray(_, n) => json!(n), _ => Value::Null };
+                match self.source_array_elements.get(&id) {
+                    Some(original) if original.ctype == *element => {
+                        row["element"] = Self::required_qualified_type(*original); children.push(original.ctype);
+                    }
+                    _ => row["unproved"] = json!("missing or inconsistent qualified array element"),
+                }
+            }
+            Some(CTypeKind::Pointer(inner)) => {
+                row["kind"] = json!("pointer"); row["pointee"] = Self::required_qualified_type(*inner);
+                children.push(inner.ctype);
+            }
+            Some(CTypeKind::Function(ret, args, variadic, noreturn, prototype, abi)) => {
+                row["kind"] = json!("function"); row["return"] = Self::required_qualified_type(*ret);
+                row["parameters"] = json!(args.iter().map(|t| Self::required_qualified_type(*t)).collect::<Vec<_>>());
+                row["variadic"] = json!(variadic); row["noreturn"] = json!(noreturn);
+                row["prototype"] = json!(prototype); row["abi"] = json!(abi.as_str());
+                children.push(ret.ctype); children.extend(args.iter().map(|t| t.ctype));
+            }
+            Some(CTypeKind::Struct(decl)) | Some(CTypeKind::Union(decl)) | Some(CTypeKind::Enum(decl)) => {
+                row["kind"] = json!(match &self[id].kind { CTypeKind::Struct(_) => "struct", CTypeKind::Union(_) => "union", _ => "enum" });
+                row["declaration"] = json!(decl.0);
+                let matching = matches!((&self[id].kind, self.c_decls.get(decl).map(|d| &d.kind)),
+                    (CTypeKind::Struct(_), Some(CDeclKind::Struct { .. })) |
+                    (CTypeKind::Union(_), Some(CDeclKind::Union { .. })) |
+                    (CTypeKind::Enum(_), Some(CDeclKind::Enum { .. })));
+                if !matching { row["unproved"] = json!("missing or inconsistent record declaration"); }
+            }
+            Some(CTypeKind::BuiltinFn) => {
+                row["kind"] = json!("builtin_function");
+                row["unproved"] = json!("BuiltinFn requires a native endpoint relation");
+            }
+            Some(kind @ (CTypeKind::Void | CTypeKind::Bool | CTypeKind::SChar | CTypeKind::UChar |
+                CTypeKind::Short | CTypeKind::UShort | CTypeKind::Int | CTypeKind::UInt |
+                CTypeKind::Long | CTypeKind::ULong | CTypeKind::LongLong | CTypeKind::ULongLong |
+                CTypeKind::Float | CTypeKind::Double | CTypeKind::Int128 | CTypeKind::UInt128 | CTypeKind::Half)) => {
+                row["kind"] = json!(format!("{kind:?}"));
+            }
+            Some(CTypeKind::Char) => {
+                row["kind"] = json!("Char");
+                match self.source_char_signedness.get(&id) {
+                    Some(signed) => row["signed"] = json!(signed),
+                    None => row["unproved"] = json!("missing plain char signedness"),
+                }
+            }
+            _ => row["unproved"] = json!("missing or unsupported required type"),
+        }
+        (row, children)
+    }
+
+    fn required_type_closure(&self, id: CTypeId,
+        rows: &mut std::collections::BTreeMap<CTypeId, (Value, Vec<CTypeId>)>,
+        visiting: &mut HashSet<CTypeId>, checked: &mut HashMap<(CTypeId, usize), bool>, depth: usize) -> bool {
+        if depth > 32 || visiting.contains(&id) { return false; }
+        if let Some(proved) = checked.get(&(id, depth)) { return *proved; }
+        let (row, children) = rows.entry(id).or_insert_with(|| self.required_type_relation(id));
+        let mut proved = row.get("unproved").is_none();
+        let children = children.clone();
+        visiting.insert(id);
+        for child in children {
+            if !self.required_type_closure(child, rows, visiting, checked, depth + 1) { proved = false; }
+        }
+        visiting.remove(&id);
+        checked.insert((id, depth), proved);
+        proved
+    }
+
+    fn required_native_record(&self, id: CDeclId) -> Value {
+        let mut row = json!({"declaration": id.0});
+        match (self.native_va_list_records.contains(&id), self.c_decls.get(&id).map(|d| &d.kind), self.record_evidence.get(&id)) {
+            (true, Some(CDeclKind::Struct { fields: Some(_), platform_byte_size, platform_alignment,
+                is_packed, manual_alignment, max_field_alignment, .. }), Some(e))
+                if e.0 == 2 && e.1 == "struct" && e.9 && e.10 == Some((*is_packed, *manual_alignment,
+                    *max_field_alignment, *platform_byte_size, *platform_alignment)) => {
+                row["origin"] = json!("ASTContext.getVaListTagDecl"); row["kind"] = json!("struct");
+                row["complete"] = json!(true); row["size"] = json!(platform_byte_size);
+                row["alignment"] = json!(platform_alignment);
+            }
+            _ => row["unproved"] = json!("missing or inconsistent native va_list tag origin and layout"),
+        }
+        row
+    }
+
+    fn cursor_required_relations(&self, unit: &Path, owners: &HashMap<CDeclId, HashSet<CDeclId>>) -> Value {
+        let mut roots = HashSet::new();
+        let mut expressions = std::collections::BTreeSet::new();
+        let mut declarations = std::collections::BTreeSet::new();
+        for (id, decl) in self.iter_decls() {
+            let CDeclKind::Function { typ, body: Some(body), parameters, .. } = &decl.kind else { continue };
+            if !matches!(self.c_types.get(typ).map(|t| &t.kind), Some(CTypeKind::Function(_, _, true, _, _, _))) { continue; }
+            roots.insert(CQualTypeId::new(*typ)); declarations.insert(*id);
+            declarations.extend(parameters.iter().copied());
+            let mut pending = vec![iterators::SomeId::Stmt(*body)];
+            let mut visited = HashSet::new();
+            while let Some(node) = pending.pop() {
+                if !visited.insert(node) || node.type_().is_some() { continue; }
+                if let Some(expr) = node.expr() { expressions.insert(expr); }
+                if let Some(decl) = node.decl() {
+                    if !matches!(self.c_decls.get(&decl).map(|d| &d.kind), Some(CDeclKind::Variable { .. })) { continue; }
+                    declarations.insert(decl);
+                }
+                pending.extend(iterators::immediate_children_all_types(self, node)
+                    .into_iter().filter(|child| child.type_().is_none()));
+            }
+        }
+        let mut builtin_ids = std::collections::BTreeSet::new();
+        let mut endpoints = vec![];
+        for id in &expressions {
+            let Some(expr) = self.c_exprs.get(id) else { continue };
+            if let Some(typ) = expr.kind.get_qual_type() { roots.insert(typ); }
+            match &expr.kind {
+                CExprKind::DeclRef(_, decl, _) => { declarations.insert(*decl); }
+                CExprKind::UnaryType(_, _, _, typ) => { roots.insert(*typ); }
+                CExprKind::Binary(_, _, _, _, left, right) => { roots.extend(left.iter().chain(right.iter()).copied()); }
+                _ => {}
+            }
+            if let CExprKind::Call(_, callee, _) = expr.kind {
+                if let Some(decl) = self.inventory_callee(callee) { builtin_ids.insert(decl); }
+            }
+            if let CExprKind::ImplicitCast(output, child, CastKind::BuiltinFnToFnPtr, _, _) = expr.kind {
+                let Some(CExprKind::DeclRef(input, decl, _)) = self.c_exprs.get(&child).map(|e| &e.kind) else {
+                    endpoints.push(json!({"expression": id.0, "unproved": "BuiltinFn cast input is not a direct declaration reference"}));
+                    continue;
+                };
+                let mut endpoint = json!({"expression": id.0, "reference": child.0, "declaration": decl.0, "cast": "BuiltinFnToFnPtr",
+                    "input": Self::required_qualified_type(*input), "output": Self::required_qualified_type(output)});
+                if !matches!(self.c_types.get(&input.ctype).map(|t| &t.kind), Some(CTypeKind::BuiltinFn)) {
+                    endpoint["unproved"] = json!("native endpoint input is not BuiltinFn");
+                }
+                builtin_ids.insert(*decl); endpoints.push(endpoint);
+            }
+        }
+        let mut cursors = vec![];
+        let mut selected: std::collections::BTreeMap<CDeclId, Vec<Value>> = std::collections::BTreeMap::new();
+        let mut enum_owners = vec![];
+        for id in &declarations {
+            match self.c_decls.get(id).map(|d| &d.kind) {
+                Some(CDeclKind::Variable { typ, .. }) | Some(CDeclKind::Field { typ, .. }) => { roots.insert(*typ); }
+                Some(CDeclKind::Function { typ, .. }) => { roots.insert(CQualTypeId::new(*typ)); }
+                Some(CDeclKind::EnumConstant { name, value }) => {
+                    match owners.get(id) {
+                        Some(ids) if ids.len() == 1 => {
+                            let owner = *ids.iter().next().unwrap();
+                            let member = match self.c_decls.get(&owner).map(|d| &d.kind) {
+                                Some(CDeclKind::Enum { variants, .. }) => variants.iter().filter(|d| *d == id).count() == 1,
+                                _ => false,
+                            };
+                            if member {
+                                let variant = match value {
+                                    ConstIntExpr::I(n) => json!({"declaration": id.0, "name": name, "signed": true, "value": n}),
+                                    ConstIntExpr::U(n) => json!({"declaration": id.0, "name": name, "signed": false, "value": n}),
+                                };
+                                selected.entry(owner).or_default().push(variant);
+                            } else { enum_owners.push(json!({"variant": id.0, "unproved": "missing or duplicate enum membership"})); }
+                        }
+                        _ => enum_owners.push(json!({"variant": id.0, "unproved": "missing or ambiguous enum owner"})),
+                    }
+                }
+                _ => {}
+            }
+            if let Some((declared, builtin, kind)) = self.native_cursor_types.get(id) {
+                roots.insert(*declared); roots.insert(*builtin);
+                let source = match self.c_decls.get(id).map(|d| &d.kind) {
+                    Some(CDeclKind::Variable { typ, .. }) => Self::required_qualified_type(*typ),
+                    _ => json!({"unproved": "native cursor is not a variable"}),
+                };
+                cursors.push(json!({"declaration": id.0, "source": source,
+                    "declared": Self::required_qualified_type(*declared), "builtin": Self::required_qualified_type(*builtin),
+                    "same_canonical_type": true, "target_kind": kind}));
+            }
+        }
+        for (owner, variants) in selected {
+            enum_owners.push(json!({"declaration": owner.0, "identity": self.inventory_record_identity(owner, 0), "variants": variants}));
+        }
+        enum_owners.sort_by_key(|v| (v["declaration"].as_u64(), v["variant"].as_u64()));
+        let mut builtins = vec![];
+        for id in builtin_ids {
+            let Some((builtin, semantic)) = self.cursor_builtin_identity.get(&id) else { continue };
+            if !matches!(semantic.as_str(), "va_start" | "va_end" | "va_copy" | "vsnprintf") { continue; }
+            let mut row = json!({"declaration": id.0, "builtin_id": builtin, "semantic": semantic});
+            match self.c_decls.get(&id).map(|d| &d.kind) {
+                Some(CDeclKind::Function { typ, name, is_global: true, .. }) if *builtin != 0 && self.linker_names.contains_key(&id) => {
+                    row["name"] = json!(name); row["symbol"] = self.inventory_symbol(id, unit).unwrap_or(Value::Null);
+                    row["type"] = Self::required_qualified_type(CQualTypeId::new(*typ)); roots.insert(CQualTypeId::new(*typ));
+                }
+                _ => row["unproved"] = json!("missing native builtin declaration or linker identity"),
+            }
+            builtins.push(row);
+        }
+        let mut types = std::collections::BTreeMap::new();
+        let mut ordered_roots: Vec<_> = roots.into_iter().collect();
+        ordered_roots.sort_by_key(|t| (t.ctype.0, t.qualifiers.is_const, t.qualifiers.is_volatile, t.qualifiers.is_restrict));
+        let mut root_facts = vec![];
+        let mut root_proved = HashMap::new();
+        for root in &ordered_roots {
+            let proved = self.required_type_closure(root.ctype, &mut types, &mut HashSet::new(), &mut HashMap::new(), 0);
+            root_proved.insert(root.ctype, proved);
+            let mut fact = Self::required_qualified_type(*root);
+            if !proved { fact["unproved"] = json!("required type dependency, cycle or depth limit"); }
+            root_facts.push(fact);
+        }
+        let mut native_ids = std::collections::BTreeSet::new();
+        for id in types.keys() {
+            if let Some(CTypeKind::Struct(decl)) = self.c_types.get(id).map(|t| &t.kind) {
+                if self.native_va_list_records.contains(decl) { native_ids.insert(*decl); }
+            }
+        }
+        for row in &mut builtins {
+            if let Some(id) = row["type"]["type_id"].as_u64() {
+                if root_proved.get(&CTypeId(id)) == Some(&true) {
+                    row["signature"] = self.cursor_type(CQualTypeId::new(CTypeId(id)), 0);
+                } else { row["unproved"] = json!("native builtin signature relation unproved"); }
+            }
+        }
+        for endpoint in &mut endpoints {
+            let decl = endpoint["declaration"].as_u64();
+            let builtin = builtins.iter().find(|b| b["declaration"].as_u64() == decl && b.get("unproved").is_none());
+            let output = endpoint["output"]["type_id"].as_u64().map(CTypeId);
+            let signature = builtin.and_then(|b| b["type"]["type_id"].as_u64()).map(CTypeId);
+            let matching = match output.and_then(|id| self.c_types.get(&id)).map(|t| &t.kind) {
+                Some(CTypeKind::Pointer(inner)) => Some(inner.ctype) == signature,
+                _ => false,
+            };
+            if !matching || builtin.is_none() { endpoint["unproved"] = json!("native builtin endpoint signature mismatch"); }
+        }
+        json!({"schema": 1, "authorization": "witness_only",
+            "roots": root_facts,
+            "types": types.into_values().map(|(row, _)| row).collect::<Vec<_>>(), "cursors": cursors,
+            "native_records": native_ids.into_iter().map(|id| self.required_native_record(id)).collect::<Vec<_>>(),
+            "enum_owners": enum_owners, "builtin_declarations": builtins, "builtin_endpoints": endpoints})
+    }
+
+    /// A separate raw witness. Statement order comes only from the compound body.
+    pub fn cursor_witness(&self, unit: &Path) -> Value {
+        let owners = self.cursor_declaration_owners();
+        let mut functions = vec![];
+        for (id, decl) in self.iter_decls() {
+            let CDeclKind::Function { body: Some(body), parameters, typ, .. } = &decl.kind else { continue };
+            let variadic = matches!(self[*typ].kind, CTypeKind::Function(_, _, true, _, _, _));
+            if !variadic { continue; }
+            let cursors: Vec<_> = iterators::DFExpr::new(self, (*body).into()).filter_map(|n| n.decl())
+                .filter(|d| self.native_cursor_types.contains_key(d))
+                .collect();
+            let statements = match &self[*body].kind {
+                CStmtKind::Compound(children) => children.iter().map(|stmt| {
+                    let (kind, root) = match self[*stmt].kind {
+                        CStmtKind::Decls(..) => ("declarations", None),
+                        CStmtKind::Expr(expr) => ("expression", Some(expr.0)),
+                        CStmtKind::Empty => ("empty", None), _ => ("unsupported", None),
+                    };
+                    json!({"id": stmt.0, "kind": kind, "root": root,
+                        "declarations": match &self[*stmt].kind {
+                            CStmtKind::Decls(ds) => ds.iter().map(|d| self.cursor_declaration(*d, &owners)).collect::<Vec<_>>(), _ => vec![] },
+                        "expressions": iterators::DFExpr::new(self, (*stmt).into()).filter_map(|n| n.expr())
+                            .map(|e| self.cursor_expression(e)).collect::<Vec<_>>()})
+                }).collect::<Vec<_>>(), _ => vec![],
+            };
+            let references = self.c_exprs.iter().filter_map(|(e, node)| match node.kind {
+                CExprKind::DeclRef(_, d, _) if parameters.contains(&d) || cursors.contains(&d) => Some(json!({"id": e.0, "decl": d.0,
+                    "type": node.kind.get_qual_type().map(|t| self.cursor_type(t, 0))})), _ => None,
+            }).collect::<Vec<_>>();
+            functions.push(json!({"declaration": id.0, "symbol": self.inventory_symbol(*id, unit),
+                "body": body.0, "complete_body": matches!(self[*body].kind, CStmtKind::Compound(_)),
+                "parameters": parameters.iter().map(|p| p.0).collect::<Vec<_>>(),
+                "parameter_declarations": parameters.iter().map(|p| self.cursor_declaration(*p, &owners)).collect::<Vec<_>>(),
+                "signature": self.cursor_type(CQualTypeId::new(*typ), 0),
+                "last_fixed_parameter": parameters.last().map(|p| p.0),
+                "cursors": cursors.iter().map(|c| c.0).collect::<Vec<_>>(),
+                "statements": statements, "parameter_and_cursor_references": references,
+                "full_statement_ids": iterators::DFExpr::new(self, (*body).into()).filter_map(|n| n.stmt()).map(|s| s.0).collect::<Vec<_>>() }));
+        }
+        let calls = self.c_exprs.iter().filter(|(_, e)| matches!(e.kind, CExprKind::Call(..)))
+            .map(|(id, _)| self.cursor_expression(*id)).collect::<Vec<_>>();
+        json!({"schema": 2, "authorization": "witness_only", "unit": unit, "target": self.target,
+            "native_va_list_kind": self.va_list_kind as u64,
+            "functions": functions, "calls": calls,
+            "required_relations": self.cursor_required_relations(unit, &owners),
+            "native_va_list_records": self.native_va_list_records.iter().map(|id| id.0).collect::<Vec<_>>(),
+            "expressions": self.c_exprs.iter().map(|(id, _)| self.cursor_expression(*id)).collect::<Vec<_>>(),
+            "declarations": self.iter_decls().filter(|(_, d)| matches!(d.kind, CDeclKind::Variable { .. } | CDeclKind::EnumConstant { .. })).map(|(id, _)| self.cursor_declaration(*id, &owners)).collect::<Vec<_>>(),
+            "native_inputs": self.cursor_inputs.as_ref().map(|s| serde_json::from_str::<Value>(s).expect("native input facts JSON"))})
+    }
+
+    fn format_expression_shape(&self, id: CExprId) -> &'static str {
+        match self[id].kind {
+            CExprKind::Literal(..) => "Literal", CExprKind::Unary(..) => "Unary",
+            CExprKind::UnaryType(..) => "UnaryType", CExprKind::OffsetOf(..) => "OffsetOf",
+            CExprKind::Binary(..) => "Binary", CExprKind::ImplicitCast(..) => "ImplicitCast",
+            CExprKind::ExplicitCast(..) => "ExplicitCast", CExprKind::ConstantExpr(..) => "ConstantExpr",
+            CExprKind::DeclRef(..) => "DeclRef", CExprKind::Call(..) => "Call",
+            CExprKind::Member(..) => "Member", CExprKind::ArraySubscript(..) => "ArraySubscript",
+            CExprKind::Conditional(..) => "Conditional", CExprKind::BinaryConditional(..) => "BinaryConditional",
+            CExprKind::InitList(..) => "InitList", CExprKind::ImplicitValueInit(..) => "ImplicitValueInit",
+            CExprKind::Paren(..) => "Paren", CExprKind::CompoundLiteral(..) => "CompoundLiteral",
+            CExprKind::ImaginaryLiteral(..) => "ImaginaryLiteral", CExprKind::Predefined(..) => "Predefined",
+            CExprKind::Statements(..) => "Statements", CExprKind::VAArg(..) => "VAArg",
+            CExprKind::ShuffleVector(..) => "ShuffleVector", CExprKind::ConvertVector(..) => "ConvertVector",
+            CExprKind::DesignatedInitExpr(..) => "DesignatedInitExpr", CExprKind::Choose(..) => "Choose",
+            CExprKind::Atomic { .. } => "Atomic", CExprKind::BadExpr => "BadExpr",
+        }
+    }
+
+    fn format_origin(&self, id: CExprId, depth: usize) -> Value {
+        if depth > 64 { return json!({"kind": "Unproved", "reason": "format expression depth limit", "expression": id.0}); }
+        match &self[id].kind {
+            CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) =>
+                json!({"kind": "Wrapper", "expression": id.0, "inner": self.format_origin(*inner, depth + 1)}),
+            CExprKind::Literal(_, CLiteral::String(bytes, 1)) =>
+                json!({"kind": "Literal", "expression": id.0, "bytes": bytes,
+                    "consumption": Self::format_consumption(bytes)}),
+            CExprKind::Conditional(_, condition, yes, no) => json!({"kind": "Conditional", "expression": id.0,
+                "condition": condition.0, "true": self.format_origin(*yes, depth + 1), "false": self.format_origin(*no, depth + 1)}),
+            CExprKind::DeclRef(_, decl, _) => json!({"kind": "Declaration", "expression": id.0,
+                "declaration": decl.0, "relation": {"state": "Unproved", "reason": "forwarded parameter or stored producer ownership requires interprocedural closure"}}),
+            _ => json!({"kind": "Unproved", "expression": id.0,
+                "reason": "runtime producer/store/read/free and lifetime relation not established"}),
+        }
+    }
+
+    fn format_consumption(bytes: &[u8]) -> Value {
+        let mut i = 0;
+        let mut slot = 0;
+        let mut conversions = vec![];
+        while i < bytes.len() && bytes[i] != 0 {
+            if bytes[i] != b'%' { i += 1; continue; }
+            let start = i; i += 1;
+            if bytes.get(i) == Some(&b'%') { i += 1; continue; }
+            while bytes.get(i).map_or(false, |b| b"-+ #0'".contains(b)) { i += 1; }
+            let mut consumed = vec![];
+            for part in 0..2 {
+                if part == 1 {
+                    if bytes.get(i) != Some(&b'.') { break; }
+                    i += 1;
+                }
+                if bytes.get(i) == Some(&b'*') {
+                    consumed.push(json!({"slot": slot, "role": if part == 0 { "width" } else { "precision" }}));
+                    slot += 1; i += 1;
+                } else { while bytes.get(i).map_or(false, |b| b.is_ascii_digit()) { i += 1; } }
+                if bytes.get(i) == Some(&b'$') {
+                    return json!({"state": "Unproved", "reason": "positional syntax", "offset": i, "prefix": conversions});
+                }
+            }
+            let length_start = i;
+            if bytes.get(i).map_or(false, |b| b"hljztL".contains(b)) {
+                let first = bytes[i]; i += 1;
+                if (first == b'h' || first == b'l') && bytes.get(i) == Some(&first) { i += 1; }
+            }
+            let length = &bytes[length_start..i];
+            let Some(&conversion) = bytes.get(i) else {
+                return json!({"state": "Unproved", "reason": "incomplete conversion", "offset": start, "prefix": conversions});
+            };
+            if !b"diouxXfFeEgGaAcspn".contains(&conversion) {
+                return json!({"state": "Unproved", "reason": "unsupported conversion", "offset": i, "prefix": conversions});
+            }
+            consumed.push(json!({"slot": slot, "role": "value"})); slot += 1; i += 1;
+            conversions.push(json!({"begin": start, "end": i, "length": length, "conversion": conversion, "arguments": consumed}));
+        }
+        json!({"state": "Parsed", "arguments": slot, "conversions": conversions,
+            "type_compatibility": {"state": "Unproved", "reason": "specifier and canonical promoted argument relation not established"}})
+    }
+
+    pub fn closed_format_report(&self, unit: &Path) -> ClosedFormatReport {
+        ClosedFormatReport::capture(self, unit)
+    }
+
+    pub fn closed_variadic_inventory(&self, unit: &Path) -> Value {
+        ReportGraph::capture(self, unit).inventory()
+    }
+
