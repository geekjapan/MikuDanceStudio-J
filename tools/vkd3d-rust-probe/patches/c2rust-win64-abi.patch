diff --git a/tests/unit/builtins/src/stable_boundaries.c b/tests/unit/builtins/src/stable_boundaries.c
new file mode 100644
index 0000000..9edeecd
--- /dev/null
+++ b/tests/unit/builtins/src/stable_boundaries.c
@@ -0,0 +1,44 @@
+typedef unsigned int uint32_t;
+struct _IO_wide_data;
+struct _IO_codecvt;
+struct _IO_marker;
+struct __locale_data;
+struct opaque_pointers {
+    unsigned char tag;
+    struct _IO_wide_data *wide;
+    struct _IO_codecvt *codecvt;
+    struct _IO_marker *marker;
+    struct __locale_data *locale;
+};
+struct refcount { unsigned char tag; uint32_t count; };
+uint32_t stable_sync(uint32_t *x, uint32_t value) {
+    return __sync_add_and_fetch(x, value);
+}
+uint32_t stable_atomic(uint32_t *x, uint32_t value) {
+    return __atomic_add_fetch(x, value, __ATOMIC_SEQ_CST);
+}
+uint32_t stable_effects(uint32_t *x, uint32_t value, unsigned int *pc, unsigned int *vc) {
+    return __sync_add_and_fetch(((*pc)++, x), ((*vc)++, value));
+}
+unsigned long long stable_layout(unsigned int which) {
+    switch (which) {
+    case 0: return sizeof(struct opaque_pointers);
+    case 1: return _Alignof(struct opaque_pointers);
+    case 2: return __builtin_offsetof(struct opaque_pointers, wide);
+    case 3: return __builtin_offsetof(struct opaque_pointers, codecvt);
+    case 4: return __builtin_offsetof(struct opaque_pointers, marker);
+    case 5: return __builtin_offsetof(struct opaque_pointers, locale);
+    case 6: return sizeof(struct refcount);
+    case 7: return _Alignof(struct refcount);
+    case 8: return __builtin_offsetof(struct refcount, count);
+    case 9: return sizeof(uint32_t);
+    case 10: return _Alignof(uint32_t);
+    default: return 999;
+    }
+}
+void *stable_opaque_roundtrip(void *value) {
+    struct opaque_pointers p = {0};
+    p.wide = value; p.codecvt = (void *)p.wide;
+    p.marker = (void *)p.codecvt; p.locale = (void *)p.marker;
+    return p.locale;
+}
diff --git a/tests/unit/builtins/src/test_stable_boundaries.rs b/tests/unit/builtins/src/test_stable_boundaries.rs
new file mode 100644
index 0000000..b9acff5
--- /dev/null
+++ b/tests/unit/builtins/src/test_stable_boundaries.rs
@@ -0,0 +1,24 @@
+use crate::stable_boundaries::{rust_stable_sync, rust_stable_atomic};
+#[link(name = "test")]
+unsafe extern "C" {
+    fn stable_sync(x: *mut u32, value: u32) -> u32;
+    fn stable_atomic(x: *mut u32, value: u32) -> u32;
+}
+#[test]
+fn stable_add_fetch_wraps_and_decrements() {
+    for initial in [0u32, 1, u32::MAX - 1, u32::MAX] {
+        for delta in [0u32, 1, 2, u32::MAX] {
+            unsafe {
+                let mut native = initial;
+                let mut rust = initial;
+                let expected = initial.wrapping_add(delta);
+                assert_eq!(stable_sync(&mut native, delta), expected);
+                assert_eq!(rust_stable_sync(&mut rust, delta), expected);
+                assert_eq!(native, rust);
+                assert_eq!(stable_atomic(&mut native, delta), expected.wrapping_add(delta));
+                assert_eq!(rust_stable_atomic(&mut rust, delta), expected.wrapping_add(delta));
+                assert_eq!(native, rust);
+            }
+        }
+    }
+}
diff --git a/tests/unit/enums/src/constant_array.c b/tests/unit/enums/src/constant_array.c
new file mode 100644
index 0000000..5f2c6e8
--- /dev/null
+++ b/tests/unit/enums/src/constant_array.c
@@ -0,0 +1,22 @@
+enum operand_type { OPERAND_INTEGER = 40, OPERAND_LARGE = 0x80000000u };
+enum signed_type { SIGNED_NEGATIVE = -7, SIGNED_POSITIVE = 13 };
+typedef enum signed_type signed_alias;
+
+static const enum operand_type *operands = (enum operand_type[]){OPERAND_INTEGER, 0, (enum operand_type)3, OPERAND_LARGE};
+static const signed_alias *signed_values = (signed_alias[]){SIGNED_NEGATIVE, 0, SIGNED_POSITIVE, (signed_alias)-3};
+static const int *integers = (int[]){OPERAND_INTEGER, 0, SIGNED_NEGATIVE, (int)SIGNED_POSITIVE};
+
+long long enum_array_probe(unsigned which) {
+    if (which < 4) return operands[which];
+    if (which < 8) return signed_values[which - 4];
+    if (which < 12) return integers[which - 8];
+    switch (which) {
+    case 12: return sizeof(enum operand_type);
+    case 13: return __alignof__(enum operand_type);
+    case 14: return sizeof(signed_alias);
+    case 15: return __alignof__(signed_alias);
+    case 16: return sizeof((enum operand_type[]){OPERAND_INTEGER, 0, (enum operand_type)3, OPERAND_LARGE});
+    case 17: return sizeof((signed_alias[]){SIGNED_NEGATIVE, 0, SIGNED_POSITIVE, (signed_alias)-3});
+    default: return -999;
+    }
+}
