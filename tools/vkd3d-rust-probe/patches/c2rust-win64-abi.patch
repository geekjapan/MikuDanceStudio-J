+#[test]
+fn closed_variadic_plan_command_reorder_preserves_owned_plan() {
+    let mut units = vec![native("int target(int,...);", "a.c", &[]), native("int target(int n,...){return n;}", "b.c", &[])];
+    let p = ClosedVariadicPlan::capture(units.iter().map(|u| (&u.identity,&u.ast,u.sources.clone()))).unwrap();
+    units.reverse();
+    let q = plan(&mut units);
+    assert_eq!(p.report(), q.report());
+    for u in units { emit(&q,u); }
+}
