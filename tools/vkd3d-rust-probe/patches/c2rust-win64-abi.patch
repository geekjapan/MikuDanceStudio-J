+}
+
+#[test]
+fn closed_variadic_plan_target_width_mismatch_refuses_before_binding() {
+    let mut units=vec![native("int f(int,...);", "a.c",&[]),native("int f(int n,...){return n;}","b.c",&[])];
+    units[1].ast.target_c_widths[3] *= 2;
+    units[1].identity.widths=units[1].ast.target_c_widths;
+    assert!(ClosedVariadicPlan::capture(units.iter_mut().map(|u|(&u.identity,&u.ast,std::mem::take(&mut u.sources)))).is_err());
+}
+
+fn manual_unsupported_attributed_wrapper(mut unit: NativeUnit) -> NativeUnit {
+    let function=unit.ast.c_decls.iter().find_map(|(_,d)| if let CDeclKind::Function {typ,..}=d.kind {Some(typ)} else {None}).unwrap();
+    let wrapper=CTypeId(unit.ast.c_types.keys().map(|id|id.0).max().unwrap()+1);
+    unit.ast.c_types.insert(wrapper,not_located(CTypeKind::Attributed(CQualTypeId::new(function),Some(Attribute::NoReturn))));
+    for d in unit.ast.c_decls.values_mut() { if let CDeclKind::Function {typ,..}=&mut d.kind {*typ=wrapper;} }
+    unit
+}
+
+#[test]
+fn closed_variadic_plan_manual_unsupported_attributed_wrapper_is_blocked_at_binding() {
+    let mut units=vec![manual_unsupported_attributed_wrapper(native(
+        "int f(int n,...) __attribute__((ms_abi)); int f(int n,...){return n;}","attributed.c",&[]))];
+    let p=plan(&mut units);
+    assert!(reasons(&p,"f").contains(&Blocker::UnknownSignature));
+    assert!(p.units.values().flat_map(|u|u.declarations.values()).all(|f|!f.blockers.is_empty()));
+    let u=&units[0];
+    let bound=p.bind(&u.identity,&u.ast).unwrap();
+    bound.declaration(*p.units[&u.identity.key].declarations.keys().next().unwrap());
+}
+
+#[test]
+fn closed_variadic_plan_source_command_target_and_ast_mismatches_refuse() {
+    let mut units=vec![native("int f(int n,...){return n;}","binding.c",&[])];
+    let p=plan(&mut units); let u=&mut units[0];
+    for field in ["command","source","target","instance"] {
+        let mut wrong=u.identity.clone();
+        match field {"command"=>wrong.command.push('x'),"source"=>{wrong.source.set_extension("wrong");},
+            "target"=>wrong.target.push('x'),_=>wrong.ast_instance.push('x')}
+        assert!(p.bind(&wrong,&u.ast).is_err());
+    }
+    u.ast.plan_instance=Some("different native export".into());
+    assert!(p.bind(&u.identity,&u.ast).is_err());
+    u.ast.plan_instance=Some(u.identity.ast_instance.clone());
+    std::fs::write(&u.identity.source,"int changed;").unwrap();
+    assert!(p.bind(&u.identity,&u.ast).is_err());
+}
+
+#[test]
+fn closed_variadic_plan_missing_authentic_call_is_used_by_emitter() {
+    let mut units=vec![native("int f(int n,...){return n;} int g(void){return f(1,2);}","calls.c",&[])];
+    let mut p=plan(&mut units);
+    let key=units[0].identity.key.clone();
+    p.units.get_mut(&key).unwrap().calls.clear();
+    let u=units.pop().unwrap();
+    assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(||emit(&p,u))).is_err());
+}
+
+#[test]
+fn closed_variadic_plan_same_source_different_commands_have_distinct_keys() {
+    let unit=native("int f(void){return 1;}","flags.c",&[]);
+    let row=serde_json::json!({"directory":unit.directory.path(),"file":unit.identity.source,"arguments":["clang","-c","flags.c"]});
+    let (a,_,_,_)=command_identity(&row,&[],"link").unwrap();
+    let (b,_,_,_)=command_identity(&row,&["-DOTHER=1"],"link").unwrap();
+    assert_ne!(a,b);
+}
+
+#[test]
+fn closed_variadic_plan_pointee_qualifiers_are_compared_independently() {
+    let mut units=vec![native("int f(const int *,...);", "a.c",&[]),
+        native("int f(int *n,...){return *n;}","b.c",&[])];
+    let p=plan(&mut units);
+    assert!(reasons(&p,"f").contains(&Blocker::SignatureMismatch));
+    for u in units { emit(&p,u); }
+}
+
+#[test]
+fn closed_variadic_plan_same_source_native_commands_preserve_distinct_layouts() {
+    let first=native("#ifndef FIELD_TYPE\n#define FIELD_TYPE int\n#endif\nstruct same { FIELD_TYPE n; }; int f(struct same *n,...){return n->n;}\n", "layout.c",&[]);
+    let second=native_in(first.directory.clone(),first.identity.source.clone(),&["-DFIELD_TYPE=long"]);
+    assert_ne!(first.identity.key,second.identity.key);
+    let mut units=vec![first,second];
+    let p=plan(&mut units);
