@@ -0,0 +1,53 @@
+#include <stdint.h>
+struct _IO_wide_data;
+struct _IO_codecvt;
+struct _IO_marker;
+struct __locale_data;
+struct opaque_pointers {
+    unsigned char tag;
+    struct _IO_wide_data *wide;
+    struct _IO_codecvt *codecvt;
+    struct _IO_marker *marker;
+    struct __locale_data *locale;
+};
+struct refcount { unsigned char tag; unsigned int count; };
+unsigned int stable_sync(unsigned int *x, unsigned int value) {
+    return __sync_add_and_fetch(x, value);
+}
+unsigned int stable_atomic(unsigned int *x, unsigned int value) {
+    return __atomic_add_fetch(x, value, __ATOMIC_SEQ_CST);
+}
+unsigned int stable_effects(unsigned int *x, unsigned int value, unsigned int *pc, unsigned int *vc) {
+    return __sync_add_and_fetch(((*pc)++, x), ((*vc)++, value));
+}
+unsigned long long stable_layout(unsigned int which) {
+    switch (which) {
+    case 0: return sizeof(struct opaque_pointers);
+    case 1: return _Alignof(struct opaque_pointers);
+    case 2: return __builtin_offsetof(struct opaque_pointers, wide);
+    case 3: return __builtin_offsetof(struct opaque_pointers, codecvt);
+    case 4: return __builtin_offsetof(struct opaque_pointers, marker);
+    case 5: return __builtin_offsetof(struct opaque_pointers, locale);
+    case 6: return sizeof(struct refcount);
+    case 7: return _Alignof(struct refcount);
+    case 8: return __builtin_offsetof(struct refcount, count);
+    case 9: return sizeof(unsigned int);
+    case 10: return _Alignof(unsigned int);
+    default: return 999;
+    }
+}
+void *stable_opaque_roundtrip(void *value) {
+    struct opaque_pointers p = {0};
+    p.wide = value; p.codecvt = (void *)p.wide;
+    p.marker = (void *)p.codecvt; p.locale = (void *)p.marker;
+    return p.locale;
+}
+uint32_t stable_alias_sync(uint32_t volatile *x, uint32_t value) {
+    return __sync_add_and_fetch(x, value);
+}
+uint32_t stable_alias_atomic(uint32_t volatile *x, uint32_t value) {
+    return __atomic_add_fetch(x, value, __ATOMIC_SEQ_CST);
+}
+uint32_t stable_alias_effects(uint32_t volatile *x, uint32_t value, unsigned int *pc, unsigned int *vc) {
+    return __sync_add_and_fetch(((*pc)++, x), ((*vc)++, value));
+}
