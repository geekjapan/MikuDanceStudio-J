+    #[test]
+    fn closed_format_native_record_identity_is_compiler_owned() {
+        use c2rust_ast_exporter::clang_ast::RecordEvidence;
+        let mut ast = TypedAstContext::default();
+        let q = |n| CQualTypeId::new(CTypeId(n));
+        ast.c_types.insert(CTypeId(1), not_located(CTypeKind::Void));
+        ast.c_types.insert(CTypeId(2), not_located(CTypeKind::Struct(CDeclId(20))));
+        ast.c_types.insert(CTypeId(3), not_located(CTypeKind::Function(q(1), vec![], true, false, true, CCallingConvention::C)));
