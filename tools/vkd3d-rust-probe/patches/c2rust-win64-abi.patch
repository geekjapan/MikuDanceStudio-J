+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn closed_format_facts_consumption_retains_stars_lengths_and_unknowns() {
+        assert_eq!(c2rust_ast_exporter::sha256(b""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+        let parsed = TypedAstContext::format_consumption(b"%*.*zu:%lld:%s\0");
+        assert_eq!(parsed["state"], "Parsed");
+        assert_eq!(parsed["arguments"], 5);
+        assert_eq!(parsed["conversions"][0]["length"], json!([b'z']));
+        for bytes in [b"%2$d".as_slice(), b"%I64u", b"%", b"%*3$d"] {
+            assert_eq!(TypedAstContext::format_consumption(bytes)["state"], "Unproved");
+        }
+        assert_eq!(TypedAstContext::format_consumption(b"100%%")["arguments"], 0);
+    }
