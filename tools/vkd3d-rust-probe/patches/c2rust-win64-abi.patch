+        case 10: (void)offsetof(alias, mod[next_index()]); return counter;
+        case 11: return (unsigned char)offsetof(alias, mod[idx]);
+        case 12: return offsetof(alias, mod[(unsigned int)idx * 8u]);
+        case 13: return offsetof(aligned_alias, mod[idx]);
+    }
+    return 0;
+}
