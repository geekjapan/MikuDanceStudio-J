+#[test]
+fn win64_foreign_block_names_and_reexports() {
+    let item: Item = syn::parse_quote! {
+        unsafe extern "win64" {
+            pub fn native_callback(a: i64, b: f64) -> f64;
+            pub fn native_second() -> i64;
+        }
+    };
+    let names: Vec<_> = item_idents(&item)
+        .into_iter()
+        .map(ToString::to_string)
+        .collect();
+    assert_eq!(names, ["native_callback", "native_second"]);
+    let path = Path::new("native_api.h");
+    let context = TypedAstContext::new(
+        path,
+        &[SrcFile {
+            path: Some(path.into()),
+            include_loc: None,
+        }],
+    );
+    let mut store = ItemStore::new();
+    store.add_item(Box::new(item));
+    let mut exports = ItemStore::new();
+    let module = make_submodule(
+        &context,
+        &mut store,
+        0,
+        &mut exports,
+        &RefCell::default(),
+        true,
+        Edition2024,
+    );
+    let (items, foreign, uses) = exports.drain();
+    assert!(items.is_empty() && foreign.is_empty());
+    let mut exported = Vec::new();
+    for item in uses.into_items() {
+        let Item::Use(item) = *item else {
+            panic!("expected module reexport")
+        };
+        let IdentsOrGlob::Idents(names) = use_idents(&item.tree) else {
+            panic!("expected named reexports")
+        };
+        exported.extend(names.into_iter().map(ToString::to_string));
+    }
+    assert_eq!(exported, ["native_callback", "native_second"]);
+    let Item::Mod(module) = *module else {
+        panic!("expected header module")
+    };
+    let Item::ForeignMod(block) = &module.content.unwrap().1[0] else {
+        panic!("expected preserved extern block")
+    };
+    assert_eq!(block.abi.name.as_ref().unwrap().value(), "win64");
+}
