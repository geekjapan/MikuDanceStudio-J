diff --git a/c2rust-transpile/src/c_ast/closed_variadic.rs b/c2rust-transpile/src/c_ast/closed_variadic.rs
new file mode 100644
--- /dev/null
+++ b/c2rust-transpile/src/c_ast/closed_variadic.rs
@@ -0,0 +1,665 @@
+use super::*;
+use serde_json::{Value, json};
+
+impl TypedAstContext {
+    fn inventory_type(&self, typ: CQualTypeId, depth: usize) -> Value {
+        self.evidence_type(typ, depth, false)
+    }
+
+    fn cursor_type(&self, typ: CQualTypeId, depth: usize) -> Value {
+        self.evidence_type(typ, depth, true)
+    }
+
+    fn evidence_type(&self, typ: CQualTypeId, depth: usize, cursor: bool) -> Value {
+        if depth > 32 {
+            return json!({"unproved": "type depth limit"});
+        }
+        let mut canonical_type = typ.ctype;
+        let mut qualifiers = typ.qualifiers;
+        let mut visited = HashSet::new();
+        for _ in 0..32 {
+            if !visited.insert(canonical_type) {
+                return json!({"unproved": "typedef or wrapper cycle"});
+            }
+            canonical_type = match self[canonical_type].kind {
+                CTypeKind::Typedef(id) => {
+                    let Some(original) = self.source_typedef_types.get(&id) else {
+                        return json!({"unproved": "missing original typedef"});
+                    };
+                    qualifiers = qualifiers.and(original.qualifiers);
+                    original.ctype
+                }
+                CTypeKind::TypeOf(id)
+                | CTypeKind::Paren(id)
+                | CTypeKind::Elaborated(id)
+                | CTypeKind::Decayed(id)
+                | CTypeKind::Auto(id) => id,
+                CTypeKind::Attributed(_, _) => return json!({"unproved": "attributed type facts"}),
+                _ => break,
+            };
+        }
+        let kind = &self[canonical_type].kind;
+        let canonical = match kind {
+            CTypeKind::Pointer(inner) => json!({"pointer": self.evidence_type(*inner, depth + 1, cursor)}),
+            CTypeKind::Function(ret, args, variadic, noreturn, prototype, abi) => json!({
+                "return": self.evidence_type(*ret, depth + 1, cursor),
+                "parameters": args.iter().map(|t| self.evidence_type(*t, depth + 1, cursor)).collect::<Vec<_>>(),
+                "variadic": variadic, "noreturn": noreturn, "prototype": prototype, "abi": abi.as_str()
+            }),
+            CTypeKind::Struct(id) | CTypeKind::Union(id) | CTypeKind::Enum(id) => {
+                if cursor && self.native_va_list_records.contains(id) {
+                    json!({"native_va_list_record": id.0})
+                } else {
+                    json!({"record": self.inventory_record_identity(*id, 0)})
+                }
+            }
+            CTypeKind::ConstantArray(_, _) | CTypeKind::IncompleteArray(_) => {
+                let Some(element) = self.source_array_elements.get(&canonical_type) else {
+                    return json!({"unproved": "missing original qualified array element"});
+                };
+                let mut array = json!({"array": self.evidence_type(*element, depth + 1, cursor)});
+                if let CTypeKind::ConstantArray(_, len) = kind {
+                    array["length"] = json!(len);
+                }
+                array
+            }
+            CTypeKind::Char => match self.source_char_signedness.get(&canonical_type) {
+                Some(signed) => json!({"kind": "Char", "signed": signed}),
+                None => json!({"unproved": "missing plain char signedness"}),
+            },
+            CTypeKind::LongDouble => json!({"unproved": "long double ABI shape"}),
+            CTypeKind::Void
+            | CTypeKind::Bool
+            | CTypeKind::SChar
+            | CTypeKind::Short
+            | CTypeKind::Int
+            | CTypeKind::Long
+            | CTypeKind::LongLong
+            | CTypeKind::UChar
+            | CTypeKind::UShort
+            | CTypeKind::UInt
+            | CTypeKind::ULong
+            | CTypeKind::ULongLong
+            | CTypeKind::Float
+            | CTypeKind::Double
+            | CTypeKind::Int128
+            | CTypeKind::UInt128
+            | CTypeKind::Half => json!({"kind": format!("{kind:?}")}),
+            _ => json!({"unproved": "unsupported type or wrapper limit"}),
+        };
+        json!({"canonical": canonical, "const": qualifiers.is_const, "volatile": qualifiers.is_volatile, "restrict": qualifiers.is_restrict})
+    }
+
+    fn inventory_record_identity(&self, id: CDeclId, depth: usize) -> Value {
+        fn identity(e: &c2rust_ast_exporter::clang_ast::RecordEvidence, depth: usize) -> Value {
+            if depth > 32
+                || e.0 != 2
+                || e.8
+                || e.3.is_empty()
+                || e.3 == "?"
+                || !Path::new(&e.3).is_absolute()
+                || e.4 == 0
+                || e.5 == 0
+            {
+                return json!({"unproved": "physical record location or macro declaration"});
+            }
+            let scope = match (e.6.as_str(), &e.7) {
+                ("file", None) => json!({"file": true}),
+                ("record", Some(owner)) => json!({"record": identity(owner, depth + 1)}),
+                _ => return json!({"unproved": "record owning scope"}),
+            };
+            json!({"kind": e.1, "tag": e.2,
+                "physical": {"path": e.3, "line": e.4, "column": e.5}, "scope": scope})
+        }
+        self.record_evidence
+            .get(&id)
+            .map(|e| identity(e, depth))
+            .unwrap_or_else(|| json!({"unproved": "missing physical record evidence"}))
+    }
+
+    fn inventory_record_definitions(&self) -> Vec<Value> {
+        self.iter_decls().filter_map(|(id, decl)| {
+            let mut facts = json!({});
+            match &decl.kind {
+                CDeclKind::Struct { fields, .. } | CDeclKind::Union { fields, .. } => {
+                    facts["fields"] = fields.as_ref().map(|fields| fields.iter().map(|field| {
+                        match &self[*field].kind {
+                            CDeclKind::Field { name, typ, bitfield_width, platform_bit_offset,
+                                platform_type_bitwidth, manual_alignment } => json!({
+                                    "name": name, "type": self.inventory_type(*typ, 0),
+                                    "bit_width": bitfield_width, "bit_offset": platform_bit_offset,
+                                    "type_bit_width": platform_type_bitwidth, "alignment": manual_alignment,
+                                }),
+                            _ => json!({"unproved": "non-field record child"}),
+                        }
+                    }).collect::<Vec<_>>()).map(Value::Array).unwrap_or(Value::Null);
+                    facts["layout"] = self.record_evidence.get(id).map(|e| json!(e.10)).unwrap_or(Value::Null);
+                }
+                CDeclKind::Enum { variants, underlying_type_id, .. } => {
+                    facts["underlying"] = underlying_type_id.map(|t| self.inventory_type(t, 0)).unwrap_or(Value::Null);
+                    facts["variants"] = json!(variants.iter().map(|variant| match &self[*variant].kind {
+                        CDeclKind::EnumConstant { name, value } => match value {
+                            ConstIntExpr::I(value) => json!({"name": name, "signed": true, "value": value}),
+                            ConstIntExpr::U(value) => json!({"name": name, "signed": false, "value": value}),
+                        },
+                        _ => json!({"unproved": "non-enumerator child"}),
+                    }).collect::<Vec<_>>());
+                }
+                _ => return None,
+            }
+            let state = match self.record_evidence.get(id) {
+                Some(e) if e.0 == 2 && e.9 => "complete",
+                Some(e) if e.0 == 2 => "incomplete",
+                _ => "unproved",
+            };
+            Some(json!({"identity": self.inventory_record_identity(*id, 0), "state": state, "facts": facts, "diagnostic_location": decl.begin_loc().map(|l| self.loc_to_string(l))}))
+        }).collect()
+    }
+
+    fn inventory_promotions(&self, mut expr: CExprId) -> Vec<Value> {
+        let mut types = vec![];
+        loop {
+            if let Some(typ) = self[expr].kind.get_qual_type() {
+                types.push(self.inventory_type(typ, 0));
+            }
+            match self[expr].kind {
+                CExprKind::ImplicitCast(_, inner, _, _, _) | CExprKind::Paren(_, inner) => {
+                    expr = inner
+                }
+                _ => return types,
+            }
+        }
+    }
+
+    fn inventory_symbol(&self, id: CDeclId, unit: &Path) -> Option<Value> {
+        if let CDeclKind::Function {
+            name, is_global, ..
+        } = &self[id].kind
+        {
+            Some(if *is_global {
+                json!({"linker": self.linker_names.get(&id).expect("missing Clang function linker identity")})
+            } else {
+                json!({"unit": unit, "static": name})
+            })
+        } else {
+            None
+        }
+    }
+
+    fn inventory_callee(&self, mut expr: CExprId) -> Option<CDeclId> {
+        loop {
+            match self[expr].kind {
+                CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => {
+                    expr = inner
+                }
+                CExprKind::DeclRef(_, id, _) => {
+                    return self.inventory_symbol(id, &self.main_file).map(|_| id);
+                }
+                _ => return None,
+            }
+        }
+    }
+
+    fn cursor_operand(&self, mut id: CExprId) -> Value {
+        let original = id;
+        loop {
+            match &self[id].kind {
+                CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => id = *inner,
+                _ => break,
+            }
+        }
+        json!({"id": original.0,
+            "direct_decl": match self[id].kind { CExprKind::DeclRef(_, d, _) => Some(d.0), _ => None },
+            "literal": match &self[id].kind { CExprKind::Literal(_, CLiteral::String(bytes, 1)) => Some(bytes), _ => None },
+            "type": self[original].kind.get_qual_type().map(|t| self.cursor_type(t, 0)),
+            "references": iterators::DFExpr::new(self, original.into()).filter_map(|n| n.expr())
+                .filter_map(|e| match self[e].kind { CExprKind::DeclRef(_, d, _) => Some(json!({"id": e.0, "decl": d.0})), _ => None }).collect::<Vec<_>>()})
+    }
+
+    fn cursor_declaration(&self, id: CDeclId) -> Value {
+        let mut value = json!({"id": id.0});
+        match &self[id].kind {
+            CDeclKind::Variable { ident, typ, initializer, has_static_duration, has_thread_duration, is_externally_visible, .. } => {
+                value["kind"] = json!("variable");
+                value["name"] = json!(ident);
+                value["local"] = json!(self.native_local_variables.contains(&id));
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["initializer"] = json!(initializer.map(|e| e.0));
+                value["static"] = json!(has_static_duration);
+                value["thread"] = json!(has_thread_duration);
+                value["externally_visible"] = json!(is_externally_visible);
+                value["native_va_list"] = self.native_cursor_types.get(&id).map(|(declared, builtin, kind)|
+                    json!({"same_canonical_type": true, "declared_type_id": declared.ctype.0,
+                        "builtin_type_id": builtin.ctype.0, "declared_const": declared.qualifiers.is_const,
+                        "declared_volatile": declared.qualifiers.is_volatile, "declared_restrict": declared.qualifiers.is_restrict,
+                        "builtin_const": builtin.qualifiers.is_const, "builtin_volatile": builtin.qualifiers.is_volatile,
+                        "builtin_restrict": builtin.qualifiers.is_restrict, "target_kind": kind})).unwrap_or(Value::Null);
+            }
+            CDeclKind::Field { name, typ, .. } => {
+                value["kind"] = json!("field"); value["name"] = json!(name);
+                value["type"] = self.cursor_type(*typ, 0);
+                value["type_id"] = json!(typ.ctype.0);
+                value["owners"] = json!(self.iter_decls().filter_map(|(owner, d)| match &d.kind {
+                    CDeclKind::Struct { fields: Some(fields), .. } | CDeclKind::Union { fields: Some(fields), .. }
+                        if fields.contains(&id) => Some(self.inventory_record_identity(*owner, 0)),
+                    _ => None,
+                }).collect::<Vec<_>>());
+            }
+            CDeclKind::EnumConstant { name, value: number } => {
+                value["kind"] = json!("enum_constant"); value["name"] = json!(name);
+                value["value"] = match number { ConstIntExpr::I(n) => json!(n), ConstIntExpr::U(n) => json!(n) };
+            }
+            _ => value["kind"] = json!("unsupported"),
+        }
+        value
+    }
+
+    fn cursor_expression(&self, id: CExprId) -> Value {
+        let mut value = json!({"id": id.0, "kind": "unsupported",
+            "type": self[id].kind.get_qual_type().map(|t| self.cursor_type(t, 0)),
+            "type_id": self[id].kind.get_qual_type().map(|t| t.ctype.0),
+            "children": []});
+        match &self[id].kind {
+            CExprKind::Literal(_, literal) => {
+                value["kind"] = json!("literal");
+                value["literal"] = match literal {
+                    CLiteral::Integer(n, _) => json!({"integer": n}),
+                    CLiteral::Character(n) => json!({"character": n}),
+                    CLiteral::String(bytes, width) => json!({"bytes": bytes, "width": width}),
+                    _ => json!({"unsupported": true}),
+                };
+            }
+            CExprKind::DeclRef(_, decl, _) => {
+                value["kind"] = json!("reference"); value["decl"] = json!(decl.0);
+            }
+            CExprKind::Paren(_, child) => {
+                value["kind"] = json!("paren"); value["children"] = json!([child.0]);
+            }
+            CExprKind::ImplicitCast(_, child, cast, field, _) |
+            CExprKind::ExplicitCast(_, child, cast, field, _) => {
+                value["kind"] = json!(if matches!(self[id].kind, CExprKind::ImplicitCast(..)) { "implicit_cast" } else { "explicit_cast" });
+                value["children"] = json!([child.0]); value["cast"] = json!(format!("{:?}", cast));
+                value["field"] = json!(field.map(|f| f.0));
+            }
+            CExprKind::Unary(_, op, child, _) => {
+                value["kind"] = json!("unary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([child.0]);
+            }
+            CExprKind::UnaryType(_, op, child, argument_type) => {
+                value["kind"] = json!("unary_type"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!(child.iter().map(|c| c.0).collect::<Vec<_>>());
+                value["argument_type"] = self.cursor_type(*argument_type, 0);
+            }
+            CExprKind::Binary(_, op, left, right, lhs_type, rhs_type) => {
+                value["kind"] = json!("binary"); value["operator"] = json!(format!("{:?}", op));
+                value["children"] = json!([left.0, right.0]);
+                value["computation_types"] = json!([lhs_type.map(|t| self.cursor_type(t, 0)), rhs_type.map(|t| self.cursor_type(t, 0))]);
+            }
+            CExprKind::Call(_, callee, args) => {
+                let decl = self.inventory_callee(*callee);
+                value["kind"] = json!("call");
+                value["children"] = json!(std::iter::once(callee.0).chain(args.iter().map(|a| a.0)).collect::<Vec<_>>());
+                value["callee_decl"] = json!(decl.map(|d| d.0));
+                value["builtin"] = json!(decl.and_then(|d| self.cursor_builtin_identity.get(&d)));
+                value["arguments"] = json!(args.iter().map(|a| self.cursor_operand(*a)).collect::<Vec<_>>());
+            }
+            CExprKind::Member(_, parent, member, kind, _) => {
+                value["kind"] = json!("member"); value["children"] = json!([parent.0]);
+                value["member"] = self.cursor_declaration(*member);
+                value["access"] = json!(format!("{:?}", kind));
+            }
+            CExprKind::ArraySubscript(_, base, index, _) => {
+                value["kind"] = json!("subscript"); value["children"] = json!([base.0, index.0]);
+            }
+            _ => {}
+        }
+        value
+    }
+
+    /// A separate raw witness. Statement order comes only from the compound body.
+    pub fn cursor_witness(&self, unit: &Path) -> Value {
+        let mut functions = vec![];
+        for (id, decl) in self.iter_decls() {
+            let CDeclKind::Function { body: Some(body), parameters, typ, .. } = &decl.kind else { continue };
+            let variadic = matches!(self[*typ].kind, CTypeKind::Function(_, _, true, _, _, _));
+            if !variadic { continue; }
+            let cursors: Vec<_> = iterators::DFExpr::new(self, (*body).into()).filter_map(|n| n.decl())
+                .filter(|d| self.native_cursor_types.contains_key(d))
+                .collect();
+            let statements = match &self[*body].kind {
+                CStmtKind::Compound(children) => children.iter().map(|stmt| {
+                    let (kind, root) = match self[*stmt].kind {
+                        CStmtKind::Decls(..) => ("declarations", None),
+                        CStmtKind::Expr(expr) => ("expression", Some(expr.0)),
+                        CStmtKind::Empty => ("empty", None), _ => ("unsupported", None),
+                    };
+                    json!({"id": stmt.0, "kind": kind, "root": root,
+                        "declarations": match &self[*stmt].kind {
+                            CStmtKind::Decls(ds) => ds.iter().map(|d| self.cursor_declaration(*d)).collect::<Vec<_>>(), _ => vec![] },
+                        "expressions": iterators::DFExpr::new(self, (*stmt).into()).filter_map(|n| n.expr())
+                            .map(|e| self.cursor_expression(e)).collect::<Vec<_>>()})
+                }).collect::<Vec<_>>(), _ => vec![],
+            };
+            let references = self.c_exprs.iter().filter_map(|(e, node)| match node.kind {
+                CExprKind::DeclRef(_, d, _) if parameters.contains(&d) || cursors.contains(&d) => Some(json!({"id": e.0, "decl": d.0,
+                    "type": node.kind.get_qual_type().map(|t| self.cursor_type(t, 0))})), _ => None,
+            }).collect::<Vec<_>>();
+            functions.push(json!({"declaration": id.0, "symbol": self.inventory_symbol(*id, unit),
+                "body": body.0, "complete_body": matches!(self[*body].kind, CStmtKind::Compound(_)),
+                "parameters": parameters.iter().map(|p| p.0).collect::<Vec<_>>(),
+                "parameter_declarations": parameters.iter().map(|p| self.cursor_declaration(*p)).collect::<Vec<_>>(),
+                "signature": self.cursor_type(CQualTypeId::new(*typ), 0),
+                "last_fixed_parameter": parameters.last().map(|p| p.0),
+                "cursors": cursors.iter().map(|c| c.0).collect::<Vec<_>>(),
+                "statements": statements, "parameter_and_cursor_references": references,
+                "full_statement_ids": iterators::DFExpr::new(self, (*body).into()).filter_map(|n| n.stmt()).map(|s| s.0).collect::<Vec<_>>() }));
+        }
+        let calls = self.c_exprs.iter().filter(|(_, e)| matches!(e.kind, CExprKind::Call(..)))
+            .map(|(id, _)| self.cursor_expression(*id)).collect::<Vec<_>>();
+        json!({"schema": 2, "authorization": "witness_only", "unit": unit, "target": self.target,
+            "native_va_list_kind": self.va_list_kind as u64,
+            "functions": functions, "calls": calls,
+            "native_va_list_records": self.native_va_list_records.iter().map(|id| id.0).collect::<Vec<_>>(),
+            "expressions": self.c_exprs.iter().map(|(id, _)| self.cursor_expression(*id)).collect::<Vec<_>>(),
+            "declarations": self.iter_decls().filter(|(_, d)| matches!(d.kind, CDeclKind::Variable { .. } | CDeclKind::EnumConstant { .. })).map(|(id, _)| self.cursor_declaration(*id)).collect::<Vec<_>>(),
+            "native_inputs": self.cursor_inputs.as_ref().map(|s| serde_json::from_str::<Value>(s).expect("native input facts JSON"))})
+    }
+
+    /// Facts only. No inventory record authorizes lowering without the closed-program gates.
+    pub fn closed_variadic_inventory(&self, unit: &Path) -> Value {
+        let mut declarations = vec![];
+        let mut owners = HashMap::new();
+        for (id, decl) in self.iter_decls() {
+            if let CDeclKind::Function {
+                typ,
+                body,
+                parameters,
+                ..
+            } = &decl.kind
+            {
+                declarations.push(json!({
+                    "id": id.0, "symbol": self.inventory_symbol(*id, unit),
+                    "location": decl.begin_loc().map(|l| self.loc_to_string(l)),
+                    "signature": self.inventory_type(CQualTypeId::new(*typ), 0),
+                    "definition": body.is_some(),
+                    "aliases": match &decl.kind { CDeclKind::Function { attrs, .. } => attrs.iter().filter_map(|a| match a { Attribute::Alias(name) => Some(name.clone()), _ => None }).collect::<Vec<_>>(), _ => vec![] },
+                    "va_parameters": parameters.iter().filter(|p| match self[**p].kind {
+                        CDeclKind::Variable { typ, .. } => self.is_va_list(typ.ctype), _ => false,
+                    }).map(|p| p.0).collect::<Vec<_>>(),
+                }));
+                if let Some(body) = body {
+                    for node in iterators::DFExpr::new(self, (*body).into()) {
+                        if let Some(expr) = node.expr() {
+                            owners.insert(expr, *id);
+                        }
+                    }
+                }
+            }
+        }
+        let mut direct_refs = HashSet::new();
+        let mut calls = vec![];
+        let mut expressions: Vec<_> = self.c_exprs.iter().collect();
+        expressions.sort_by_key(|(id, _)| id.0);
+        for (id, expr) in &expressions {
+            if let CExprKind::Call(_, callee, args) = &expr.kind {
+                let callee_id = self.inventory_callee(*callee);
+                if callee_id.is_some() {
+                    for node in iterators::DFExpr::new(self, (*callee).into()) {
+                        if let Some(reference) = node.expr() {
+                            direct_refs.insert(reference);
+                        }
+                    }
+                }
+                calls.push(json!({
+                    "id": id.0, "owner": owners.get(id).map(|d| d.0),
+                    "location": expr.begin_loc().map(|l| self.loc_to_string(l)),
+                    "callee": callee_id.and_then(|d| self.inventory_symbol(d, unit)),
+                    "arguments": args.iter().map(|arg| json!({
+                        "id": arg.0,
+                        "promotion_chain": self.inventory_promotions(*arg),
+                        "type": self[*arg].kind.get_qual_type().map(|t| self.inventory_type(t, 0)),
+                        "va_list": self[*arg].kind.get_qual_type().map(|t| self.is_va_list(t.ctype)),
+                    })).collect::<Vec<_>>(),
+                }));
+            }
+        }
+        let mut escapes = vec![];
+        let mut va_arg = vec![];
+        for (id, expr) in expressions {
+            match expr.kind {
+                CExprKind::DeclRef(_, decl, _) if !direct_refs.contains(id) => {
+                    if let Some(symbol) = self.inventory_symbol(decl, unit) {
+                        escapes.push(json!({"symbol": symbol, "location": expr.begin_loc().map(|l| self.loc_to_string(l))}));
+                    }
+                }
+                CExprKind::VAArg(_, _) => va_arg.push(json!({"owner": owners.get(id).map(|d| d.0), "location": expr.begin_loc().map(|l| self.loc_to_string(l))})),
+                _ => (),
+            }
+        }
+        json!({"schema": 2, "record_evidence_schema": 2, "record_definitions": self.inventory_record_definitions(), "unit": unit, "target": self.target,
+            "target_c_widths_bits": {"char": self.target_c_widths[0], "short": self.target_c_widths[1], "int": self.target_c_widths[2], "long": self.target_c_widths[3], "long_long": self.target_c_widths[4], "pointer": self.target_c_widths[5], "float": self.target_c_widths[6], "double": self.target_c_widths[7]},
+            "authorization": "inventory_only", "declarations": declarations,
+            "calls": calls, "non_call_references": escapes, "va_arg": va_arg})
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn not_located<T>(kind: T) -> Located<T> {
+        Located { loc: None, kind }
+    }
+
+    #[test]
+    fn closed_variadic_inventory_uses_promoted_ast_types_and_linker_identity() {
+        let mut ast = TypedAstContext::default();
+        let int = CQualTypeId::new(CTypeId(1));
+        let short = CQualTypeId::new(CTypeId(2));
+        let function = CTypeId(3);
+        ast.c_types.insert(int.ctype, not_located(CTypeKind::Int));
+        ast.c_types
+            .insert(short.ctype, not_located(CTypeKind::UShort));
+        ast.c_types.insert(
+            function,
+            not_located(CTypeKind::Function(
+                int,
+                vec![int],
+                true,
+                false,
+                true,
+                CCallingConvention::C,
+            )),
+        );
+        let declaration = CDeclId(1);
+        ast.linker_names.insert(declaration, "asm_format".into());
+        ast.target_c_widths = [8, 16, 32, 32, 64, 64, 32, 64];
+        ast.c_decls.insert(
+            declaration,
+            not_located(CDeclKind::Function {
+                is_global: true,
+                is_inline: false,
+                is_implicit: false,
+                is_extern: true,
+                is_inline_externally_visible: false,
+                typ: function,
+                name: "private_format".into(),
+                parameters: vec![],
+                body: None,
+                attrs: IndexSet::new(),
+            }),
+        );
+        ast.c_exprs.insert(
+            CExprId(1),
+            not_located(CExprKind::DeclRef(
+                CQualTypeId::new(function),
+                declaration,
+                LRValue::RValue,
+            )),
+        );
+        ast.c_exprs
+            .insert(CExprId(2), not_located(CExprKind::ImplicitValueInit(short)));
+        ast.c_exprs.insert(
+            CExprId(3),
+            not_located(CExprKind::ImplicitCast(
+                int,
+                CExprId(2),
+                CastKind::IntegralCast,
+                None,
+                LRValue::RValue,
+            )),
+        );
+        ast.c_exprs.insert(
+            CExprId(4),
+            not_located(CExprKind::Call(
+                int,
+                CExprId(1),
+                vec![CExprId(2), CExprId(3)],
+            )),
+        );
+        ast.c_types.insert(CTypeId(20), not_located(CTypeKind::Char));
+        let plain_char = CQualTypeId::new(CTypeId(20));
+        assert_eq!(ast.inventory_type(plain_char, 0)["canonical"]["unproved"],
+                   "missing plain char signedness");
+        for signed in [true, false] {
+            ast.source_char_signedness.insert(CTypeId(20), signed);
+            assert_eq!(ast.inventory_type(plain_char, 0)["canonical"],
+                       json!({"kind": "Char", "signed": signed}));
+        }
+        for (index, kind, name) in [(21, CTypeKind::SChar, "SChar"),
+                                     (22, CTypeKind::UChar, "UChar")] {
+            ast.c_types.insert(CTypeId(index), not_located(kind));
+            assert_eq!(ast.inventory_type(CQualTypeId::new(CTypeId(index)), 0)["canonical"],
+                       json!({"kind": name}));
+        }
+        ast.c_types.insert(CTypeId(8), not_located(CTypeKind::Long));
+        ast.c_types
+            .insert(CTypeId(9), not_located(CTypeKind::Typedef(CDeclId(9))));
+        ast.source_typedef_types
+            .insert(CDeclId(9), CQualTypeId::new(CTypeId(8)));
+        assert_eq!(
+            ast.inventory_type(CQualTypeId::new(CTypeId(9)), 0)["canonical"]["kind"],
+            "Long"
+        );
+        for (index, kind) in [(10, CTypeKind::ConstantArray(CTypeId(1), 2)),
+                              (11, CTypeKind::IncompleteArray(CTypeId(1))),
+                              (12, CTypeKind::ConstantArray(CTypeId(10), 3))] {
+            ast.c_types.insert(CTypeId(index), not_located(kind));
+        }
+        let mut qualified = int;
+        qualified.qualifiers.is_const = true;
+        qualified.qualifiers.is_volatile = true;
+        for index in [10, 11] {
+            ast.source_array_elements.insert(CTypeId(index), qualified);
+            let evidence = ast.inventory_type(CQualTypeId::new(CTypeId(index)), 0);
+            assert_eq!(evidence["canonical"]["array"]["const"], true);
+            assert_eq!(evidence["canonical"]["array"]["volatile"], true);
+        }
+        ast.source_array_elements.insert(CTypeId(12), CQualTypeId::new(CTypeId(10)));
+        assert_eq!(ast.inventory_type(CQualTypeId::new(CTypeId(12)), 0)
+                   ["canonical"]["array"]["canonical"]["array"]["const"], true);
+        ast.c_types.insert(CTypeId(14), not_located(CTypeKind::Pointer(int)));
+        let mut restricted = CQualTypeId::new(CTypeId(14));
+        restricted.qualifiers.is_restrict = true;
+        ast.source_array_elements.insert(CTypeId(11), restricted);
+        assert_eq!(ast.inventory_type(CQualTypeId::new(CTypeId(11)), 0)
+                   ["canonical"]["array"]["restrict"], true);
+        ast.source_array_elements.remove(&CTypeId(11));
+        assert!(ast.inventory_type(CQualTypeId::new(CTypeId(11)), 0)["unproved"].is_string());
+        ast.c_types.insert(CTypeId(13), not_located(CTypeKind::LongDouble));
+        assert_eq!(ast.inventory_type(CQualTypeId::new(CTypeId(13)), 0)
+                   ["canonical"]["unproved"], "long double ABI shape");
+        assert!(ast.inventory_type(int, 33)["unproved"].is_string());
+        use c2rust_ast_exporter::clang_ast::{RecordEvidence, from_value, Value as CborValue};
+        let tuple = CborValue::Array(vec![CborValue::Integer(2), CborValue::Text("struct".into()),
+            CborValue::Text("node".into()), CborValue::Text("/shared.h".into()),
+            CborValue::Integer(1), CborValue::Integer(1), CborValue::Text("file".into()),
+            CborValue::Null, CborValue::Bool(false), CborValue::Bool(true), CborValue::Null]);
+        let evidence: RecordEvidence = from_value(tuple.clone()).unwrap();
+        ast.record_evidence.insert(CDeclId(99), evidence);
+        assert_eq!(ast.inventory_record_identity(CDeclId(99), 0)["physical"]["line"], 1);
+        for index in [3, 4, 5] {
+            let mut invalid = tuple.clone();
+            let CborValue::Array(ref mut values) = invalid else { unreachable!() };
+            values[index] = if index == 3 { CborValue::Text("?".into()) } else { CborValue::Integer(0) };
+            ast.record_evidence.insert(CDeclId(99), from_value(invalid).unwrap());
+            assert!(ast.inventory_record_identity(CDeclId(99), 0)["unproved"].is_string());
+        }
+        for invalid in [CborValue::Array(vec![]), {
+            let mut invalid = tuple;
+            let CborValue::Array(ref mut values) = invalid else { unreachable!() };
+            values[4] = CborValue::Text("not a coordinate".into());
+            invalid
+        }] {
+            assert!(from_value::<RecordEvidence>(invalid).is_err());
+        }
+        let a = ast.closed_variadic_inventory(Path::new("caller.c"));
+        let b = ast.closed_variadic_inventory(Path::new("definition.c"));
+        assert_eq!(a["declarations"][0]["symbol"]["linker"], "asm_format");
+        assert_eq!(a["target_c_widths_bits"]["long"], 32);
+        assert_eq!(
+            a["declarations"][0]["symbol"],
+            b["declarations"][0]["symbol"]
+        );
+        assert_eq!(
+            a["calls"][0]["arguments"][1]["type"]["canonical"]["kind"],
+            "Int"
+        );
+        assert_eq!(
+            a["calls"][0]["arguments"][1]["promotion_chain"][1]["canonical"]["kind"],
+            "UShort"
+        );
+        assert_eq!(a["non_call_references"], json!([]));
+        ast.c_exprs.insert(
+            CExprId(5),
+            not_located(CExprKind::DeclRef(
+                CQualTypeId::new(function),
+                declaration,
+                LRValue::RValue,
+            )),
+        );
+        assert_eq!(
+            ast.closed_variadic_inventory(Path::new("caller.c"))["non_call_references"]
+                .as_array()
+                .unwrap()
+                .len(),
+            1
+        );
+        if let CDeclKind::Function { is_global, .. } =
+            &mut ast.c_decls.get_mut(&declaration).unwrap().kind
+        {
+            *is_global = false;
+        }
+        assert_ne!(
+            ast.closed_variadic_inventory(Path::new("caller.c"))["declarations"][0]["symbol"],
+            ast.closed_variadic_inventory(Path::new("definition.c"))["declarations"][0]["symbol"]
+        );
+        let builtin = CQualTypeId::new(CTypeId(90));
+        ast.c_types.insert(builtin.ctype, not_located(CTypeKind::Struct(CDeclId(99))));
+        ast.native_va_list_records.insert(CDeclId(99));
+        assert!(ast.inventory_type(builtin, 0)["canonical"]["record"]["unproved"].is_string());
+        assert_eq!(ast.cursor_type(builtin, 0)["canonical"], json!({"native_va_list_record": 99}));
+        let cursor = CDeclId(90);
+        ast.c_decls.insert(cursor, not_located(CDeclKind::Variable {
+            ident: "args".into(), typ: builtin, initializer: None,
+            has_static_duration: false, has_thread_duration: false,
+            is_externally_visible: false, is_defn: true, attrs: vec![],
+        }));
+        ast.native_local_variables.insert(cursor);
+        ast.native_cursor_types.insert(cursor, (builtin, builtin, 0));
+        let declaration = ast.cursor_declaration(cursor);
+        assert_eq!(declaration["local"], true);
+        assert_eq!(declaration["native_va_list"]["declared_type_id"], 90);
+        assert_eq!(declaration["native_va_list"]["builtin_type_id"], 90);
+        ast.c_exprs.insert(CExprId(90), not_located(CExprKind::DeclRef(builtin, cursor, LRValue::LValue)));
+        ast.c_exprs.insert(CExprId(91), not_located(CExprKind::Unary(int, CUnOp::AddressOf, CExprId(90), LRValue::RValue)));
+        ast.c_exprs.insert(CExprId(92), not_located(CExprKind::Binary(int, CBinOp::Assign,
+            CExprId(90), CExprId(91), None, None)));
+        assert_eq!(ast.cursor_expression(CExprId(90))["decl"], 90);
+        assert_eq!(ast.cursor_expression(CExprId(91))["operator"], "AddressOf");
+        assert_eq!(ast.cursor_expression(CExprId(92))["children"], json!([90, 91]));
+        assert_eq!(ast.cursor_expression(CExprId(92))["operator"], "Assign");
+
+    }
+}
