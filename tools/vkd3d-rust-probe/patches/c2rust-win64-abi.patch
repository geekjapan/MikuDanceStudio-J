diff --git a/c2rust-transpile/src/c_ast/closed_variadic.rs b/c2rust-transpile/src/c_ast/closed_variadic.rs
new file mode 100644
index 0000000..2d54564
--- /dev/null
+++ b/c2rust-transpile/src/c_ast/closed_variadic.rs
@@ -0,0 +1,304 @@
+use super::*;
+use serde_json::{json, Value};
+
+impl TypedAstContext {
+    fn inventory_type(&self, typ: CQualTypeId, depth: usize) -> Value {
+        if depth > 32 {
+            return json!({"unsupported": "recursive type"});
+        }
+        let mut canonical_type = typ.ctype;
+        let mut qualifiers = typ.qualifiers;
+        for _ in 0..32 {
+            canonical_type = match self[canonical_type].kind {
+                CTypeKind::Typedef(id) => {
+                    let original = self
+                        .source_typedef_types
+                        .get(&id)
+                        .expect("missing original Clang typedef type");
+                    qualifiers = qualifiers.and(original.qualifiers);
+                    original.ctype
+                }
+                CTypeKind::TypeOf(id)
+                | CTypeKind::Paren(id)
+                | CTypeKind::Elaborated(id)
+                | CTypeKind::Decayed(id)
+                | CTypeKind::Auto(id) => id,
+                CTypeKind::Attributed(inner, _) => {
+                    qualifiers = qualifiers.and(inner.qualifiers);
+                    inner.ctype
+                }
+                _ => break,
+            };
+        }
+        let kind = &self[canonical_type].kind;
+        let canonical = match kind {
+            CTypeKind::Pointer(inner) => json!({"pointer": self.inventory_type(*inner, depth + 1)}),
+            CTypeKind::Function(ret, args, variadic, noreturn, prototype, abi) => json!({
+                "return": self.inventory_type(*ret, depth + 1),
+                "parameters": args.iter().map(|t| self.inventory_type(*t, depth + 1)).collect::<Vec<_>>(),
+                "variadic": variadic, "noreturn": noreturn, "prototype": prototype, "abi": abi.as_str()
+            }),
+            CTypeKind::Struct(id) | CTypeKind::Union(id) | CTypeKind::Enum(id) => json!({
+                "record_kind": match kind { CTypeKind::Struct(_) => "struct", CTypeKind::Union(_) => "union", _ => "enum" },
+                "declaration": self[*id].begin_loc().map(|l| self.loc_to_string(l)),
+                "enum_underlying": match self[*id].kind { CDeclKind::Enum { underlying_type_id: Some(t), .. } => Some(self.inventory_type(t, depth + 1)), _ => None },
+            }),
+            CTypeKind::ConstantArray(inner, len) => {
+                json!({"array": self.inventory_type(CQualTypeId::new(*inner), depth + 1), "length": len})
+            }
+            CTypeKind::IncompleteArray(inner) => {
+                json!({"array": self.inventory_type(CQualTypeId::new(*inner), depth + 1)})
+            }
+            _ => json!({"kind": format!("{kind:?}")}),
+        };
+        json!({"canonical": canonical, "const": qualifiers.is_const, "volatile": qualifiers.is_volatile, "restrict": qualifiers.is_restrict})
+    }
+
+    fn inventory_promotions(&self, mut expr: CExprId) -> Vec<Value> {
+        let mut types = vec![];
+        loop {
+            if let Some(typ) = self[expr].kind.get_qual_type() {
+                types.push(self.inventory_type(typ, 0));
+            }
+            match self[expr].kind {
+                CExprKind::ImplicitCast(_, inner, _, _, _) | CExprKind::Paren(_, inner) => {
+                    expr = inner
+                }
+                _ => return types,
+            }
+        }
+    }
+
+    fn inventory_symbol(&self, id: CDeclId, unit: &Path) -> Option<Value> {
+        if let CDeclKind::Function {
+            name, is_global, ..
+        } = &self[id].kind
+        {
+            Some(if *is_global {
+                json!({"linker": self.linker_names.get(&id).expect("missing Clang function linker identity")})
+            } else {
+                json!({"unit": unit, "static": name})
+            })
+        } else {
+            None
+        }
+    }
+
+    fn inventory_callee(&self, mut expr: CExprId) -> Option<CDeclId> {
+        loop {
+            match self[expr].kind {
+                CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => {
+                    expr = inner
+                }
+                CExprKind::DeclRef(_, id, _) => {
+                    return self.inventory_symbol(id, &self.main_file).map(|_| id)
+                }
+                _ => return None,
+            }
+        }
+    }
+
+    /// Facts only. No inventory record authorizes lowering without the closed-program gates.
+    pub fn closed_variadic_inventory(&self, unit: &Path) -> Value {
+        let mut declarations = vec![];
+        let mut owners = HashMap::new();
+        for (id, decl) in self.iter_decls() {
+            if let CDeclKind::Function {
+                typ,
+                body,
+                parameters,
+                ..
+            } = &decl.kind
+            {
+                declarations.push(json!({
+                    "id": id.0, "symbol": self.inventory_symbol(*id, unit),
+                    "location": decl.begin_loc().map(|l| self.loc_to_string(l)),
+                    "signature": self.inventory_type(CQualTypeId::new(*typ), 0),
+                    "definition": body.is_some(),
+                    "aliases": match &decl.kind { CDeclKind::Function { attrs, .. } => attrs.iter().filter_map(|a| match a { Attribute::Alias(name) => Some(name.clone()), _ => None }).collect::<Vec<_>>(), _ => vec![] },
+                    "va_parameters": parameters.iter().filter(|p| match self[**p].kind {
+                        CDeclKind::Variable { typ, .. } => self.is_va_list(typ.ctype), _ => false,
+                    }).map(|p| p.0).collect::<Vec<_>>(),
+                }));
+                if let Some(body) = body {
+                    for node in iterators::DFExpr::new(self, (*body).into()) {
+                        if let Some(expr) = node.expr() {
+                            owners.insert(expr, *id);
+                        }
+                    }
+                }
+            }
+        }
+        let mut direct_refs = HashSet::new();
+        let mut calls = vec![];
+        let mut expressions: Vec<_> = self.c_exprs.iter().collect();
+        expressions.sort_by_key(|(id, _)| id.0);
+        for (id, expr) in &expressions {
+            if let CExprKind::Call(_, callee, args) = &expr.kind {
+                let callee_id = self.inventory_callee(*callee);
+                if callee_id.is_some() {
+                    for node in iterators::DFExpr::new(self, (*callee).into()) {
+                        if let Some(reference) = node.expr() {
+                            direct_refs.insert(reference);
+                        }
+                    }
+                }
+                calls.push(json!({
+                    "id": id.0, "owner": owners.get(id).map(|d| d.0),
+                    "location": expr.begin_loc().map(|l| self.loc_to_string(l)),
+                    "callee": callee_id.and_then(|d| self.inventory_symbol(d, unit)),
+                    "arguments": args.iter().map(|arg| json!({
+                        "id": arg.0,
+                        "promotion_chain": self.inventory_promotions(*arg),
+                        "type": self[*arg].kind.get_qual_type().map(|t| self.inventory_type(t, 0)),
+                        "va_list": self[*arg].kind.get_qual_type().map(|t| self.is_va_list(t.ctype)),
+                    })).collect::<Vec<_>>(),
+                }));
+            }
+        }
+        let mut escapes = vec![];
+        let mut va_arg = vec![];
+        for (id, expr) in expressions {
+            match expr.kind {
+                CExprKind::DeclRef(_, decl, _) if !direct_refs.contains(id) => {
+                    if let Some(symbol) = self.inventory_symbol(decl, unit) {
+                        escapes.push(json!({"symbol": symbol, "location": expr.begin_loc().map(|l| self.loc_to_string(l))}));
+                    }
+                }
+                CExprKind::VAArg(_, _) => va_arg.push(json!({"owner": owners.get(id).map(|d| d.0), "location": expr.begin_loc().map(|l| self.loc_to_string(l))})),
+                _ => (),
+            }
+        }
+        json!({"schema": 1, "unit": unit, "target": self.target,
+            "target_c_widths_bits": {"char": self.target_c_widths[0], "short": self.target_c_widths[1], "int": self.target_c_widths[2], "long": self.target_c_widths[3], "long_long": self.target_c_widths[4], "pointer": self.target_c_widths[5], "float": self.target_c_widths[6], "double": self.target_c_widths[7]},
+            "authorization": "inventory_only", "declarations": declarations,
+            "calls": calls, "non_call_references": escapes, "va_arg": va_arg})
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn not_located<T>(kind: T) -> Located<T> {
+        Located { loc: None, kind }
+    }
+
+    #[test]
+    fn closed_variadic_inventory_uses_promoted_ast_types_and_linker_identity() {
+        let mut ast = TypedAstContext::default();
+        let int = CQualTypeId::new(CTypeId(1));
+        let short = CQualTypeId::new(CTypeId(2));
+        let function = CTypeId(3);
+        ast.c_types.insert(int.ctype, not_located(CTypeKind::Int));
+        ast.c_types
+            .insert(short.ctype, not_located(CTypeKind::UShort));
+        ast.c_types.insert(
+            function,
+            not_located(CTypeKind::Function(
+                int,
+                vec![int],
+                true,
+                false,
+                true,
+                CCallingConvention::C,
+            )),
+        );
+        let declaration = CDeclId(1);
+        ast.linker_names.insert(declaration, "asm_format".into());
+        ast.target_c_widths = [8, 16, 32, 32, 64, 64, 32, 64];
+        ast.c_decls.insert(
+            declaration,
+            not_located(CDeclKind::Function {
+                is_global: true,
+                is_inline: false,
+                is_implicit: false,
+                is_extern: true,
+                is_inline_externally_visible: false,
+                typ: function,
+                name: "private_format".into(),
+                parameters: vec![],
+                body: None,
+                attrs: IndexSet::new(),
+            }),
+        );
+        ast.c_exprs.insert(
+            CExprId(1),
+            not_located(CExprKind::DeclRef(
+                CQualTypeId::new(function),
+                declaration,
+                LRValue::RValue,
+            )),
+        );
+        ast.c_exprs
+            .insert(CExprId(2), not_located(CExprKind::ImplicitValueInit(short)));
+        ast.c_exprs.insert(
+            CExprId(3),
+            not_located(CExprKind::ImplicitCast(
+                int,
+                CExprId(2),
+                CastKind::IntegralCast,
+                None,
+                LRValue::RValue,
+            )),
+        );
+        ast.c_exprs.insert(
+            CExprId(4),
+            not_located(CExprKind::Call(
+                int,
+                CExprId(1),
+                vec![CExprId(2), CExprId(3)],
+            )),
+        );
+        ast.c_types.insert(CTypeId(8), not_located(CTypeKind::Long));
+        ast.c_types
+            .insert(CTypeId(9), not_located(CTypeKind::Typedef(CDeclId(9))));
+        ast.source_typedef_types
+            .insert(CDeclId(9), CQualTypeId::new(CTypeId(8)));
+        assert_eq!(
+            ast.inventory_type(CQualTypeId::new(CTypeId(9)), 0)["canonical"]["kind"],
+            "Long"
+        );
+        let a = ast.closed_variadic_inventory(Path::new("caller.c"));
+        let b = ast.closed_variadic_inventory(Path::new("definition.c"));
+        assert_eq!(a["declarations"][0]["symbol"]["linker"], "asm_format");
+        assert_eq!(a["target_c_widths_bits"]["long"], 32);
+        assert_eq!(
+            a["declarations"][0]["symbol"],
+            b["declarations"][0]["symbol"]
+        );
+        assert_eq!(
+            a["calls"][0]["arguments"][1]["type"]["canonical"]["kind"],
+            "Int"
+        );
+        assert_eq!(
+            a["calls"][0]["arguments"][1]["promotion_chain"][1]["canonical"]["kind"],
+            "UShort"
+        );
+        assert_eq!(a["non_call_references"], json!([]));
+        ast.c_exprs.insert(
+            CExprId(5),
+            not_located(CExprKind::DeclRef(
+                CQualTypeId::new(function),
+                declaration,
+                LRValue::RValue,
+            )),
+        );
+        assert_eq!(
+            ast.closed_variadic_inventory(Path::new("caller.c"))["non_call_references"]
+                .as_array()
+                .unwrap()
+                .len(),
+            1
+        );
+        if let CDeclKind::Function { is_global, .. } =
+            &mut ast.c_decls.get_mut(&declaration).unwrap().kind
+        {
+            *is_global = false;
+        }
+        assert_ne!(
+            ast.closed_variadic_inventory(Path::new("caller.c"))["declarations"][0]["symbol"],
+            ast.closed_variadic_inventory(Path::new("definition.c"))["declarations"][0]["symbol"]
+        );
+    }
+}
