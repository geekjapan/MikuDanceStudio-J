+        ast.source_typedef_types.insert(CDeclId(93), array);
+        if let CDeclKind::Variable { typ, .. } = &mut ast.c_decls.get_mut(&cursor).unwrap().kind {
+            *typ = CQualTypeId::new(CTypeId(92));
+        }
+        ast.native_cursor_types.insert(cursor, (array, array, 5));
+        let facts = ast.cursor_declaration(cursor, &ast.cursor_declaration_owners());
+        let native = &facts["native_va_list"];
+        assert_eq!(facts["type_id"], 92);
+        assert_eq!(native["declared_type_id"], 91);
+        assert_eq!(native["builtin_type_id"], 91);
+        assert_eq!(native["target_kind"], 5);
+        for field in ["declared_canonical_type", "builtin_canonical_type"] {
+            assert_eq!(native[field]["volatile"], true);
+            assert_eq!(native[field]["canonical"]["length"], 1);
+            assert_eq!(native[field]["canonical"]["array"]["const"], true);
+            assert_eq!(native[field]["canonical"]["array"]["canonical"]["native_va_list_record"], 99);
+        }
+        ast.source_array_elements.remove(&CTypeId(91));
+        assert!(ast.cursor_declaration(cursor, &ast.cursor_declaration_owners())
+            ["native_va_list"]["declared_canonical_type"]["unproved"].is_string());
+        ast.c_exprs.insert(CExprId(90), not_located(CExprKind::DeclRef(builtin, cursor, LRValue::LValue)));
+        ast.c_exprs.insert(CExprId(91), not_located(CExprKind::Unary(int, CUnOp::AddressOf, CExprId(90), LRValue::RValue)));
+        ast.c_exprs.insert(CExprId(92), not_located(CExprKind::Binary(int, CBinOp::Assign,
+            CExprId(90), CExprId(91), None, None)));
+        assert_eq!(ast.cursor_expression(CExprId(90))["decl"], 90);
+        assert_eq!(ast.cursor_expression(CExprId(91))["operator"], "AddressOf");
+        assert_eq!(ast.cursor_expression(CExprId(92))["children"], json!([90, 91]));
+        assert_eq!(ast.cursor_expression(CExprId(92))["operator"], "Assign");
+
+    }
+}
