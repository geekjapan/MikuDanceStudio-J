+    fn cursor_required_relations_depth_is_per_root() {
+        fn normalize(value: &mut Value, mask: u64) {
+            match value {
+                Value::Object(object) => for (key, child) in object {
+                    if matches!(key.as_str(), "type_id" | "inner" | "declaration") && child.is_u64() {
+                        *child = json!(child.as_u64().unwrap() ^ mask);
+                    } else { normalize(child, mask); }
+                },
+                Value::Array(array) => for child in array { normalize(child, mask); },
+                _ => {}
+            }
+        }
+        let mut baseline = None;
+        for mask in [0u64, 20, 255] {
+            for reverse in [false, true] {
+                let mut ast = TypedAstContext::default();
+                let t = |id| CTypeId(id ^ mask);
+                let d = |id| CDeclId(id ^ mask);
+                let s = |id| CStmtId(id ^ mask);
+                let q = |id| CQualTypeId::new(t(id));
+                for id in 1..35 { ast.c_types.insert(t(id), not_located(CTypeKind::Paren(t(id + 1)))); }
+                ast.c_types.insert(t(35), not_located(CTypeKind::Void));
+                ast.c_types.insert(t(100), not_located(CTypeKind::Function(q(35), vec![], true, false, true, CCallingConvention::C)));
+                ast.c_decls.insert(d(60), not_located(CDeclKind::Function {
+                    is_global: true, is_inline: false, is_implicit: false, is_extern: true,
+                    is_inline_externally_visible: false, typ: t(100), name: "depth".into(),
+                    parameters: vec![], body: Some(s(60)), attrs: IndexSet::new(),
+                }));
+                ast.linker_names.insert(d(60), "depth".into());
+                for (decl, typ) in [(61, 1), (62, 20), (63, 2), (64, 3)] {
+                    ast.c_decls.insert(d(decl), not_located(CDeclKind::Variable {
+                        ident: format!("root_{typ}"), typ: q(typ), initializer: None, has_static_duration: false,
+                        has_thread_duration: false, is_externally_visible: false, is_defn: true, attrs: IndexSet::new(),
+                    }));
+                }
+                let mut declarations = vec![d(61), d(62), d(63), d(64)];
+                if reverse { declarations.reverse(); }
+                ast.c_stmts.insert(s(60), not_located(CStmtKind::Decls(declarations)));
+                let mut facts = ast.cursor_required_relations(Path::new("depth.c"), &ast.cursor_declaration_owners());
+                let roots = facts["roots"].as_array().unwrap();
+                assert!(roots.iter().find(|r| r["type_id"] == json!(t(1).0)).unwrap()["unproved"].is_string());
+                assert!(roots.iter().find(|r| r["type_id"] == json!(t(20).0)).unwrap().get("unproved").is_none());
+                assert!(roots.iter().find(|r| r["type_id"] == json!(t(2).0)).unwrap()["unproved"].is_string());
+                assert!(roots.iter().find(|r| r["type_id"] == json!(t(3).0)).unwrap().get("unproved").is_none());
+                assert!(facts["types"].as_array().unwrap().iter().all(|r| r.get("unproved").is_none()));
+                normalize(&mut facts, mask);
+                for table in ["roots", "types"] {
+                    facts[table].as_array_mut().unwrap().sort_by_key(|r| r["type_id"].as_u64());
+                }
+                if let Some(expected) = &baseline { assert_eq!(&facts, expected); }
+                else { baseline = Some(facts); }
+
+                ast.c_types.insert(t(100), not_located(CTypeKind::Function(q(20), vec![q(1)], true, false, true, CCallingConvention::C)));
+                let facts = ast.cursor_required_relations(Path::new("depth.c"), &ast.cursor_declaration_owners());
+                assert!(facts["roots"].as_array().unwrap().iter()
+                    .find(|r| r["type_id"] == json!(t(100).0)).unwrap()["unproved"].is_string());
+                ast.c_types.insert(t(35), not_located(CTypeKind::Paren(t(20))));
+                let facts = ast.cursor_required_relations(Path::new("depth.c"), &ast.cursor_declaration_owners());
+                assert!(facts["roots"].as_array().unwrap().iter().all(|r| r["unproved"].is_string()));
+            }
+        }
+    }
