     return offsetof(struct yield, mod[idx]);
 }
+
+typedef unsigned short row[3];
+struct matrix { char head; row mod[4]; };
+struct packed { char head; int mod[4]; } __attribute__((packed));
+struct aligned { char head; int mod[4]; } __attribute__((aligned(32)));
+struct flexible { unsigned long long head[2]; int mod[]; };
+struct element { unsigned long long wide; char tail; };
+struct elements { char head; struct element mod[4]; };
+typedef struct flexible alias;
+static unsigned int counter;
+static unsigned int next_index(void) { return counter++; }
+
+size_t offset_case(unsigned int which, long long idx) {
+    counter = 3;
+    switch (which) {
+        case 0: return offsetof(struct matrix, mod[idx]);
+        case 1: return offsetof(struct packed, mod[idx]);
+        case 2: return offsetof(struct aligned, mod[idx]);
+        case 3: return offsetof(struct flexible, mod[idx]);
+        case 4: return offsetof(alias, mod[(unsigned int)idx]);
+        case 5: return offsetof(alias, mod[(size_t)idx]);
+        case 6: return offsetof(struct elements, mod[idx]);
+        case 7: { size_t result = offsetof(alias, mod[counter++]); return result + counter; }
+        case 8: { size_t result = offsetof(alias, mod[next_index()]); return result + counter; }
+        case 9: (void)offsetof(alias, mod[counter++]); return counter;
+        case 10: (void)offsetof(alias, mod[next_index()]); return counter;
+        case 11: return (unsigned char)offsetof(alias, mod[idx]);
+        case 12: return offsetof(alias, mod[(unsigned int)idx * 8u]);
+    }
+    return 0;
+}
