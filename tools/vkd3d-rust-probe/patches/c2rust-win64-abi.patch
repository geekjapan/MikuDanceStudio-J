+typedef int (*callback)(void);
+static int yes(void) { return 7; }
+static callback file_callback;
+static callback const immutable_callback = yes;
+static callback const immutable_null = 0;
+static callback volatile volatile_callback;
+static int calls;
+static callback next(callback p) { ++calls; return p; }
+struct holder { callback fp; };
+static struct holder *next_holder(struct holder *p) { ++calls; return p; }
+int fp_volatile_local(int nonnull) {
+    callback volatile p = nonnull ? yes : 0;
+    return !!p;
+}
+int fp_volatile_static(int nonnull) {
+    (void)nonnull;
+    return !!volatile_callback;
+}
+int fp_const_volatile(int nonnull) {
+    callback const volatile p = nonnull ? yes : 0;
+    return !!p;
+}
+#define CHECK(p) do { \
+    out[i++] = (p) ? 1 : 0; \
+    out[i++] = !(p); out[i++] = !!(p); \
+    out[i++] = (p) == 0; out[i++] = 0 == (p); \
+    out[i++] = (p) != 0; out[i++] = 0 != (p); \
+    if (p) out[i++] = 1; else out[i++] = 0; \
+    if (!(p)) out[i++] = 1; else out[i++] = 0; \
+    if (!!(p)) out[i++] = 1; else out[i++] = 0; \
+    if ((p) == 0) out[i++] = 1; else out[i++] = 0; \
+    if (0 == (p)) out[i++] = 1; else out[i++] = 0; \
+    if ((p) != 0) out[i++] = 1; else out[i++] = 0; \
+    if (0 != (p)) out[i++] = 1; else out[i++] = 0; \
+} while (0)
+static int argument(callback p, int *out) {
+    int i = 0;
+    callback const local = p;
+    static callback block_callback;
+    struct holder h = {p};
+    callback array[1] = {p};
+    file_callback = p;
+    block_callback = p;
+    volatile_callback = p;
+    CHECK(p); CHECK(local); CHECK(file_callback); CHECK(block_callback);
+    CHECK(immutable_callback); CHECK(immutable_null); CHECK(h.fp); CHECK(array[0]);
+    out[i++] = fp_volatile_local(!!p);
+    out[i++] = fp_volatile_static(!!p);
+    out[i++] = fp_const_volatile(!!p);
+    calls = 0; out[i++] = !!next(p); out[i++] = calls;
+    calls = 0; out[i++] = !!next_holder(&h)->fp; out[i++] = calls;
+    int index = 0; out[i++] = !!array[index++]; out[i++] = index;
+    calls = 0; out[i++] = next(p) && next(p); out[i++] = calls;
+    calls = 0; out[i++] = next(p) || next(p); out[i++] = calls;
+    calls = 0; out[i++] = !next(p) && next(p); out[i++] = calls;
+    calls = 0; out[i++] = !next(p) || next(p); out[i++] = calls;
+    calls = 0; out[i++] = p ? !!next(p) : !!next(p); out[i++] = calls;
+    int result = 0;
+    while (p) { result = 1; break; } out[i++] = result;
+    result = 0; for (; p;) { result = 1; break; } out[i++] = result;
+    if (p) goto present;
+    out[i++] = 0; return i;
+present:
+    out[i++] = 1; return i;
+}
+int function_pointer_nulls(int nonnull, int *out) {
+    return argument(nonnull ? yes : 0, out);
+}
