+enum operand_type { OPERAND_INTEGER = 40, OPERAND_LARGE = 0x80000000u };
+enum signed_type { SIGNED_NEGATIVE = -7, SIGNED_POSITIVE = 13 };
+typedef enum signed_type signed_alias;
+
+static const enum operand_type *operands = (enum operand_type[]){OPERAND_INTEGER, 0, (enum operand_type)3, OPERAND_LARGE};
+static const signed_alias *signed_values = (signed_alias[]){SIGNED_NEGATIVE, 0, SIGNED_POSITIVE, (signed_alias)-3};
+static const int *integers = (int[]){OPERAND_INTEGER, 0, SIGNED_NEGATIVE, (int)SIGNED_POSITIVE};
+
+long long enum_array_probe(unsigned which) {
+    if (which < 4) return operands[which];
+    if (which < 8) return signed_values[which - 4];
+    if (which < 12) return integers[which - 8];
+    switch (which) {
+    case 12: return sizeof(enum operand_type);
+    case 13: return __alignof__(enum operand_type);
+    case 14: return sizeof(signed_alias);
+    case 15: return __alignof__(signed_alias);
+    case 16: return sizeof((enum operand_type[]){OPERAND_INTEGER, 0, (enum operand_type)3, OPERAND_LARGE});
+    case 17: return sizeof((signed_alias[]){SIGNED_NEGATIVE, 0, SIGNED_POSITIVE, (signed_alias)-3});
+    default: return -999;
+    }
+}
