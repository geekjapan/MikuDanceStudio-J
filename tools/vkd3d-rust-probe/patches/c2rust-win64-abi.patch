+use super::*;
+use crate::program::{command_identity, native_database_row, native_sources};
+
+use crate::test_config;
+
+struct NativeUnit { directory: Rc<tempfile::TempDir>, identity: UnitIdentity, ast: TypedAstContext, sources: BTreeMap<PathBuf, Vec<u8>> }
+
+fn native(text: &str, name: &str, flags: &[&str]) -> NativeUnit {
+    let directory = Rc::new(tempfile::tempdir().unwrap());
+    let source = directory.path().join(name);
+    std::fs::write(&source, text).unwrap();
+    native_in(directory, source, flags)
+}
+
+fn native_in(directory: Rc<tempfile::TempDir>, source: PathBuf, flags: &[&str]) -> NativeUnit {
+    let mut argv = vec!["clang".to_owned(), "-x".into(), "c".into(), "-std=gnu11".into()];
+    argv.extend(flags.iter().map(|s| s.to_string()));
+    argv.extend(["-c".into(), source.to_str().unwrap().into()]);
+    let row = serde_json::json!({"directory": directory.path(), "file": source, "arguments": argv});
+    let (key, command, source, effective) = command_identity(&row, &[], "test-link").unwrap();
+    let database = directory.path().join("compile_commands.json");
+    std::fs::write(&database, serde_json::to_vec(&vec![native_database_row(&effective)]).unwrap()).unwrap();
+    let (untyped, _, instance) = c2rust_ast_exporter::get_prepared_untyped_ast(&source, &database, &[], false, false).unwrap();
+    let conversion = ConversionContext::new(&source, &untyped);
+    assert!(!conversion.invalid_clang_ast, "legal native baseline must import");
+    let mut ast = conversion.into_typed_context();
+    ast.plan_instance = Some(instance.clone());
+    let sources = native_sources(&mut ast, &source, &effective, &[]).unwrap();
+    let identity = UnitIdentity { key, command, source, domain: "test-link".into(), ast_instance: instance,
+        target: ast.target.clone(), widths: ast.target_c_widths };
+    NativeUnit { directory, identity, ast, sources }
+}
+
+fn plan(units: &mut [NativeUnit]) -> ClosedVariadicPlan {
+    ClosedVariadicPlan::capture(units.iter_mut().map(|u| (&u.identity, &u.ast, std::mem::take(&mut u.sources)))).unwrap()
+}
+
+fn emit(plan: &ClosedVariadicPlan, unit: NativeUnit) -> String {
+    let mut config = test_config::config(c2rust_rust_tools::RustEdition::Edition2024);
+    config.emit_c_decl_map = false;
+    config.disable_rustfmt = true;
+    config.preserve_unused_functions = true;
+    config.diagnostic_common_plan = true;
+    let view = plan.bind(&unit.identity, &unit.ast).unwrap();
+    crate::translator::translate_bound(unit.ast, &config, &unit.identity.source, &IndexMap::new(), Some(view)).0
+}
+
+fn reasons(plan: &ClosedVariadicPlan, name: &str) -> BTreeSet<Blocker> {
+    plan.units.values().flat_map(|u| u.declarations.values()).filter(|d| d.name == name)
+        .flat_map(|d| d.blockers.iter().cloned()).collect()
+}
