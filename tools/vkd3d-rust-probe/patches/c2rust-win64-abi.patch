+use super::*;
+use serde_derive::Serialize;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Clone, Debug, Eq, PartialEq, Ord, PartialOrd, Serialize)]
+pub(crate) struct UnitKey(pub String);
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+struct DeclKey { unit: UnitKey, declaration: CDeclId }
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+struct CallKey { unit: UnitKey, expression: CExprId }
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+pub(crate) struct UnitIdentity {
+    pub key: UnitKey,
+    pub command: String,
+    pub domain: String,
+    pub source: PathBuf,
+    pub ast_instance: String,
+    pub target: String,
+    pub widths: [u64; 8],
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+pub(super) enum TypeIssue {
+    MissingType, MissingTypedef, Cycle, Depth, Attributed, MissingArrayElement,
+    MissingRecord, RecordScope, Unsupported, MissingCharSignedness,
+}
+
+pub(super) struct OriginalType {
+    pub typ: CQualTypeId,
+    pub path: Vec<CTypeId>,
+}
+
+pub(super) fn original_type(ast: &TypedAstContext, source: CQualTypeId) -> Result<OriginalType, (TypeIssue, Vec<CTypeId>)> {
+    let mut typ = source;
+    let mut path = Vec::new();
+    let mut seen = HashSet::new();
+    for _ in 0..32 {
+        path.push(typ.ctype);
+        if !seen.insert(typ.ctype) { return Err((TypeIssue::Cycle, path)); }
+        let row = ast.c_types.get(&typ.ctype).ok_or_else(|| (TypeIssue::MissingType, path.clone()))?;
+        match &row.kind {
+            CTypeKind::Typedef(id) => {
+                let original = ast.source_typedef_types.get(id).ok_or_else(|| (TypeIssue::MissingTypedef, path.clone()))?;
+                typ.qualifiers = typ.qualifiers.and(original.qualifiers);
+                typ.ctype = original.ctype;
+            }
+            CTypeKind::TypeOf(id) | CTypeKind::Paren(id) | CTypeKind::Elaborated(id)
+            | CTypeKind::Decayed(id) | CTypeKind::Auto(id) => typ.ctype = *id,
+            CTypeKind::Attributed(_, _) => return Err((TypeIssue::Attributed, path)),
+            _ => return Ok(OriginalType { typ, path }),
+        }
+    }
+    Err((TypeIssue::Depth, path))
+}
+
+impl TypeIssue {
+    pub(super) fn reason(&self) -> &'static str {
+        match self {
+            Self::Cycle => "typedef or wrapper cycle",
+            Self::Attributed => "attributed type facts",
+            Self::MissingTypedef => "missing original typedef",
+            Self::MissingType => "raw type missing",
+            _ => "unsupported type or wrapper limit",
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+struct TypeFact {
+    qualifiers: (bool, bool, bool),
+    shape: TypeShape,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+enum TypeShape {
+    Scalar(String, u64),
+    Pointer(Box<TypeFact>),
+    Function { result: Box<TypeFact>, parameters: Vec<TypeFact>, variadic: bool,
+        prototype: bool, noreturn: bool, abi: String },
+    Array(Box<TypeFact>, Option<usize>),
+    Record { identity: RecordIdentity, packed: bool, manual_alignment: Option<u64>, max_field_alignment: Option<u64>, size: u64, alignment: u64, fields: Vec<FieldFact> },
+    Unknown(TypeIssue),
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+struct FieldFact { typ: TypeFact, bitfield_width: Option<u64>, bit_offset: u64, type_bitwidth: u64, alignment: Option<u64> }
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize)]
+struct RecordIdentity {
+    kind: String, tag: Option<String>, file: String, line: u64, column: u64,
+    owner: Option<Box<RecordIdentity>>,
+}
+
+fn record_identity(e: &c2rust_ast_exporter::clang_ast::RecordEvidence, depth: usize) -> Result<RecordIdentity, TypeIssue> {
+    if depth > 32 || e.0 != 2 || e.8 || !Path::new(&e.3).is_absolute() || e.4 == 0 || e.5 == 0 {
+        return Err(TypeIssue::RecordScope);
+    }
+    let owner = match (e.6.as_str(), &e.7) {
+        ("file", None) => None,
+        ("record", Some(parent)) => Some(Box::new(record_identity(parent, depth + 1)?)),
+        _ => return Err(TypeIssue::RecordScope),
+    };
+    Ok(RecordIdentity { kind: e.1.clone(), tag: e.2.clone(), file: e.3.clone(),
+        line: e.4, column: e.5, owner })
+}
+
+fn type_fact(ast: &TypedAstContext, source: CQualTypeId, depth: usize) -> TypeFact {
+    type_fact_bounded(ast, source, depth, &mut 256)
+}
+
+fn type_fact_bounded(ast: &TypedAstContext, source: CQualTypeId, depth: usize, budget: &mut usize) -> TypeFact {
+    let unknown = |issue| TypeFact { qualifiers: (false, false, false), shape: TypeShape::Unknown(issue) };
+    if depth > 32 || *budget == 0 { return unknown(TypeIssue::Depth); }
+    *budget -= 1;
+    let resolved = match original_type(ast, source) { Ok(t) => t, Err((e, _)) => return unknown(e) };
+    let typ = resolved.typ;
+    let remaining = *budget;
+    let mut child = |q| type_fact_bounded(ast, q, depth + 1, budget);
+    let widths = ast.target_c_widths;
+    let shape = match &ast[typ.ctype].kind {
+        CTypeKind::Pointer(q) => TypeShape::Pointer(Box::new(child(*q))),
+        CTypeKind::Function(_, args, _, _, _, _) if args.len() > remaining => TypeShape::Unknown(TypeIssue::Depth),
+        CTypeKind::Function(ret, args, variadic, noreturn, prototype, abi) => TypeShape::Function {
+            result: Box::new(child(*ret)), parameters: args.iter().map(|q| child(*q)).collect(),
+            variadic: *variadic, prototype: *prototype, noreturn: *noreturn, abi: abi.as_str().into() },
+        CTypeKind::ConstantArray(_, len) => match ast.source_array_elements.get(&typ.ctype) {
+            Some(q) => TypeShape::Array(Box::new(child(*q)), Some(*len)),
+            None => TypeShape::Unknown(TypeIssue::MissingArrayElement),
+        },
+        CTypeKind::IncompleteArray(_) => match ast.source_array_elements.get(&typ.ctype) {
+            Some(q) => TypeShape::Array(Box::new(child(*q)), None),
+            None => TypeShape::Unknown(TypeIssue::MissingArrayElement),
+        },
+        CTypeKind::Struct(id) | CTypeKind::Union(id) => {
+            let identity = ast.record_evidence.get(id).ok_or(TypeIssue::MissingRecord)
+                .and_then(|e| record_identity(e, 0));
+            match (identity, &ast[*id].kind) {
+                (Ok(identity), CDeclKind::Struct { fields: Some(fields), .. })
+                | (Ok(identity), CDeclKind::Union { fields: Some(fields), .. }) => {
+                    if fields.len() > remaining { return unknown(TypeIssue::Depth); }
+                    let layout = ast.record_evidence[id].10;
+                    match layout {
+                        Some((packed, manual_alignment, max_field_alignment, size, alignment)) => {
+                            let fields = fields.iter().map(|f| match &ast[*f].kind {
+                                CDeclKind::Field { typ, bitfield_width, platform_bit_offset, platform_type_bitwidth, manual_alignment, .. } =>
+                                    FieldFact { typ: child(*typ), bitfield_width: *bitfield_width,
+                                        bit_offset: *platform_bit_offset, type_bitwidth: *platform_type_bitwidth,
+                                        alignment: *manual_alignment },
+                                _ => FieldFact { typ: unknown(TypeIssue::MissingRecord), bitfield_width: None,
+                                    bit_offset: 0, type_bitwidth: 0, alignment: None },
+                            }).collect();
+                            TypeShape::Record { identity, packed, manual_alignment, max_field_alignment, size, alignment, fields }
+                        }
+                        None => TypeShape::Unknown(TypeIssue::MissingRecord),
+                    }
+                }
+                (Err(e), _) => TypeShape::Unknown(e),
+                _ => TypeShape::Unknown(TypeIssue::MissingRecord),
+            }
+        }
+        CTypeKind::Char => match ast.source_char_signedness.get(&typ.ctype) {
+            Some(signed) => TypeShape::Scalar(format!("Char({signed})"), widths[0]),
+            None => TypeShape::Unknown(TypeIssue::MissingCharSignedness),
+        },
+        kind => {
+            let width = match kind {
+                CTypeKind::Void => Some(0),
+                CTypeKind::Bool | CTypeKind::SChar | CTypeKind::UChar => Some(widths[0]),
+                CTypeKind::Short | CTypeKind::UShort => Some(widths[1]),
+                CTypeKind::Int | CTypeKind::UInt => Some(widths[2]),
+                CTypeKind::Long | CTypeKind::ULong => Some(widths[3]),
+                CTypeKind::LongLong | CTypeKind::ULongLong => Some(widths[4]),
+                CTypeKind::Float => Some(widths[6]), CTypeKind::Double => Some(widths[7]),
+                _ => None,
+            };
+            match width { Some(w) => TypeShape::Scalar(format!("{kind:?}"), w),
+                None => TypeShape::Unknown(TypeIssue::Unsupported) }
+        }
+    };
+    TypeFact { qualifiers: (typ.qualifiers.is_const, typ.qualifiers.is_volatile, typ.qualifiers.is_restrict), shape }
+}
+
+fn has_unknown(t: &TypeFact) -> bool {
+    match &t.shape {
+        TypeShape::Unknown(_) => true,
+        TypeShape::Pointer(q) | TypeShape::Array(q, _) => has_unknown(q),
+        TypeShape::Function { result, parameters, .. } => has_unknown(result) || parameters.iter().any(has_unknown),
+        TypeShape::Record { fields, .. } => fields.iter().any(|field| has_unknown(&field.typ)),
+        _ => false,
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Ord, PartialOrd, Serialize)]
+enum SymbolKey {
+    External { domain: String, linker: String },
+    Internal { unit: UnitKey, name: String },
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Ord, PartialOrd, Serialize)]
+enum Blocker {
+    CursorDataflowUnproved, UnknownSignature, SignatureMismatch, MultipleDefinitions,
+    ExternalUnresolved, Exported, AliasUnresolved, AliasCycle, AddressEscape, IndirectCall,
+    ExportPolicyUnknown, CallOwnerUnproved, UnknownAttributes, MissingRedeclarationEvidence,
+}
+
+#[derive(Debug, Serialize)]
+enum Disposition { Existing, Deferred(BTreeSet<Blocker>) }
+
+#[derive(Debug, Serialize)]
+struct DeclFact {
+    id: u64, key: DeclKey, symbol: SymbolKey, name: String, signature: TypeFact, definition: bool,
+    aliases: Vec<String>, redeclarations: Vec<TypeFact>, visibility: Vec<(bool, String)>, native_attributes: Vec<String>, cursor_parameters: bool, blockers: BTreeSet<Blocker>,
+}
+
+#[derive(Debug, Serialize)]
+struct CallFact {
+    id: u64, key: CallKey, owner: Option<DeclKey>, callee_expression: u64, arguments: Vec<u64>, direct: Option<u64>,
+    promoted_arguments: Vec<TypeFact>, disposition: Disposition,
+}
+
+struct UnitFacts {
+    identity: UnitIdentity,
+    sources: BTreeMap<PathBuf, Vec<u8>>,
+    declarations: BTreeMap<CDeclId, DeclFact>,
+    calls: BTreeMap<CExprId, CallFact>,
+}
+
+pub(crate) struct ClosedVariadicPlan { units: BTreeMap<UnitKey, UnitFacts> }
+
+pub(crate) struct UnitPlan<'a> { facts: &'a UnitFacts }
+
+fn symbol(ast: &TypedAstContext, identity: &UnitIdentity, id: CDeclId) -> Result<SymbolKey, String> {
+    match &ast[id].kind {
+        CDeclKind::Function { is_global: true, .. } => Ok(SymbolKey::External {
+            domain: identity.domain.clone(),
+            linker: ast.linker_names.get(&id).ok_or("missing original linker identity")?.clone(),
+        }),
+        CDeclKind::Function { .. } => Ok(SymbolKey::Internal { unit: identity.key.clone(),
+            name: ast.linker_names.get(&id).ok_or("missing original static linker identity")?.clone() }),
+        _ => Err("function identity names a non-function".into()),
+    }
+}
+
+fn direct_callee(ast: &TypedAstContext, mut expr: CExprId, nodes: &mut HashSet<CExprId>) -> Option<CDeclId> {
+    loop {
+        nodes.insert(expr);
+        match ast[expr].kind {
+            CExprKind::Paren(_, inner) | CExprKind::ImplicitCast(_, inner, _, _, _) => expr = inner,
+            CExprKind::DeclRef(_, id, _) if matches!(ast[id].kind, CDeclKind::Function { .. }) => return Some(id),
+            _ => return None,
+        }
+    }
+}
+
+impl ClosedVariadicPlan {
+    pub(crate) fn capture<'a>(inputs: impl IntoIterator<Item = (&'a UnitIdentity, &'a TypedAstContext, BTreeMap<PathBuf, Vec<u8>>)>) -> Result<Self, String> {
+        let mut units = BTreeMap::new();
+        let mut target = None;
+        for (identity, ast, sources) in inputs {
+            if ast.plan_instance.as_deref() != Some(identity.ast_instance.as_str()) || ast.target != identity.target || ast.target_c_widths != identity.widths {
+                return Err("original AST instance or target binding differs".into());
+            }
+            let contract = (identity.target.clone(), identity.widths);
+            if identity.widths.contains(&0) || target.as_ref().is_some_and(|t| t != &contract) {
+                return Err("mixed or unresolved original target widths".into());
+            }
+            target = Some(contract);
+            let mut declarations = BTreeMap::new();
+            for (&id, decl) in &ast.c_decls {
+                if let CDeclKind::Function { typ, name, body, attrs, is_global, .. } = &decl.kind {
+                    let signature = type_fact(ast, CQualTypeId::new(*typ), 0);
+                    let cursor_parameters = ast.tys_of_params(match &decl.kind { CDeclKind::Function { parameters, .. } => parameters, _ => unreachable!() })
+                        .is_some_and(|params| params.iter().any(|p| ast.is_va_list(p.ctype)));
+                    let mut blockers = BTreeSet::new();
+                    if cursor_parameters { blockers.insert(Blocker::CursorDataflowUnproved); }
+                    if has_unknown(&signature) { blockers.insert(Blocker::UnknownSignature); }
+                    if *is_global { blockers.insert(Blocker::ExportPolicyUnknown); }
+                    if *is_global && body.is_some() { blockers.insert(Blocker::Exported); }
+                    let redeclarations = ast.source_function_types.get(&id).map(|types| types.iter().map(|q| match q {
+                        Some(q) => type_fact(ast, *q, 0),
+                        None => TypeFact { qualifiers: (false,false,false), shape: TypeShape::Unknown(TypeIssue::MissingType) },
+                    }).collect::<Vec<_>>()).unwrap_or_default();
+                    if redeclarations.is_empty() { blockers.insert(Blocker::MissingRedeclarationEvidence); }
+                    if redeclarations.is_empty() || redeclarations.iter().any(has_unknown) { blockers.insert(Blocker::UnknownSignature); }
+                    if redeclarations.iter().any(|t| t != &signature) { blockers.insert(Blocker::SignatureMismatch); }
+                    let visibility = ast.source_function_visibility.get(&id).cloned().unwrap_or_default();
+                    let native_attributes = ast.source_function_attribute_names.get(&id).cloned().unwrap_or_default();
+                    if native_attributes.iter().any(|a| !matches!(a.as_str(), "alias" | "always_inline" | "cold" | "fallthrough"
+                        | "__fallthrough__" | "gnu_inline" | "noinline" | "noreturn" | "notnull" | "nullable"
+                        | "packed" | "section" | "used" | "visibility")) { blockers.insert(Blocker::UnknownAttributes); }
+                    let original_attrs = ast.source_function_attrs.get(&id);
+                    let aliases = attrs.iter().chain(original_attrs.into_iter().flat_map(|set| set.iter())).filter_map(|a| if let Attribute::Alias(name) = a { Some(name.clone()) } else { None }).collect::<BTreeSet<_>>().into_iter().collect();
+                    declarations.insert(id, DeclFact { id: id.0, key: DeclKey { unit: identity.key.clone(), declaration: id }, symbol: symbol(ast, identity, id)?, name: name.clone(),
+                        signature, definition: body.is_some(), aliases, redeclarations, visibility, native_attributes, cursor_parameters, blockers });
+                }
+            }
+            let mut owners = HashMap::<CExprId, Option<CDeclId>>::new();
+            for (&id, decl) in &ast.c_decls {
+                if let CDeclKind::Function { body: Some(body), .. } = decl.kind {
+                    let mut pending = vec![SomeId::from(body)];
+                    let mut seen = HashSet::new();
+                    while let Some(node) = pending.pop() {
+                        if node.type_().is_some() || !seen.insert(node) { continue; }
+                        if let Some(declaration) = node.decl() {
+                            if !matches!(ast[declaration].kind, CDeclKind::Variable { .. }) { continue; }
+                        }
+                        if let Some(expression) = node.expr() {
+                            owners.entry(expression).and_modify(|owner| { if *owner != Some(id) { *owner = None; } }).or_insert(Some(id));
+                        }
+                        pending.extend(iterators::report_children(ast, node).1);
+                    }
+                }
+            }
+            let mut calls = BTreeMap::new();
+            let mut callee_nodes = HashSet::new();
+            for (&id, expr) in &ast.c_exprs {
+                if let CExprKind::Call(_, callee, args) = &expr.kind {
+                    let direct = direct_callee(ast, *callee, &mut callee_nodes);
+                    calls.insert(id, CallFact { id: id.0, key: CallKey { unit: identity.key.clone(), expression: id },
+                        owner: owners.get(&id).copied().flatten().map(|declaration| DeclKey { unit: identity.key.clone(), declaration }), callee_expression: callee.0,
+                        arguments: args.iter().map(|a| a.0).collect(), direct: direct.map(|d| d.0),
+                        promoted_arguments: args.iter().map(|a| expr_type_fact(ast, *a)).collect(),
+                        disposition: Disposition::Existing });
+                }
+            }
+            for (&id, expr) in &ast.c_exprs {
+                if let CExprKind::DeclRef(_, decl, _) = expr.kind {
+                    if !callee_nodes.contains(&id) {
+                        if let Some(f) = declarations.get_mut(&decl) { f.blockers.insert(Blocker::AddressEscape); }
+                    }
+                }
+            }
+            let key = identity.key.clone();
+            if units.insert(key, UnitFacts { identity: identity.clone(), sources, declarations, calls }).is_some() {
+                return Err("duplicate effective command in complete universe".into());
+            }
+        }
+        if units.is_empty() { return Err("empty complete command universe".into()); }
+        let mut plan = Self { units };
+        plan.close_symbols();
+        Ok(plan)
+    }
+
+    fn close_symbols(&mut self) {
+        let mut groups: BTreeMap<SymbolKey, Vec<(&UnitKey, CDeclId)>> = BTreeMap::new();
+        for (unit, facts) in &self.units {
+            for (id, f) in &facts.declarations { groups.entry(f.symbol.clone()).or_default().push((unit, *id)); }
+        }
+        let mut blocked: BTreeMap<SymbolKey, BTreeSet<Blocker>> = BTreeMap::new();
+        let mut edges = BTreeMap::<SymbolKey, BTreeSet<SymbolKey>>::new();
+        for (key, sites) in &groups {
+            let mut reasons = BTreeSet::new();
+            let first = &self.units[sites[0].0].declarations[&sites[0].1];
+            let mut definitions = 0;
+            for (unit, id) in sites {
+                let f = &self.units[*unit].declarations[id];
+                definitions += usize::from(f.definition);
+                reasons.extend(f.blockers.iter().cloned());
+                if f.signature != first.signature { reasons.insert(Blocker::SignatureMismatch); }
+                for alias in &f.aliases {
+                    let local = SymbolKey::Internal { unit: (*unit).clone(), name: alias.clone() };
+                    let external = SymbolKey::External { domain: self.units[*unit].identity.domain.clone(), linker: alias.clone() };
+                    let target = if groups.contains_key(&local) { local } else { external };
+                    if groups.contains_key(&target) { edges.entry(key.clone()).or_default().insert(target); }
+                    else { reasons.insert(Blocker::AliasUnresolved); }
+                }
+            }
+            if definitions == 0 { reasons.insert(Blocker::ExternalUnresolved); }
+            if definitions > 1 { reasons.insert(Blocker::MultipleDefinitions); }
+            if !matches!(first.signature.shape, TypeShape::Function { variadic: false, .. }) {
+                reasons.insert(Blocker::CursorDataflowUnproved);
+            }
+            blocked.insert(key.clone(), reasons);
+        }
+        for origin in groups.keys() {
+            let mut pending = edges.get(origin).cloned().unwrap_or_default();
+            let mut seen = BTreeSet::new();
+            while let Some(next) = pending.pop_first() {
+                if &next == origin { blocked.get_mut(origin).unwrap().insert(Blocker::AliasCycle); }
+                if seen.insert(next.clone()) { pending.extend(edges.get(&next).into_iter().flatten().cloned()); }
+            }
+        }
+        loop {
+            let previous = blocked.clone();
+            for (from, targets) in &edges {
+                for to in targets {
+                    blocked.get_mut(from).unwrap().extend(previous[to].iter().cloned());
+                    blocked.get_mut(to).unwrap().extend(previous[from].iter().cloned());
+                }
+            }
+            if blocked == previous { break; }
+        }
+        for facts in self.units.values_mut() {
+            for f in facts.declarations.values_mut() { f.blockers.extend(blocked[&f.symbol].iter().cloned()); }
+            for call in facts.calls.values_mut() {
+                call.disposition = match call.direct.and_then(|id| facts.declarations.get(&CDeclId(id))) {
+                    Some(f) if f.blockers.is_empty() => Disposition::Existing,
+                    Some(f) => Disposition::Deferred(f.blockers.clone()),
+                    None => Disposition::Deferred(BTreeSet::from([Blocker::IndirectCall])),
+                };
+                if call.owner.is_none() {
+                    match &mut call.disposition {
+                        Disposition::Deferred(reasons) => { reasons.insert(Blocker::CallOwnerUnproved); }
+                        Disposition::Existing => call.disposition = Disposition::Deferred(BTreeSet::from([Blocker::CallOwnerUnproved])),
+                    }
+                }
+            }
+        }
+    }
+
+    pub(crate) fn bind<'a>(&'a self, identity: &UnitIdentity, ast: &TypedAstContext) -> Result<UnitPlan<'a>, String> {
+        let facts = self.units.get(&identity.key).ok_or("unit outside complete plan")?;
+        if &facts.identity != identity || ast.plan_instance.as_deref() != Some(identity.ast_instance.as_str())
+            || ast.target != identity.target || ast.target_c_widths != identity.widths {
+            return Err("source/command/target/AST-instance binding differs".into());
+        }
+        for (id, f) in &facts.declarations {
+            let Some(decl) = ast.c_decls.get(id) else { return Err("original declaration missing".into()); };
+            let CDeclKind::Function { typ, .. } = decl.kind else { return Err("original declaration kind differs".into()); };
+            if f.signature != type_fact(ast, CQualTypeId::new(typ), 0) || f.symbol != symbol(ast, identity, *id)? {
+                return Err("original declaration binding differs".into());
+            }
+        }
+        for (id, call) in &facts.calls {
+            let Some(expr) = ast.c_exprs.get(id) else { return Err("original Call missing".into()); };
+            let CExprKind::Call(_, callee, args) = &expr.kind else { return Err("original Call kind differs".into()); };
+            if callee.0 != call.callee_expression || args.iter().map(|a| a.0).collect::<Vec<_>>() != call.arguments {
+                return Err("original Call binding differs".into());
+            }
+        }
+        let view = UnitPlan { facts };
+        view.verify_sources()?;
+        Ok(view)
+    }
+
+    pub(crate) fn verify_sources(&self) -> Result<(), String> {
+        for facts in self.units.values() { UnitPlan { facts }.verify_sources()?; }
+        Ok(())
+    }
+
+    pub(crate) fn report(&self) -> serde_json::Value {
+        serde_json::json!({"schema": 1, "status": "ClosedDiagnosticPlan", "lowering": "not_authorized",
+            "units": self.units.values().map(|u| serde_json::json!({"identity": u.identity,
+                "source_sha256": u.sources.iter().map(|(p,b)| (p.to_string_lossy().into_owned(), c2rust_ast_exporter::sha256(b))).collect::<BTreeMap<_,_>>(),
+                "native_ast_exports": 1, "typed_imports": 1,
+                "declarations": u.declarations.values().collect::<Vec<_>>(), "calls": u.calls.values().collect::<Vec<_>>()
+            })).collect::<Vec<_>>()})
+    }
+}
+
+fn expr_type_fact(ast: &TypedAstContext, id: CExprId) -> TypeFact {
+    match ast[id].kind.get_qual_type() {
+        Some(q) => type_fact(ast, q, 0),
+        None => TypeFact { qualifiers: (false, false, false), shape: TypeShape::Unknown(TypeIssue::MissingType) },
+    }
+}
+
+impl UnitPlan<'_> {
+    pub(crate) fn declaration(&self, id: CDeclId) {
+        let f = self.facts.declarations.get(&id).expect("closed plan missing authentic declaration ID");
+        assert_eq!(f.key, DeclKey { unit: self.facts.identity.key.clone(), declaration: id }, "closed plan declaration scope differs");
+        match if f.blockers.is_empty() { Disposition::Existing } else { Disposition::Deferred(f.blockers.clone()) } {
+            Disposition::Existing | Disposition::Deferred(_) => (),
+        }
+    }
+    pub(crate) fn call(&self, id: CExprId, callee: CExprId, args: &[CExprId]) {
+        let f = self.facts.calls.get(&id).expect("closed plan missing authentic enclosing Call ID");
+        assert_eq!(f.key, CallKey { unit: self.facts.identity.key.clone(), expression: id }, "closed plan Call scope differs");
+        assert_eq!(callee.0, f.callee_expression, "closed plan Call callee differs");
+        assert_eq!(args.iter().map(|a| a.0).collect::<Vec<_>>(), f.arguments, "closed plan Call arguments differ");
+        match &f.disposition { Disposition::Existing | Disposition::Deferred(_) => (), }
+    }
+    pub(crate) fn verify_sources(&self) -> Result<(), String> {
+        for (path, bytes) in &self.facts.sources {
+            if std::fs::read(path).map_err(|e| e.to_string())? != *bytes {
+                return Err(format!("source changed after native export: {}", path.display()));
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn read_source(&self, path: &Path) -> std::io::Result<Vec<u8>> {
+        let path = path.canonicalize()?;
+        self.facts.sources.get(&path).cloned().ok_or_else(|| std::io::Error::new(
+            std::io::ErrorKind::InvalidData, "source-map read outside original native buffers"))
+    }
+}
