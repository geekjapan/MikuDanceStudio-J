@@ -0,0 +1,45 @@
+use crate::stable_boundaries::{rust_stable_sync, rust_stable_atomic, rust_stable_alias_sync, rust_stable_alias_atomic};
+#[link(name = "test")]
+unsafe extern "C" {
+    fn stable_sync(x: *mut u32, value: u32) -> u32;
+    fn stable_atomic(x: *mut u32, value: u32) -> u32;
+    fn stable_alias_sync(x: *mut u32, value: u32) -> u32;
+    fn stable_alias_atomic(x: *mut u32, value: u32) -> u32;
+}
+#[test]
+fn stable_add_fetch_wraps_and_decrements() {
+    for initial in [0u32, 1, u32::MAX - 1, u32::MAX] {
+        for delta in [0u32, 1, 2, u32::MAX] {
+            unsafe {
+                let mut native = initial;
+                let mut rust = initial;
+                let expected = initial.wrapping_add(delta);
+                assert_eq!(stable_sync(&mut native, delta), expected);
+                assert_eq!(rust_stable_sync(&mut rust, delta), expected);
+                assert_eq!(native, rust);
+                assert_eq!(stable_atomic(&mut native, delta), expected.wrapping_add(delta));
+                assert_eq!(rust_stable_atomic(&mut rust, delta), expected.wrapping_add(delta));
+                assert_eq!(native, rust);
+            }
+        }
+    }
+}
+
+#[test]
+fn stable_stdint_add_fetch_wraps_and_decrements() {
+    for initial in [0u32, 1, u32::MAX - 1, u32::MAX] {
+        for delta in [0u32, 1, 2, u32::MAX] {
+            unsafe {
+                let mut native = initial;
+                let mut rust = initial;
+                let expected = initial.wrapping_add(delta);
+                assert_eq!(stable_alias_sync(&mut native, delta), expected);
+                assert_eq!(rust_stable_alias_sync(&mut rust, delta), expected);
+                assert_eq!(native, rust);
+                assert_eq!(stable_alias_atomic(&mut native, delta), expected.wrapping_add(delta));
+                assert_eq!(rust_stable_alias_atomic(&mut rust, delta), expected.wrapping_add(delta));
+                assert_eq!(native, rust);
+            }
+        }
+    }
+}
