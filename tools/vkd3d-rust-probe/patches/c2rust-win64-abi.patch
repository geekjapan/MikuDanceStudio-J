+    assert!(p.units.values().flat_map(|u|u.declarations.values()).any(|d| matches!(&d.symbol,
+        SymbolKey::External { linker,.. } if linker == "actual_linker")));
+    emit(&p,units.pop().unwrap());
+}
+
+#[test]
+fn closed_variadic_plan_alias_chain_propagates_export_and_escape() {
+    let mut units=vec![native("int target(int n,...){return n;} extern __typeof(target) middle __attribute__((alias(\"target\"))); extern __typeof(target) public_alias __attribute__((alias(\"middle\"))); void *escape(void){return (void*)public_alias;}","alias.c",&[])];
+    let p=plan(&mut units);
+    assert!(reasons(&p,"target").contains(&Blocker::AddressEscape));
+    assert!(reasons(&p,"public_alias").contains(&Blocker::Exported));
+    emit(&p,units.pop().unwrap());
+}
+
+#[test]
+fn closed_variadic_plan_alias_cycle_is_deferred_after_legal_native_baseline() {
+    let mut units=vec![native("int a(int n,...){return n;} int b(int n,...){return n;}","cycle.c",&[])];
+    for d in units[0].ast.c_decls.values_mut() {
+        if let CDeclKind::Function { name,attrs,.. }=&mut d.kind {
+            attrs.insert(Attribute::Alias(if name=="a" {"b"} else {"a"}.into()));
+        }
+    }
+    let p=plan(&mut units);
+    assert!(reasons(&p,"a").contains(&Blocker::AliasCycle));
+    assert!(reasons(&p,"b").contains(&Blocker::AliasCycle));
+    emit(&p,units.pop().unwrap());
+}
+
+#[test]
+fn closed_variadic_plan_signature_and_pointee_qualifier_mismatch() {
+    let mut units=vec![native("int f(const int *,...);", "a.c",&[]),
+        native("long f(int *n,...){return *n;}","b.c",&[])];
+    let p=plan(&mut units);
+    assert!(reasons(&p,"f").contains(&Blocker::SignatureMismatch));
