+#[test]
+fn closed_variadic_plan_caller_before_definition_binds_actual_emission() {
+    let caller = native("int target(int,...); int caller(void){return target(1,2);}", "caller.c", &[]);
+    let definition = native("int target(int n,...){return n;}", "definition.c", &[]);
+    let mut units = vec![caller, definition];
+    let p = plan(&mut units);
+    assert!(!reasons(&p, "target").contains(&Blocker::ExternalUnresolved));
+    for u in units { assert!(emit(&p,u).contains("target")); }
+}
