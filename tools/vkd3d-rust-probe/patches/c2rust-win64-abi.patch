+pub fn sha256(data: &[u8]) -> String {
+    extern "C" { fn c2rust_sha256(data: *const u8, size: usize, output: *mut u8); }
+    let mut output = [0u8; 32];
+    unsafe { c2rust_sha256(data.as_ptr(), data.len(), output.as_mut_ptr()); }
+    output.iter().map(|b| format!("{b:02x}")).collect()
