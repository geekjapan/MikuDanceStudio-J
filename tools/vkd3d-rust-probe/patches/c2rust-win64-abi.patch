+class FormatLocations : public RecursiveASTVisitor<FormatLocations> {
+    ASTContext &context;
+    std::map<std::string, llvm::json::Object> rows;
+    llvm::json::Object position(SourceRange range, bool spelling) {
+        auto &sm = context.getSourceManager();
+        auto begin = spelling ? sm.getSpellingLoc(range.getBegin()) : sm.getExpansionLoc(range.getBegin());
+        auto end = spelling ? sm.getSpellingLoc(range.getEnd()) : sm.getExpansionLoc(range.getEnd());
+        if (begin.isInvalid() || end.isInvalid() || sm.getFileID(begin) != sm.getFileID(end))
+            return {{"unproved", "invalid or cross-buffer native range"}};
+        end = Lexer::getLocForEndOfToken(end, 0, sm, context.getLangOpts());
+        if (end.isInvalid()) return {{"unproved", "invalid end of token"}};
+        bool invalid = false;
+        auto bytes = sm.getBufferData(sm.getFileID(begin), &invalid);
+        auto first = sm.getFileOffset(begin), last = sm.getFileOffset(end);
+        if (invalid || first > last || last > bytes.size())
+            return {{"unproved", "invalid native token interval"}};
+        auto data = llvm::ArrayRef<uint8_t>(reinterpret_cast<const uint8_t *>(bytes.data()), bytes.size());
+        auto quoted = data.slice(first, last - first);
+        auto *entry = sm.getFileEntryForID(sm.getFileID(begin));
+        return {{"path", entry ? entry->tryGetRealPathName().str() : ""},
+            {"buffer_sha256", llvm::toHex(llvm::SHA256::hash(data), true)},
+            {"begin", int64_t(first)}, {"end", int64_t(last)}, {"bytes_hex", llvm::toHex(quoted, true)}};
+    }
+    void record(const void *id, SourceRange range) {
+        auto key = std::to_string(reinterpret_cast<uintptr_t>(id));
+        if (rows.count(key)) return;
+        auto presumed = context.getSourceManager().getPresumedLoc(range.getBegin());
+        rows.emplace(key, llvm::json::Object{{"spelling", position(range, true)},
+            {"expansion", position(range, false)},
+            {"presumed", llvm::json::Object{{"path", presumed.isValid() ? presumed.getFilename() : ""},
+                {"line", int64_t(presumed.isValid() ? presumed.getLine() : 0)}}}});
+    }
+    void statements(Stmt *stmt) {
+        if (!stmt) return;
+        record(stmt, stmt->getSourceRange());
+        if (auto *decls = dyn_cast<DeclStmt>(stmt))
+            for (auto *decl : decls->decls()) record(decl, decl->getSourceRange());
+        for (auto *child : stmt->children()) statements(child);
+    }
+    bool relevant(const FunctionDecl *decl) {
+        if (!decl) return false;
+        if (decl->isVariadic()) return true;
+        for (const auto *parameter : decl->parameters())
+            if (context.hasSameType(parameter->getOriginalType(), context.getBuiltinVaListType()) ||
+                context.hasSameType(parameter->getType(), context.getAdjustedParameterType(context.getBuiltinVaListType())))
+                return true;
+        return false;
+    }
+  public:
+    explicit FormatLocations(ASTContext &context) : context(context) {}
+    bool VisitFunctionDecl(FunctionDecl *decl) {
+        if (relevant(decl)) {
+            record(decl, decl->getSourceRange());
+            for (const auto *parameter : decl->parameters()) record(parameter, parameter->getSourceRange());
+            statements(decl->getBody());
+        }
+        return true;
+    }
+    bool VisitCallExpr(CallExpr *call) {
+        if (relevant(call->getDirectCallee())) statements(call);
+        return true;
+    }
+    llvm::json::Object collect() {
+        TraverseDecl(context.getTranslationUnitDecl());
+        llvm::json::Object result;
+        for (auto &row : rows) result[row.first] = std::move(row.second);
+        return result;
+    }
+};
+// LLVM 18 SourceManager.h: getBufferIfLoaded never opens or refreshes a file.
+class CursorInputs {
+    struct Buffer {
+        std::string bytes, identifier, role, physical;
+        std::set<std::string> aliases, lexer_file_ids;
+        uint64_t device = 0, file = 0;
+        bool lexed = false;
+    };
+    std::map<const SrcMgr::ContentCache *, Buffer> buffers;
+    std::set<std::string> unsupported;
+    std::map<const FileEntry *, std::set<std::string>> aliases;
+    llvm::json::Array lexerEvents;
+    CompilerInstance &CI;
+    std::vector<std::string> argv;
+
+  public:
+    CursorInputs(CompilerInstance &CI, const std::vector<std::string> &argv)
+        : CI(CI), argv(argv) {}
+
+    void observe(const SrcMgr::ContentCache &cache, llvm::StringRef role,
+                 bool lexed, llvm::StringRef alias = {}) {
+        auto loaded = cache.getBufferIfLoaded();
+        if (!loaded) {
+            if (lexed) unsupported.insert("lexed_buffer_not_loaded");
+            return;
+        }
+        if (cache.IsBufferInvalid || cache.BufferOverridden ||
+            cache.OrigEntry != cache.ContentsEntry)
+            unsupported.insert("invalid_or_overridden_buffer");
+        auto text = loaded->getBuffer();
+        auto it = buffers.find(&cache);
+        if (it == buffers.end()) {
+            Buffer b;
+            b.bytes = text.str();
+            b.identifier = loaded->getBufferIdentifier().str();
+            b.role = role.str();
+            if (cache.OrigEntry) {
+                b.physical = cache.OrigEntry->getFileEntry().tryGetRealPathName().str();
+                auto uid = cache.OrigEntry->getFileEntry().getUniqueID();
+                b.device = uid.getDevice(); b.file = uid.getFile();
+                b.aliases.insert(cache.OrigEntry->getName().str());
+                if (b.physical.empty()) unsupported.insert("missing_physical_path");
+            } else if (role != "predefines" && role != "scratch") {
+                unsupported.insert("unknown_nonfile_buffer");
+            }
+            it = buffers.emplace(&cache, std::move(b)).first;
+        } else if (it->second.bytes != text) {
+            unsupported.insert("cached_buffer_changed");
+        }
+        if (cache.OrigEntry) {
+            const auto &known = aliases[&cache.OrigEntry->getFileEntry()];
+            it->second.aliases.insert(known.begin(), known.end());
+            if (!alias.empty()) it->second.aliases.insert(alias.str());
+            if (!cache.Filename.empty()) it->second.aliases.insert(cache.Filename.str());
+        }
+        if (role == "main" || role == "predefines") it->second.role = role.str();
+        it->second.lexed |= lexed;
+    }
+
+    void markMultipleInvocation() { unsupported.insert("multiple_native_invocations"); }
+
+    void included(OptionalFileEntryRef file) {
+        if (!file) return;
+        auto &names = aliases[&file->getFileEntry()];
+        names.insert(file->getName().str());
+        names.insert(file->getNameAsRequested().str());
+    }
+
+    void changed(FileID id, PPCallbacks::LexedFileChangeReason reason,
+                 SrcMgr::CharacteristicKind characteristic) {
+        lexerEvents.push_back(llvm::json::Object{
+            {"file_id", std::to_string(id.getHashValue())},
+            {"reason", reason == PPCallbacks::LexedFileChangeReason::EnterFile ? "enter" : "exit"},
+            {"characteristic", int64_t(characteristic)}});
+        if (reason != PPCallbacks::LexedFileChangeReason::EnterFile) return;
+        auto &sm = CI.getSourceManager();
+        bool invalid = false;
+        const auto &entry = sm.getSLocEntry(id, &invalid);
+        if (invalid || !entry.isFile()) { unsupported.insert("invalid_lexed_file"); return; }
+        auto role = id == sm.getMainFileID() ? "main" :
+            id == CI.getPreprocessor().getPredefinesFileID() ? "predefines" : "file";
+        const auto &cache = entry.getFile().getContentCache();
+        observe(cache, role, true);
+        auto found = buffers.find(&cache);
+        if (found != buffers.end()) found->second.lexer_file_ids.insert(std::to_string(id.getHashValue()));
+    }
+
+    std::string encode() {
+        auto &sm = CI.getSourceManager();
+        auto &pp = CI.getPreprocessor();
+        const auto &opts = CI.getPreprocessorOpts();
+        const auto &front = CI.getFrontendOpts();
+        if (sm.loaded_sloc_entry_size() || CI.getASTContext().getExternalSource() || pp.getExternalSource())
+            unsupported.insert("external_ast_or_preprocessor");
+        if (!opts.ImplicitPCHInclude.empty() || !opts.ChainedIncludes.empty() ||
+            opts.PrecompiledPreambleBytes.first || opts.GeneratePreamble ||
+            !opts.PCHThroughHeader.empty() || opts.PCHWithHdrStop || opts.PCHWithHdrStopCreate)
+            unsupported.insert("pch_or_preamble");
+        if (CI.getLangOpts().Modules) unsupported.insert("modules");
+        if (!CI.getHeaderSearchOpts().VFSOverlayFiles.empty() ||
+            !opts.RemappedFiles.empty() || !opts.RemappedFileBuffers.empty())
+            unsupported.insert("vfs_overlay_or_remap");
+        if (opts.SingleFileParseMode || opts.DependencyDirectivesForFile)
+            unsupported.insert("partial_preprocessing");
+        if (front.Inputs.size() != 1) unsupported.insert("multiple_inputs");
+        for (const auto &input : front.Inputs)
+            if (!input.isFile() || input.getFile() == "-" || input.isPreprocessed() ||
+                input.getKind().getFormat() != InputKind::Source ||
+                input.getKind().getLanguage() != Language::C)
+                unsupported.insert("unsupported_input_kind");
+        if (CI.getDiagnostics().hasErrorOccurred()) unsupported.insert("diagnostic_error");
+        for (unsigned i = 1; i < sm.local_sloc_entry_size(); ++i) {
+            const auto &entry = sm.getLocalSLocEntry(i);
+            if (!entry.isFile()) continue;
+            const auto &cache = entry.getFile().getContentCache();
+            auto loaded = cache.getBufferIfLoaded();
+            if (!loaded) continue;
+            auto role = loaded->getBufferIdentifier() == "<scratch space>" ? "scratch" : "file";
+            observe(cache, role, false);
+        }
+        for (auto i = sm.fileinfo_begin(); i != sm.fileinfo_end(); ++i)
+            observe(*i->second, "file", false, i->first.getName());
+        llvm::json::Array entries;
+        for (const auto &item : buffers) {
+            const auto &b = item.second;
+            if (!b.lexed && b.role != "scratch") unsupported.insert("loaded_buffer_without_lexer_callback");
+            llvm::json::Array aliases, lexerIds;
+            for (const auto &a : b.aliases) aliases.push_back(a);
+            for (const auto &id : b.lexer_file_ids) lexerIds.push_back(id);
+            auto data = llvm::ArrayRef<uint8_t>(reinterpret_cast<const uint8_t *>(b.bytes.data()), b.bytes.size());
+            entries.push_back(llvm::json::Object{
+                {"role", b.role}, {"identifier", b.identifier}, {"physical_path", b.physical},
+                {"aliases", std::move(aliases)}, {"native_device", std::to_string(b.device)},
+                {"native_file", std::to_string(b.file)}, {"length", int64_t(b.bytes.size())},
+                {"bytes_hex", llvm::toHex(data, true)},
+                {"sha256", llvm::toHex(llvm::SHA256::hash(data), true)}, {"lexed", b.lexed},
+                {"lexer_file_ids", std::move(lexerIds)}});
+        }
+        llvm::json::Array args, cc1, errors, features, writtenFeatures;
+        for (const auto &a : argv) args.push_back(a);
+        CI.getInvocation().generateCC1CommandLine([&](const Twine &a) { cc1.push_back(a.str()); });
+        for (const auto &error : unsupported) errors.push_back(error);
+        const auto &target = CI.getTargetOpts();
+        for (const auto &f : target.Features) features.push_back(f);
+        for (const auto &f : target.FeaturesAsWritten) writtenFeatures.push_back(f);
+        auto cwd = CI.getFileManager().getVirtualFileSystem().getCurrentWorkingDirectory();
+        if (!cwd) errors.push_back("missing_cwd");
+        if (CI.getHeaderSearchOpts().ResourceDir.empty() ||
+            std::none_of(argv.begin(), argv.end(), [](const std::string &a) {
+                return a == "-resource-dir" || StringRef(a).starts_with("-resource-dir=");
+            })) errors.push_back("missing_explicit_resource_directory");
+        llvm::json::Object result{
+            {"format_locations", FormatLocations(CI.getASTContext()).collect()},
+            {"schema", 2}, {"main_input", sm.getFileEntryForID(sm.getMainFileID()) ? sm.getFileEntryForID(sm.getMainFileID())->tryGetRealPathName().str() : ""},
+            {"cwd", cwd ? *cwd : ""}, {"adjusted_driver_argv", std::move(args)},
+            {"regenerated_cc1_argv", std::move(cc1)}, {"target", CI.getTarget().getTriple().str()},
+            {"cpu", target.CPU}, {"abi", target.ABI}, {"features", std::move(features)},
+            {"features_as_written", std::move(writtenFeatures)},
+            {"vfs", "clangtool_empty_overlay_on_real_filesystem"},
+            {"unsupported", std::move(errors)}, {"buffers", std::move(entries)},
+            {"lexer_events", std::move(lexerEvents)}};
+        std::string encoded;
+        llvm::raw_string_ostream out(encoded); out << llvm::json::Value(std::move(result)); out.flush();
+        return encoded;
+    }
+};
