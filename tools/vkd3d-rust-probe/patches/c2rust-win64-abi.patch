+class CursorInputCallbacks : public PPCallbacks {
+    std::shared_ptr<CursorInputs> inputs;
+  public:
+    explicit CursorInputCallbacks(std::shared_ptr<CursorInputs> inputs) : inputs(std::move(inputs)) {}
+    void LexedFileChanged(FileID id, LexedFileChangeReason reason,
+                          SrcMgr::CharacteristicKind characteristic, FileID, SourceLocation) override {
+        inputs->changed(id, reason, characteristic);
+    }
+    void InclusionDirective(SourceLocation, const Token &, StringRef, bool,
+                            CharSourceRange, OptionalFileEntryRef file, StringRef,
+                            StringRef, const clang::Module *, SrcMgr::CharacteristicKind) override {
+        inputs->included(file);
+    }
+    void FileSkipped(const FileEntryRef &file, const Token &, SrcMgr::CharacteristicKind) override {
+        inputs->included(file);
+    }
+};
