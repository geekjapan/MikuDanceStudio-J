+use crate::*;
+use crate::c_ast::closed_plan::{ClosedVariadicPlan, UnitIdentity, UnitKey};
+use crate::compile_cmds::LinkCmd;
+use std::collections::{BTreeMap, BTreeSet};
+
+struct OutputTransaction {
+    temporary: TempDir,
+    staged: PathBuf,
+    destination: PathBuf,
+}
+
+impl OutputTransaction {
+    fn new(tcfg: &mut TranspilerConfig) -> Result<Self, Error> {
+        if !cfg!(target_os = "linux") {
+            return Err(format_err!("common plan publication currently requires Linux renameat2"));
+        }
+        if !tcfg.fail_on_error || tcfg.postprocess || tcfg.reorganize_definitions
+            || tcfg.c2rust_dir.as_ref().is_some_and(|p| !p.is_absolute()) {
+            return Err(format_err!("common plan requires fail-on-error and no postprocess/refactoring/relative dependency paths"));
+        }
+        let requested = tcfg.output_dir.as_ref().ok_or_else(|| format_err!("common plan requires a new output directory"))?;
+        let name = requested.file_name().ok_or_else(|| format_err!("invalid output root"))?;
+        let parent = requested.parent().filter(|p| !p.as_os_str().is_empty()).unwrap_or(Path::new(".")).canonicalize()?;
+        let destination = parent.join(name);
+        if destination.symlink_metadata().is_ok() { return Err(format_err!("common plan refuses an existing output root")); }
+        let temporary = tempfile::Builder::new().prefix(".c2rust-plan-").tempdir_in(&parent)?;
+        let staged = temporary.path().join(name);
+        tcfg.output_dir = Some(staged.clone());
+        Ok(Self { temporary, staged, destination })
+    }
+
+    fn publish(self) -> Result<(), Error> {
+        #[cfg(target_os = "linux")]
+        {
+            use std::ffi::CString;
+            use std::os::unix::ffi::OsStrExt;
+            extern "C" { fn renameat2(oldfd: i32, old: *const std::ffi::c_char, newfd: i32, new: *const std::ffi::c_char, flags: u32) -> i32; }
+            let from = CString::new(self.staged.as_os_str().as_bytes())?;
+            let to = CString::new(self.destination.as_os_str().as_bytes())?;
+            if unsafe { renameat2(-100, from.as_ptr(), -100, to.as_ptr(), 1) } != 0 {
+                return Err(std::io::Error::last_os_error().into());
+            }
+            drop(self.temporary);
+            Ok(())
+        }
+        #[cfg(not(target_os = "linux"))]
+        Err(format_err!("unsupported atomic publication layout"))
+    }
+}
+
+struct PreparedUnit {
+    identity: UnitIdentity,
+    ast: TypedAstContext,
+    preprocessed: Option<String>,
+}
+
+pub(crate) struct PreparedProgram {
+    units: BTreeMap<UnitKey, PreparedUnit>,
+    emission: BTreeMap<(PathBuf, Option<String>, Vec<String>), UnitKey>,
+    plan: ClosedVariadicPlan,
+    transaction: OutputTransaction,
+}
+
+pub(crate) fn command_identity(row: &serde_json::Value, extra: &[&str], domain: &str) -> Result<(UnitKey, String, PathBuf, serde_json::Value), Error> {
+    let directory = Path::new(row["directory"].as_str().ok_or_else(|| format_err!("missing command directory"))?).canonicalize()?;
+    let source = Path::new(row["file"].as_str().ok_or_else(|| format_err!("missing command file"))?);
+    let source = directory.join(source).canonicalize()?;
+    let args = row["arguments"].as_array().ok_or_else(|| format_err!("common plan requires explicit arguments, not shell command strings"))?;
+    if args.is_empty() || args.iter().any(|a| a.as_str().is_none_or(|a| a == "--" || a.starts_with('@'))) || !row["command"].is_null() {
+        return Err(format_err!("unresolved or ambiguous effective command"));
+    }
+    let row = serde_json::json!({"directory": directory, "file": source, "arguments": args, "output": row["output"]});
+    let command = c2rust_ast_exporter::sha256(&serde_json::to_vec(&serde_json::json!({"command": row, "extra": extra}))?);
+    let key = UnitKey(c2rust_ast_exporter::sha256(&serde_json::to_vec(&serde_json::json!({"command": command, "domain": domain}))?));
+    Ok((key, command, source, row))
+}
+
+pub(crate) fn native_database_row(effective: &serde_json::Value) -> serde_json::Value {
+    let mut row = effective.clone();
+    if row["output"].is_null() { row.as_object_mut().unwrap().remove("output"); }
+    row
+}
+
+pub(crate) fn native_sources(ast: &mut TypedAstContext, source: &Path, effective: &serde_json::Value, extra: &[&str]) -> Result<BTreeMap<PathBuf, Vec<u8>>, Error> {
+    let raw = ast.cursor_inputs.take().ok_or_else(|| format_err!("missing native input capture"))?;
+    crate::native_intake::capture(&raw, ast, source, effective, extra)
+}
+
+impl PreparedProgram {
+    fn prepare(tcfg: &TranspilerConfig, cc_db: &Path, links: &[LinkCmd], extra: &[&str], transaction: OutputTransaction) -> Result<Self, Error> {
+        if tcfg.emit_closed_format_facts || tcfg.emit_cursor_witness {
+            return Err(format_err!("common plan does not retain per-unit raw debug reports; use a separate report-only run"));
+        }
+        let rows: Vec<serde_json::Value> = serde_json::from_slice(&fs::read(cc_db)?)?;
+        if rows.is_empty() || rows.iter().any(|r| r["file"].as_str().is_none_or(|s|
+            s.starts_with("/c2rust/link/") || s.ends_with(".s") || s.ends_with(".S"))) {
+            return Err(format_err!("common plan requires an explicit C-only compilation universe; encoded link and assembly rows are unsupported"));
+        }
+        let isolated = tempfile::tempdir()?;
+        let database = isolated.path().join("compile_commands.json");
+        let mut units = BTreeMap::new();
+        let mut emission = BTreeMap::new();
+        let mut snapshots = BTreeMap::new();
+        let mut admitted = BTreeSet::new();
+        for link in links {
+            let domain = c2rust_ast_exporter::sha256(&serde_json::to_vec(&serde_json::json!({
+                "output": link.output, "libraries": link.libs, "library_paths": link.lib_dirs,
+                "kind": format!("{:?}", link.r#type), "top_level": link.top_level,
+                "export_policy": "unknown_external_visibility_blocks_lowering"
+            }))?);
+            for cmd in &link.cmd_inputs {
+                let source = cmd.abs_file().canonicalize()?;
+                let candidates = rows.iter().enumerate().filter(|(_, row)| {
+                    let directory = row["directory"].as_str().map(Path::new);
+                    let file = row["file"].as_str().map(Path::new);
+                    match (directory, file) {
+                        (Some(d), Some(f)) => d.join(f).canonicalize().ok().as_ref() == Some(&source)
+                            && row["output"].as_str() == cmd.output.as_deref()
+                            && row["arguments"] == serde_json::json!(cmd.arguments),
+                        _ => false,
+                    }
+                }).collect::<Vec<_>>();
+                if candidates.len() != 1 { return Err(format_err!("ambiguous command intake for {}", source.display())); }
+                let (index, row) = candidates[0];
+                if !admitted.insert(index) { return Err(format_err!("duplicate command membership")); }
+                let (_, command, source, effective) = command_identity(row, extra, &domain)?;
+                fs::write(&database, serde_json::to_vec(&vec![native_database_row(&effective)])?)?;
+                let (mut ast, preprocessed, instance) = prepare_single(tcfg, &source, &database, extra, None)
+                    .map_err(|_| format_err!("common plan native preparation failed"))?;
+                let instance = instance.expect("prepared native AST digest");
+                ast.plan_instance = Some(instance.clone());
+                let sources = native_sources(&mut ast, &source, &effective, extra)?;
+                ast.format_locations = None;
+                let source_seal = sources.iter().map(|(p,b)| (p.to_string_lossy().into_owned(), c2rust_ast_exporter::sha256(b))).collect::<BTreeMap<_,_>>();
+                let key = UnitKey(c2rust_ast_exporter::sha256(&serde_json::to_vec(&serde_json::json!({
+                    "command": command, "domain": domain, "target": ast.target, "widths": ast.target_c_widths,
+                    "sources": source_seal
+                }))?));
+                let identity = UnitIdentity { key: key.clone(), command, domain: domain.clone(), source: source.clone(),
+                    ast_instance: instance, target: ast.target.clone(), widths: ast.target_c_widths };
+                snapshots.insert(key.clone(), sources);
+                if emission.insert((source, cmd.output.clone(), cmd.arguments.clone()), key.clone()).is_some()
+                    || units.insert(key, PreparedUnit { identity, ast, preprocessed }).is_some() {
+                    return Err(format_err!("duplicate effective command or emission identity"));
+                }
+            }
+        }
+        if admitted.len() != rows.len() { return Err(format_err!("incomplete semantic command intake")); }
+        let plan = ClosedVariadicPlan::capture(units.iter().map(|(key,u)|
+            (&u.identity, &u.ast, snapshots.remove(key).expect("prepared source snapshot"))))
+            .map_err(|e| format_err!("common plan: {e}"))?;
+        for unit in units.values() { plan.bind(&unit.identity, &unit.ast).map_err(|e| format_err!("common plan: {e}"))?; }
+        let root = tcfg.output_dir.as_ref().unwrap();
+        fs::create_dir_all(root)?;
+        fs::write(root.join("closed-variadic-plan.json"), serde_json::to_vec_pretty(&plan.report())?)?;
+        println!("COMMON_PLAN_CLOSED {}", units.len());
+        Ok(Self { units, emission, plan, transaction })
+    }
+
+    fn commit(self) -> Result<(), Error> {
+        self.plan.verify_sources().map_err(|e| format_err!("common plan source consistency before publication: {e}"))?;
+        self.transaction.publish()
+    }
+
+    fn emit_and_publish(mut self, tcfg: &TranspilerConfig, cc_db: &Path, links: &[LinkCmd], extra: &[&str]) -> Result<(), Error> {
+        crate::transpile_impl(tcfg, cc_db, links, extra, Some(&mut self));
+        self.commit()
+    }
+
+    pub(crate) fn run(mut tcfg: TranspilerConfig, cc_db: &Path, extra: &[&str]) -> Result<(), Error> {
+        let transaction = OutputTransaction::new(&mut tcfg)?;
+        let (links, clang_args) = crate::transpile_inputs(&tcfg, cc_db, extra);
+        let clang_args = clang_args.iter().map(String::as_str).collect::<Vec<_>>();
+        Self::prepare(&tcfg, cc_db, &links, &clang_args, transaction)?
+            .emit_and_publish(&tcfg, cc_db, &links, &clang_args)
+    }
+
+    pub(crate) fn emit(&mut self, tcfg: &TranspilerConfig, cmd: &CompileCmd, ancestor: &Path, build: &Path) -> TranspileResult {
+        let source = cmd.abs_file().canonicalize().expect("prepared input source");
+        let key = self.emission.get(&(source.clone(), cmd.output.clone(), cmd.arguments.clone())).expect("selected command outside prepared universe");
+        let unit = self.units.remove(key).expect("prepared context consumed more than once");
+        let bound = self.plan.bind(&unit.identity, &unit.ast).expect("common plan binding before transformations");
+        println!("COMMON_PLAN_EMIT {}", source.display());
+        let output = get_output_path(tcfg, &source, ancestor, build);
+        if output.exists() { panic!("common plan refuses colliding output paths"); }
+        let result = emit_prepared_unit(tcfg, &source, output, unit.ast, unit.preprocessed, Some(bound));
+        if result.is_err() { panic!("common plan conversion failed"); }
+        result
+    }
+}
