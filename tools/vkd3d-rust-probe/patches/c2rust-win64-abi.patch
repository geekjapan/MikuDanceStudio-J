+    #[test]
+    fn closed_variadic_plan_native_optional_output_binding_is_explicit() {
+        let directory=tempfile::tempdir().unwrap();
+        let (source,database,base)=native_fixture(directory.path(),"int legal(void){return 1;}");
+        let c=config(directory.path().join("unused"));
+        let mut keys=Vec::new();
+        for output in [None,Some(serde_json::Value::Null),Some(serde_json::json!("")),Some(serde_json::json!("native.o"))] {
+            let mut row=base.clone();
+            if let Some(output)=output { row["output"]=output; }
+            let (key,_,_,effective)=command_identity(&row,&[],"output-test").unwrap();
+            keys.push(key);
+            let expected=effective["output"].as_str().unwrap_or("");
+            fs::write(&database,serde_json::to_vec(&vec![native_database_row(&effective)]).unwrap()).unwrap();
+            let (ast,_,_)=prepare_single(&c,&source,&database,&[],None).unwrap();
+            let raw=ast.cursor_inputs.as_ref().unwrap();
+            let mut metadata: serde_json::Value=serde_json::from_str(raw).unwrap();
+            assert_eq!(metadata["prepared_invocation"]["command"]["output"].as_str(),Some(expected));
+            assert!(crate::native_intake::capture(raw,&ast,&source,&effective,&[]).is_ok());
+            metadata["prepared_invocation"]["command"]["output"]=serde_json::json!("different.o");
+            assert!(crate::native_intake::capture(&metadata.to_string(),&ast,&source,&effective,&[]).is_err());
+        }
+        assert_eq!(keys[0],keys[1]);
+        assert_ne!(keys[0],keys[2]);
+        assert_ne!(keys[0],keys[3]);
+        assert_ne!(keys[2],keys[3]);
+    }
