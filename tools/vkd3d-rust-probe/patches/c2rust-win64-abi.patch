--- /dev/null
+++ b/c2rust-transpile/src/native_intake.rs
@@ -0,0 +1,186 @@
+use crate::*;
+use serde_derive::Deserialize;
+use std::collections::{BTreeMap, BTreeSet};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeInputs {
+    schema: u32,
+    main_input: PathBuf,
+    cwd: PathBuf,
+    adjusted_driver_argv: Vec<String>,
+    regenerated_cc1_argv: Vec<String>,
+    target: String,
+    cpu: String,
+    abi: String,
+    features: Vec<String>,
+    features_as_written: Vec<String>,
+    vfs: String,
+    unsupported: Vec<String>,
+    buffers: Vec<Buffer>,
+    lexer_events: Vec<LexerEvent>,
+    prepared_invocation: PreparedInvocation,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PreparedInvocation {
+    schema: u32,
+    command: NativeCommand,
+    requested_extra_args: Vec<String>,
+    selected_driver_argv: Vec<String>,
+    expected_adjusted_driver_argv: Vec<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NativeCommand {
+    directory: PathBuf,
+    file: PathBuf,
+    arguments: Vec<String>,
+    output: String,
+}
+
+#[derive(Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+enum Role { Main, File, Predefines, Scratch }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Buffer {
+    role: Role,
+    identifier: String,
+    physical_path: PathBuf,
+    aliases: Vec<String>,
+    native_device: String,
+    native_file: String,
+    length: u64,
+    bytes_hex: String,
+    sha256: String,
+    lexed: bool,
+    lexer_file_ids: Vec<String>,
+}
+
+#[derive(Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+enum Reason { Enter, Exit }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct LexerEvent { file_id: String, reason: Reason, characteristic: u32 }
+
+fn require(condition: bool, message: &str) -> Result<(), Error> {
+    if condition { Ok(()) } else { Err(format_err!("common plan native intake: {message}")) }
+}
+
+fn canonical(path: &Path) -> Result<PathBuf, Error> {
+    require(path.is_absolute(), "nonabsolute native path")?;
+    let resolved = path.canonicalize()?;
+    require(resolved == path, "unresolved native path")?;
+    Ok(resolved)
+}
+
+fn decimal(value: &str) -> bool {
+    !value.is_empty() && value.bytes().all(|b| b.is_ascii_digit()) && value.parse::<u64>().is_ok()
+}
+
+fn decode(buffer: &Buffer) -> Result<Vec<u8>, Error> {
+    require(buffer.bytes_hex.len() % 2 == 0 && buffer.bytes_hex.bytes().all(|b|
+        b.is_ascii_digit() || (b'a'..=b'f').contains(&b)), "invalid native buffer hex")?;
+    let bytes = (0..buffer.bytes_hex.len()).step_by(2).map(|i|
+        u8::from_str_radix(&buffer.bytes_hex[i..i+2], 16)).collect::<Result<Vec<_>, _>>()?;
+    require(buffer.length == bytes.len() as u64 && buffer.sha256 == c2rust_ast_exporter::sha256(&bytes),
+        "native buffer bytes differ")?;
+    Ok(bytes)
+}
+
+pub(crate) fn capture(raw: &str, ast: &TypedAstContext, source: &Path, effective: &serde_json::Value,
+    extra: &[&str]) -> Result<BTreeMap<PathBuf, Vec<u8>>, Error> {
+    let inputs: NativeInputs = serde_json::from_str(raw)?;
+    require(inputs.schema == 3 && inputs.prepared_invocation.schema == 1, "unsupported prepared schema")?;
+    require(inputs.unsupported.is_empty(), "unsupported native input mode or diagnostic failure")?;
+    require(inputs.vfs == "clangtool_empty_overlay_on_real_filesystem", "unresolved native filesystem")?;
+    require(canonical(&inputs.main_input)? == source && inputs.target == ast.target,
+        "native source or target binding differs")?;
+    let invocation = &inputs.prepared_invocation;
+    let directory = Path::new(effective["directory"].as_str().ok_or_else(|| format_err!("missing effective directory"))?);
+    let expected_output: Option<String> = serde_json::from_value(effective["output"].clone())?;
+    require(canonical(&inputs.cwd)? == directory && invocation.command.directory == directory
+        && invocation.command.file == source && effective["arguments"] == serde_json::json!(invocation.command.arguments)
+        && expected_output.as_deref().unwrap_or("") == invocation.command.output
+        && invocation.requested_extra_args.iter().map(String::as_str).eq(extra.iter().copied()),
+        "native effective command binding differs")?;
+    let selected = &invocation.selected_driver_argv;
+    let mut prefix = invocation.command.arguments.clone();
+    prefix.extend(extra.iter().map(|a| a.to_string()));
+    require(!prefix.is_empty() && selected.starts_with(&prefix) && selected.len() > prefix.len(),
+        "native selected invocation differs")?;
+    require(!inputs.adjusted_driver_argv.is_empty()
+        && inputs.adjusted_driver_argv == invocation.expected_adjusted_driver_argv
+        && inputs.adjusted_driver_argv.iter().any(|a| a == "-fsyntax-only")
+        && inputs.adjusted_driver_argv.iter().any(|a| a == "-resource-dir" || a.starts_with("-resource-dir=")),
+        "native adjusted invocation differs")?;
+    let triples = inputs.regenerated_cc1_argv.windows(2).filter(|a| a[0] == "-triple").collect::<Vec<_>>();
+    require(triples.len() == 1 && triples[0][1] == inputs.target
+        && inputs.regenerated_cc1_argv.iter().any(|a| a == source.to_string_lossy().as_ref()),
+        "native cc1 target or main input differs")?;
+    for (flag, value) in [("-target-cpu", &inputs.cpu), ("-target-abi", &inputs.abi)] {
+        let values=inputs.regenerated_cc1_argv.windows(2).filter(|pair|pair[0]==flag)
+            .map(|pair|&pair[1]).collect::<Vec<_>>();
+        require(if value.is_empty() { values.is_empty() } else { values == vec![value] },
+            "native cc1 target options differ")?;
+    }
+    let cc1_features=inputs.regenerated_cc1_argv.windows(2).filter(|pair|pair[0]=="-target-feature")
+        .map(|pair|pair[1].clone()).collect::<Vec<_>>();
+    require(cc1_features == inputs.features, "native cc1 target features differ")?;
+    let _written_features = inputs.features_as_written;
+    let mut entered = BTreeSet::new();
+    require(!inputs.lexer_events.is_empty(), "missing native lexer coverage")?;
+    for event in &inputs.lexer_events {
+        require(decimal(&event.file_id) && event.characteristic < 5, "invalid native lexer event")?;
+        if event.reason == Reason::Enter { entered.insert(event.file_id.clone()); }
+    }
+    let mut covered = BTreeSet::new();
+    let mut identities = BTreeSet::new();
+    let mut sources = BTreeMap::new();
+    let (mut main, mut predefines) = (0, 0);
+    for buffer in &inputs.buffers {
+        let bytes = decode(buffer)?;
+        require(decimal(&buffer.native_device) && decimal(&buffer.native_file), "invalid native file identity")?;
+        require(buffer.lexed || buffer.role == Role::Scratch, "native buffer lacks lexer coverage")?;
+        require(buffer.lexed == !buffer.lexer_file_ids.is_empty(), "native buffer lexer state differs")?;
+        for id in &buffer.lexer_file_ids {
+            require(entered.contains(id) && covered.insert(id.clone()), "native lexer/cache coverage differs")?;
+        }
+        let aliases = buffer.aliases.iter().collect::<BTreeSet<_>>();
+        require(aliases.len() == buffer.aliases.len() && !aliases.iter().any(|a| a.is_empty()), "invalid native path aliases")?;
+        if buffer.role == Role::Main || buffer.role == Role::File {
+            let path = canonical(&buffer.physical_path)?;
+            require(fs::read(&path)? == bytes, "native physical source snapshot differs")?;
+            for alias in aliases {
+                let alias = inputs.cwd.join(alias);
+                require(alias.canonicalize()? == path && fs::read(alias)? == bytes, "native physical alias differs")?;
+            }
+            require(identities.insert(("file".to_string(), path.to_string_lossy().into_owned(), String::new())),
+                "duplicate physical native buffer")?;
+            if buffer.role == Role::Main {
+                main += 1;
+                require(path == source, "native main buffer differs")?;
+            }
+            sources.insert(path, bytes);
+        } else {
+            require(buffer.physical_path.as_os_str().is_empty() && buffer.aliases.is_empty()
+                && buffer.native_device == "0" && buffer.native_file == "0", "builtin buffer has physical identity")?;
+            if buffer.role == Role::Predefines { predefines += 1; }
+            else { require(buffer.identifier == "<scratch space>", "unknown native scratch buffer")?; }
+            require(identities.insert((if buffer.role == Role::Predefines { "predefines" } else { "scratch" }.into(),
+                buffer.identifier.clone(), buffer.sha256.clone())), "duplicate builtin native buffer")?;
+        }
+    }
+    require(entered == covered && main == 1 && predefines == 1, "incomplete native source/lexer coverage")?;
+    for path in ast.original_source_paths() {
+        if path == Path::new("vararg") { continue; }
+        require(sources.contains_key(&canonical(path)?), "AST source is missing from native buffers")?;
+    }
+    Ok(sources)
+}
