+typedef unsigned short row[3];
+struct matrix { char head; row mod[4]; };
+struct packed { char head; int mod[4]; } __attribute__((packed));
+struct aligned { char head; int mod[4]; } __attribute__((aligned(32)));
+struct flexible { unsigned long long head[2]; int mod[]; };
+struct element { unsigned long long wide; char tail; };
+struct elements { char head; struct element mod[4]; };
+typedef struct flexible alias;
+typedef struct aligned aligned_alias;
+static unsigned int counter;
+static unsigned int next_index(void) { return counter++; }
