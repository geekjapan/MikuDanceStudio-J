+    #[test]
+    fn closed_variadic_plan_native_metadata_controls_reach_typed_intake() {
+        let directory=tempfile::tempdir().unwrap();
+        fs::write(directory.path().join("header.h"),"struct Header { int field; };\n").unwrap();
+        let (source,database,effective)=native_fixture(directory.path(),
+            "#include \"header.h\"\nint legal(struct Header *p){return p->field;}\n");
+        let c=config(directory.path().join("unused"));
+        let (ast,_,_)=prepare_single(&c,&source,&database,&[],None).unwrap();
+        let raw=ast.cursor_inputs.as_ref().unwrap();
+        let baseline: serde_json::Value=serde_json::from_str(raw).unwrap();
+        assert!(crate::native_intake::capture(raw,&ast,&source,&effective,&[]).is_ok());
+        let refuse=|changed: serde_json::Value| {
+            assert!(crate::native_intake::capture(&changed.to_string(),&ast,&source,&effective,&[]).is_err());
+        };
+        for unsupported in ["diagnostic_error","external_ast_or_preprocessor","pch_or_preamble","modules",
+            "vfs_overlay_or_remap","partial_preprocessing","multiple_inputs","unsupported_input_kind",
+            "loaded_buffer_without_lexer_callback","lexed_buffer_not_loaded","invalid_or_overridden_buffer"] {
+            let mut changed=baseline.clone(); changed["unsupported"]=serde_json::json!([unsupported]); refuse(changed);
+        }
+        for field in ["schema","coverage","lexer","builtin","vfs","command","extra","adjusted","target","cc1"] {
+            let mut changed=baseline.clone();
+            match field {
+                "schema"=>changed["schema"]=serde_json::json!(2),
+                "coverage"=>{
+                    let buffers=changed["buffers"].as_array_mut().unwrap();
+                    let removed=buffers.iter().position(|b|b["physical_path"].as_str().is_some_and(|p|p.ends_with("/header.h"))).unwrap();
+                    let ids=buffers.remove(removed)["lexer_file_ids"].as_array().unwrap().clone();
+                    changed["lexer_events"].as_array_mut().unwrap().retain(|event|!ids.contains(&event["file_id"]));
+                },
+                "lexer"=>{changed["lexer_events"].as_array_mut().unwrap().push(serde_json::json!({"file_id":"999999","reason":"enter","characteristic":0}));},
+                "builtin"=>{
+                    let b=changed["buffers"].as_array_mut().unwrap().iter_mut().find(|b|b["role"]=="predefines").unwrap();
+                    let data=fs::read(&source).unwrap();
+                    b["physical_path"]=serde_json::json!(source);
+                    b["bytes_hex"]=serde_json::json!(data.iter().map(|b|format!("{b:02x}")).collect::<String>());
+                    b["length"]=serde_json::json!(data.len()); b["sha256"]=serde_json::json!(c2rust_ast_exporter::sha256(&data));
+                },
+                "vfs"=>changed["vfs"]=serde_json::json!("unresolved_overlay"),
+                "command"=>changed["prepared_invocation"]["command"]["arguments"][0]=serde_json::json!("other-clang"),
+                "extra"=>changed["prepared_invocation"]["requested_extra_args"]=serde_json::json!(["-DUNBOUND=1"]),
+                "adjusted"=>changed["adjusted_driver_argv"].as_array_mut().unwrap().push(serde_json::json!("-DUNBOUND=1")),
+                "target"=>changed["target"]=serde_json::json!("unbound-target"),
+                _=>{
+                    let argv=changed["regenerated_cc1_argv"].as_array_mut().unwrap();
+                    let index=argv.iter().position(|a|a=="-triple").unwrap()+1;
+                    argv[index]=serde_json::json!("unbound-target");
+                },
+            }
+            refuse(changed);
+        }
+    }
