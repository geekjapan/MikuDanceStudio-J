+size_t offset_case(unsigned int which, long long idx) {
+    counter = 3;
+    switch (which) {
+        case 0: return offsetof(struct matrix, mod[idx]);
+        case 1: return offsetof(struct packed, mod[idx]);
+        case 2: return offsetof(struct aligned, mod[idx]);
+        case 3: return offsetof(struct flexible, mod[idx]);
+        case 4: return offsetof(alias, mod[(unsigned int)idx]);
+        case 5: return offsetof(alias, mod[(size_t)idx]);
+        case 6: return offsetof(struct elements, mod[idx]);
+        case 7: { size_t result = offsetof(alias, mod[counter++]); return result + counter; }
+        case 8: { size_t result = offsetof(alias, mod[next_index()]); return result + counter; }
